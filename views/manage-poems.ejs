<%- include('partials/header') %>
<%- include('partials/navbar') %>
<%- include('partials/flash') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 flex-grow">

  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8 border-b border-brand-brown/10 dark:border-brand-brown/25 pb-6">
    <div>
      <a href="/admin" class="text-xs font-semibold text-brand-brown dark:text-brand-pink hover:underline flex items-center gap-1 mb-2">&larr; Back to Admin Center</a>
      <h1 class="font-serif text-3xl font-bold text-gray-800 dark:text-brand-pink flex items-center gap-2">
        <i data-lucide="feather" class="w-7 h-7 text-brand-brown dark:text-brand-pink"></i>
        Manage All Poems
      </h1>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Review, moderate, and permanently delete any poem. <span class="font-semibold text-red-500">Only you (admin) can delete content.</span></p>
    </div>
    <div class="text-right">
      <span class="block text-3xl font-bold text-brand-brown dark:text-brand-pink font-mono"><%= poems.length %></span>
      <span class="text-xs text-gray-400 uppercase tracking-wider">poems shown</span>
    </div>
  </div>

  <!-- Filter Tabs -->
  <div class="flex flex-wrap gap-2 mb-6">
    <a href="/admin/poems?status=all" class="px-4 py-2 rounded-full text-xs font-bold border transition-all <%= filter === 'all' ? 'bg-brand-brown text-white border-brand-brown shadow-sm' : 'border-brand-brown/20 text-gray-600 dark:text-gray-300 hover:bg-brand-cream/30 dark:hover:bg-brand-brown/10' %>">All Poems</a>
    <a href="/admin/poems?status=pending" class="px-4 py-2 rounded-full text-xs font-bold border transition-all <%= filter === 'pending' ? 'bg-amber-500 text-white border-amber-500 shadow-sm' : 'border-amber-400/30 text-amber-600 dark:text-amber-400 hover:bg-amber-50 dark:hover:bg-amber-950/20' %>">Pending</a>
    <a href="/admin/poems?status=approved" class="px-4 py-2 rounded-full text-xs font-bold border transition-all <%= filter === 'approved' ? 'bg-green-600 text-white border-green-600 shadow-sm' : 'border-green-400/30 text-green-600 dark:text-green-400 hover:bg-green-50 dark:hover:bg-green-950/20' %>">Approved</a>
    <a href="/admin/poems?status=rejected" class="px-4 py-2 rounded-full text-xs font-bold border transition-all <%= filter === 'rejected' ? 'bg-red-600 text-white border-red-600 shadow-sm' : 'border-red-400/30 text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/20' %>">Rejected</a>
  </div>

  <!-- Poems Table -->
  <div class="bg-white dark:bg-[#1E150F] rounded-2xl shadow-sm border border-brand-brown/10 dark:border-brand-brown/20 overflow-hidden">
    <% if (poems.length > 0) { %>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse normal-table">
          <thead>
            <tr class="border-b border-brand-brown/10 dark:border-brand-brown/15 bg-brand-cream/10 dark:bg-brand-brown/5 text-xs text-gray-400 font-bold uppercase">
              <th class="py-3.5 px-5">Poem Title</th>
              <th class="py-3.5 px-5">Author</th>
              <th class="py-3.5 px-5">Category</th>
              <th class="py-3.5 px-5">Status</th>
              <th class="py-3.5 px-5">Submitted</th>
              <th class="py-3.5 px-5 text-right">Admin Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 dark:divide-brand-brown/5 text-sm text-gray-700 dark:text-gray-300">
            <% poems.forEach(function(poem) { %>
              <tr class="hover:bg-brand-cream/5 dark:hover:bg-brand-brown/5 transition-colors">
                <td class="py-4 px-5 max-w-xs">
                  <a href="/poems/<%= poem._id %>" target="_blank" class="font-bold text-gray-800 dark:text-white hover:text-brand-brown dark:hover:text-brand-pink transition-colors leading-snug">
                    <%= poem.title %>
                  </a>
                  <p class="text-xs text-gray-400 mt-0.5 italic"><%= (poem.content || '').substring(0, 70) %>...</p>
                </td>
                <td class="py-4 px-5">
                  <span class="font-semibold text-brand-brown dark:text-brand-pink"><%= poem.authorName || 'Unknown' %></span>
                </td>
                <td class="py-4 px-5">
                  <span class="px-2.5 py-1 rounded-md text-xs font-semibold bg-brand-pink/20 text-brand-brown dark:text-brand-pink border border-brand-pink/10"><%= poem.category || poem.genre || 'Uncategorized' %></span>
                </td>
                <td class="py-4 px-5">
                  <% if (poem.approvalStatus === 'approved') { %>
                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-green-50 dark:bg-green-950/20 text-green-700 dark:text-green-300 border border-green-200 dark:border-green-800">Approved</span>
                  <% } else if (poem.approvalStatus === 'pending') { %>
                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-amber-50 dark:bg-amber-950/20 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-800">Pending</span>
                  <% } else { %>
                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-red-50 dark:bg-red-950/20 text-red-700 dark:text-red-300 border border-red-200 dark:border-red-800">Rejected</span>
                  <% } %>
                </td>
                <td class="py-4 px-5 text-xs text-gray-400 whitespace-nowrap">
                  <%= new Date(poem.createdAt).toLocaleDateString('en-KE', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                </td>
                <td class="py-4 px-5 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <a href="/poems/<%= poem._id %>" target="_blank" class="p-2 bg-gray-50 hover:bg-gray-100 dark:bg-brand-brown/10 dark:hover:bg-brand-brown/20 text-gray-500 dark:text-gray-300 rounded-lg transition-colors" title="View poem">
                      <i data-lucide="eye" class="w-4 h-4"></i>
                    </a>
                    <form action="/admin/poems/delete/<%= poem._id %>" method="POST" class="inline" onsubmit="return confirm('ADMIN DELETE\n\nPermanently delete the poem: ' + '<%= poem.title.replace(/\x27/g, '') %>' + '\nby <%= (poem.authorName || 'Unknown').replace(/\x27/g, '') %>?\n\nThis cannot be undone.');">
                      <button type="submit" class="px-3 py-2 bg-red-50 hover:bg-red-100 dark:bg-red-950/20 dark:hover:bg-red-900/30 text-red-600 dark:text-red-400 rounded-lg transition-colors font-semibold flex items-center gap-1 text-xs" title="Admin: Delete permanently">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                        <span class="hidden sm:inline">Delete</span>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="text-center py-20 text-gray-400">
        <i data-lucide="feather" class="w-16 h-16 text-gray-300 dark:text-gray-700 mx-auto mb-4"></i>
        <p class="text-lg font-semibold">No poems found</p>
        <p class="text-sm mt-1">
          <% if (filter !== 'all') { %>No <strong><%= filter %></strong> poems. <a href="/admin/poems" class="text-brand-brown dark:text-brand-pink underline">View all</a><% } else { %>No poems have been submitted yet.<% } %>
        </p>
      </div>
    <% } %>
  </div>

  <!-- Admin Warning Note -->
  <div class="mt-6 p-4 bg-red-50 dark:bg-red-950/20 border border-red-200 dark:border-red-800 rounded-xl flex items-start gap-3">
    <i data-lucide="shield-alert" class="w-5 h-5 text-red-500 shrink-0 mt-0.5"></i>
    <div class="text-sm">
      <p class="font-bold text-red-700 dark:text-red-400">Admin-Only Zone</p>
      <p class="text-red-600 dark:text-red-300 mt-0.5">Only administrators can delete content from this panel. Deletions are permanent and immediate. Authors cannot recover deleted content.</p>
    </div>
  </div>

</div>

<%- include('partials/footer') %>
