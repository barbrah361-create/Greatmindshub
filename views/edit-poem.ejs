<%- include('partials/header') %>
<%- include('partials/navbar') %>
<%- include('partials/flash') %>

<!-- Quill Editor CSS -->
<link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet" />

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 flex-grow">
  <!-- Header -->
  <div class="text-center mb-10">
    <span class="text-brand-brown dark:text-brand-pink text-xs font-bold uppercase tracking-widest">Revise Your Masterpiece</span>
    <h1 class="font-serif text-4xl font-bold mt-2 text-gray-800 dark:text-white">Edit Poem</h1>
    <p class="text-gray-500 dark:text-gray-400 max-w-xl mx-auto mt-2 text-sm">
      Update your stanzas, refine formatting, or customize the background artwork and audio track.
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    
    <!-- LEFT PANEL: Form Controls (Col span 7) -->
    <div class="lg:col-span-7">
      <div class="book-card p-6 sm:p-8 border border-brand-brown/10 dark:border-brand-brown/20 bg-white dark:bg-[#1E150F] shadow-lg rounded-2xl relative overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-1.5 bg-brand-brown"></div>

        <form id="editPoemForm" action="/poems/<%= poem._id %>/edit" method="POST" enctype="multipart/form-data" class="space-y-6">
          <input type="hidden" name="content" id="poem-content-hidden">

          <!-- Title -->
          <div>
            <label for="poem-title" class="block text-xs uppercase tracking-wider font-bold text-gray-400 mb-2">Poem Title</label>
            <input type="text" id="poem-title" name="title" required value="<%= poem.title %>" placeholder="e.g. Echoes of the Morning Wind" class="w-full rounded-xl border border-brand-brown/20 dark:border-brand-brown/30 bg-brand-cream/10 dark:bg-brand-dark/20 px-4 py-3 text-sm focus:ring-2 focus:ring-brand-brown focus:outline-none dark:text-white leading-relaxed">
          </div>

          <!-- Genre (Category) & Tags -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="poem-genre" class="block text-xs uppercase tracking-wider font-bold text-gray-400 mb-2">Poetry Category</label>
              <select id="poem-genre" name="genre" class="w-full rounded-xl border border-brand-brown/20 dark:border-brand-brown/30 bg-white dark:bg-brand-dark/20 px-4 py-3 text-sm focus:ring-2 focus:ring-brand-brown focus:outline-none dark:text-white">
                <% categories.forEach(function(cat) { %>
                  <option value="<%= cat %>" <%= poem.category === cat || poem.genre === cat ? 'selected' : '' %>><%= cat %></option>
                <% }) %>
              </select>
            </div>
            <div>
              <label for="poem-tags" class="block text-xs uppercase tracking-wider font-bold text-gray-400 mb-2">Tags (Comma-separated)</label>
              <input type="text" id="poem-tags" name="tags" value="<%= (poem.tags || []).join(', ') %>" placeholder="e.g. love, nature, memories" class="w-full rounded-xl border border-brand-brown/20 dark:border-brand-brown/30 bg-brand-cream/10 dark:bg-brand-dark/20 px-4 py-3 text-sm focus:ring-2 focus:ring-brand-brown focus:outline-none dark:text-white leading-relaxed">
            </div>
          </div>

          <!-- Editor Toggle Button -->
          <div class="flex items-center justify-between border-t border-brand-brown/10 pt-4">
            <span class="text-xs font-bold uppercase tracking-wider text-gray-400">Writing Desk</span>
            <button type="button" id="toggleEditorBtn" class="text-xs text-brand-brown dark:text-brand-pink hover:underline font-semibold flex items-center gap-1">
              <i data-lucide="repeat-2" class="w-3.5 h-3.5"></i> Toggle Plain/Rich Editor
            </button>
          </div>

          <!-- Content editors -->
          <div>
            <!-- Rich Text Editor Container -->
            <div id="rich-editor-wrapper">
              <div id="toolbar-container" class="rounded-t-xl border border-brand-brown/20 bg-brand-pink/5">
                <span class="ql-formats">
                  <select class="ql-font"></select>
                  <select class="ql-size"></select>
                </span>
                <span class="ql-formats">
                  <button class="ql-bold"></button>
                  <button class="ql-italic"></button>
                  <button class="ql-underline"></button>
                  <button class="ql-strike"></button>
                </span>
                <span class="ql-formats">
                  <select class="ql-color"></select>
                  <select class="ql-background"></select>
                </span>
                <span class="ql-formats">
                  <button class="ql-indent" value="-1"></button>
                  <button class="ql-indent" value="+1"></button>
                </span>
                <span class="ql-formats">
                  <select class="ql-align"></select>
                </span>
                <span class="ql-formats">
                  <button class="ql-clean"></button>
                </span>
              </div>
              <div id="editor" class="min-h-[280px] rounded-b-xl border-x border-b border-brand-brown/20 bg-brand-cream/5 font-serif text-lg p-4 italic">
                <%- poem.content %>
              </div>
            </div>

            <!-- Plain Textarea (hidden by default) -->
            <textarea id="poem-content-plain" rows="12" placeholder="Compose your stanzas here..." class="hidden w-full font-serif text-base sm:text-lg rounded-xl border border-brand-brown/20 dark:border-brand-brown/30 bg-brand-cream/10 dark:bg-brand-dark/20 p-5 focus:ring-2 focus:ring-brand-brown dark:focus:ring-brand-pink focus:outline-none dark:text-white leading-loose italic"><%= poem.content.replace(/<br\s*\/?>/gi, '\n').replace(/<[^>]+>/g, '') %></textarea>
          </div>

          <!-- Background Tune / Music -->
          <div class="p-4 bg-brand-cream/10 dark:bg-brand-brown/5 rounded-2xl border border-brand-brown/10 space-y-4">
            <h3 class="font-serif font-bold text-gray-800 dark:text-white text-sm flex items-center gap-2">
              <i data-lucide="music" class="w-4 h-4 text-brand-brown dark:text-brand-pink"></i>
              Background Music Track
            </h3>
            
            <% if (poem.backgroundAudio) { %>
              <div class="flex items-center justify-between p-3 bg-brand-brown/5 rounded-xl border border-brand-brown/10 mb-2">
                <div class="flex items-center gap-2 text-xs text-gray-600 dark:text-gray-300">
                  <i data-lucide="headphones" class="w-4 h-4 text-brand-pink"></i>
                  <span>Track attached</span>
                </div>
                <label class="flex items-center gap-1.5 text-xs text-red-500 font-semibold cursor-pointer">
                  <input type="checkbox" name="removeBackgroundAudio" value="true" class="rounded accent-red-500">
                  Remove audio
                </label>
              </div>
            <% } %>

            <div>
              <input type="file" id="backgroundAudio" name="backgroundAudio" accept="audio/*" class="block w-full text-xs text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-brand-brown file:text-white hover:file:bg-brand-accent">
              <p class="text-[10px] text-gray-400 mt-1">Allowed formats: mp3, wav, m4a, ogg, aac. Limit 10MB. Uploading a new file replaces the existing one.</p>
            </div>
          </div>

          <!-- Artwork / Background Image options -->
          <div class="p-4 bg-brand-cream/10 dark:bg-brand-brown/5 rounded-2xl border border-brand-brown/10 space-y-4">
            <h3 class="font-serif font-bold text-gray-800 dark:text-white text-sm flex items-center gap-2">
              <i data-lucide="image" class="w-4 h-4 text-brand-brown dark:text-brand-pink"></i>
              Custom Background Image
            </h3>

            <% if (poem.backgroundImage) { %>
              <div class="flex items-center justify-between p-3 bg-brand-brown/5 rounded-xl border border-brand-brown/10 mb-2">
                <div class="flex items-center gap-2 text-xs text-gray-600 dark:text-gray-300">
                  <img src="<%= poem.backgroundImage %>" alt="Cover" class="w-8 h-8 rounded object-cover">
                  <span>Background artwork active</span>
                </div>
                <label class="flex items-center gap-1.5 text-xs text-red-500 font-semibold cursor-pointer">
                  <input type="checkbox" name="removeBackgroundImage" value="true" class="rounded accent-red-500">
                  Remove image
                </label>
              </div>
            <% } %>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-[10px] uppercase font-bold text-gray-400 mb-1">Upload New Artwork</label>
                <input type="file" id="backgroundImage" name="backgroundImage" accept="image/*" class="block w-full text-xs text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-brand-brown file:text-white hover:file:bg-brand-accent">
              </div>
              <div>
                <label for="backgroundPosition" class="block text-[10px] uppercase font-bold text-gray-400 mb-1">Image Alignment</label>
                <select id="backgroundPosition" name="backgroundPosition" class="w-full rounded-lg border border-brand-brown/20 bg-white dark:bg-brand-dark/20 px-3 py-2 text-xs dark:text-white">
                  <option value="center" <%= poem.backgroundPosition === 'center' ? 'selected' : '' %>>Center</option>
                  <option value="top" <%= poem.backgroundPosition === 'top' ? 'selected' : '' %>>Top</option>
                  <option value="bottom" <%= poem.backgroundPosition === 'bottom' ? 'selected' : '' %>>Bottom</option>
                </select>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="backgroundSize" class="block text-[10px] uppercase font-bold text-gray-400 mb-1">Image Size</label>
                <select id="backgroundSize" name="backgroundSize" class="w-full rounded-lg border border-brand-brown/20 bg-white dark:bg-brand-dark/20 px-3 py-2 text-xs dark:text-white">
                  <option value="cover" <%= poem.backgroundSize === 'cover' ? 'selected' : '' %>>Scale & Crop (Cover)</option>
                  <option value="contain" <%= poem.backgroundSize === 'contain' ? 'selected' : '' %>>Fit Completely (Contain)</option>
                  <option value="auto" <%= poem.backgroundSize === 'auto' ? 'selected' : '' %>>Original Size</option>
                </select>
              </div>
              <div>
                <label for="backgroundOverlay" class="block text-[10px] uppercase font-bold text-gray-400 mb-1">Overlay Opacity (Readability)</label>
                <div class="flex items-center gap-2">
                  <input type="range" id="backgroundOverlay" name="backgroundOverlay" min="0" max="0.9" step="0.05" value="<%= poem.backgroundOverlay !== undefined ? poem.backgroundOverlay : 0.4 %>" class="w-full accent-brand-brown">
                  <span id="overlayVal" class="text-xs font-mono font-bold dark:text-white"><%= Math.round((poem.backgroundOverlay !== undefined ? poem.backgroundOverlay : 0.4) * 100) %>%</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-4 border-t border-brand-brown/10">
            <a href="/poems/<%= poem._id %>" class="w-full sm:w-auto text-center px-6 py-3 border border-brand-brown/15 text-gray-700 dark:text-gray-300 font-semibold rounded-xl text-xs hover:bg-brand-cream/20 transition-colors">
              Cancel
            </a>
            <button id="savePoemBtn" type="submit" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3 bg-brand-brown hover:bg-brand-accent text-white font-bold rounded-xl text-xs shadow transition-all duration-200">
              <i data-lucide="save" class="w-4 h-4"></i>
              Save Changes
            </button>
          </div>
        </form>
      </div>

      <!-- Danger Zone -->
      <div class="mt-6 p-6 border border-red-200 dark:border-red-900/30 bg-red-50/15 dark:bg-red-950/10 rounded-2xl space-y-3">
        <h3 class="font-serif font-bold text-red-600 dark:text-red-400 text-sm flex items-center gap-2">
          <i data-lucide="trash-2" class="w-4 h-4"></i>
          Danger Zone
        </h3>
        <p class="text-xs text-gray-500 dark:text-gray-400">
          Permanently delete this poem and remove it from Readers Africa. This action is irreversible.
        </p>
        <form action="/poems/<%= poem._id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to permanently delete this poem? This action cannot be undone.');">
          <button type="submit" class="w-full sm:w-auto px-5 py-2.5 bg-red-600 hover:bg-red-700 text-white font-semibold rounded-xl text-xs shadow-sm transition-colors">
            Delete Poem
          </button>
        </form>
      </div>
    </div>

    <!-- RIGHT PANEL: Live Presentation Preview (Col span 5) -->
    <div class="lg:col-span-5 sticky top-24">
      <div class="text-center mb-4">
        <span class="text-xs uppercase font-bold tracking-widest text-gray-400">Artwork Presentation Preview</span>
      </div>

      <div id="preview-container" class="w-full rounded-3xl border border-brand-brown/10 dark:border-brand-brown/20 bg-white dark:bg-[#1E150F] shadow-lg relative overflow-hidden aspect-[4/5] flex flex-col justify-center p-6 text-center select-none bg-cover bg-center" style="background-image: <% if (poem.backgroundImage) { %> url('<%= poem.backgroundImage %>') <% } else { %> none <% } %>; background-position: <%= poem.backgroundPosition || 'center' %>; background-size: <%= poem.backgroundSize || 'cover' %>;">
        <!-- Optional dimming overlay -->
        <div id="preview-overlay" class="absolute inset-0 bg-black/40 transition-colors duration-300" style="background-color: rgba(0, 0, 0, <%= poem.backgroundOverlay !== undefined ? poem.backgroundOverlay : 0.4 %>);"></div>

        <div class="relative z-10 space-y-6 text-white px-4">
          <span id="preview-category" class="text-[9px] uppercase tracking-[0.2em] font-bold px-2.5 py-1 bg-white/20 rounded-full border border-white/20 inline-block">
            <%= poem.category || poem.genre || 'Poetry' %>
          </span>
          <h2 id="preview-title" class="font-serif text-2xl sm:text-3xl font-extrabold leading-tight drop-shadow-md">
            <%= poem.title %>
          </h2>
          <p class="text-[10px] text-gray-300">
            By <span class="font-bold text-white"><%= poem.authorName %></span>
          </p>
          <div class="w-10 h-px bg-white/30 mx-auto"></div>
          
          <div id="preview-content" class="font-serif text-sm sm:text-base italic leading-relaxed whitespace-pre-wrap max-h-56 overflow-y-auto scrollbar-hide drop-shadow-md">
            <%- poem.content %>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- Quill Editor JS & Controller Setup -->
<script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const quill = new Quill('#editor', {
      theme: 'snow',
      modules: {
        toolbar: '#toolbar-container'
      }
    });

    const richWrapper = document.getElementById('rich-editor-wrapper');
    const plainTextarea = document.getElementById('poem-content-plain');
    const toggleBtn = document.getElementById('toggleEditorBtn');
    let useRich = true;

    toggleBtn.addEventListener('click', () => {
      useRich = !useRich;
      if (useRich) {
        richWrapper.classList.remove('hidden');
        plainTextarea.classList.add('hidden');
        quill.root.innerHTML = plainTextarea.value.replace(/\n/g, '<br>');
      } else {
        richWrapper.classList.add('hidden');
        plainTextarea.classList.remove('hidden');
        plainTextarea.value = quill.getText();
      }
      updatePreviewContent();
    });

    const inputTitle = document.getElementById('poem-title');
    const selectGenre = document.getElementById('poem-genre');
    const inputBgImg = document.getElementById('backgroundImage');
    const selectBgPos = document.getElementById('backgroundPosition');
    const selectBgSize = document.getElementById('backgroundSize');
    const sliderBgOverlay = document.getElementById('backgroundOverlay');
    
    const previewContainer = document.getElementById('preview-container');
    const previewOverlay = document.getElementById('preview-overlay');
    const previewTitle = document.getElementById('preview-title');
    const previewCategory = document.getElementById('preview-category');
    const previewContent = document.getElementById('preview-content');
    const overlayVal = document.getElementById('overlayVal');

    inputTitle.addEventListener('input', (e) => {
      previewTitle.textContent = e.target.value.trim() || 'Poem Title';
    });

    selectGenre.addEventListener('change', (e) => {
      previewCategory.textContent = e.target.value;
    });

    sliderBgOverlay.addEventListener('input', (e) => {
      const val = parseFloat(e.target.value);
      previewOverlay.style.backgroundColor = `rgba(0, 0, 0, ${val})`;
      overlayVal.textContent = Math.round(val * 100) + '%';
    });

    selectBgPos.addEventListener('change', (e) => {
      previewContainer.style.backgroundPosition = e.target.value;
    });

    selectBgSize.addEventListener('change', (e) => {
      previewContainer.style.backgroundSize = e.target.value;
    });

    inputBgImg.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (file) {
        const url = URL.createObjectURL(file);
        previewContainer.style.backgroundImage = `url('${url}')`;
      }
    });

    function updatePreviewContent() {
      if (useRich) {
        previewContent.innerHTML = quill.root.innerHTML;
      } else {
        previewContent.textContent = plainTextarea.value;
      }
    }

    quill.on('text-change', updatePreviewContent);
    plainTextarea.addEventListener('input', updatePreviewContent);

    const form = document.getElementById('editPoemForm');
    const saveBtn = document.getElementById('savePoemBtn');

    form.addEventListener('submit', (e) => {
      const hiddenContent = document.getElementById('poem-content-hidden');
      if (useRich) {
        hiddenContent.value = quill.root.innerHTML;
      } else {
        hiddenContent.value = plainTextarea.value;
      }

      saveBtn.disabled = true;
      saveBtn.innerHTML = '<i class="animate-spin rounded-full h-4 w-4 border-2 border-white border-t-transparent mr-2"></i>Saving...';
    });
  });
</script>

<%- include('partials/footer') %>
