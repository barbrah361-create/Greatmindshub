<%- include('partials/header') %>
<%- include('partials/navbar') %>
<%- include('partials/flash') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-grow">
  
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
    
    <!-- LEFT & CENTER: Live Video Stream & Teleprompter (Col span 8) -->
    <div class="lg:col-span-8 space-y-6">
      
      <!-- Video Container (TikTok Live Vertical/Horizontal Ratio) -->
      <div class="relative bg-black rounded-3xl overflow-hidden aspect-video shadow-2xl border-2 border-brand-brown/20 flex items-center justify-center group">
        <!-- Live Video Element (Mirrored like TikTok Selfie Cam) -->
        <video id="liveVideoFeed" class="w-full h-full object-cover transition-all duration-300 transform -scale-x-100" autoplay playsinline muted></video>

        <!-- Tap to Start Camera Overlay (If browser permission required) -->
        <div id="cameraStartOverlay" class="absolute inset-0 bg-black/80 backdrop-blur z-40 flex flex-col items-center justify-center p-6 text-center space-y-4">
          <div class="w-20 h-20 rounded-full bg-red-600/20 text-red-500 flex items-center justify-center animate-pulse ring-4 ring-red-500/30">
            <i data-lucide="video" class="w-10 h-10"></i>
          </div>
          <div>
            <h3 class="font-serif text-2xl font-bold text-white">Join Live Recitation Stage</h3>
            <p class="text-xs text-gray-300 max-w-sm mt-1">Tap below to enable your camera feed, audio stream, and real-time TikTok beauty filters.</p>
          </div>
          <button type="button" onclick="startLiveCamera()" class="px-6 py-3.5 bg-red-600 hover:bg-red-700 text-white font-bold rounded-2xl shadow-xl hover:shadow-red-500/30 transition-all text-xs flex items-center gap-2">
            <i data-lucide="camera" class="w-4 h-4"></i> Enable Camera & Broadcast Live
          </button>
        </div>

        <!-- Live Badge & Viewer Counter Overlay -->
        <div class="absolute top-4 left-4 flex flex-wrap items-center gap-2 z-20">
          <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs font-bold bg-red-600 text-white shadow-lg uppercase tracking-wider animate-pulse">
            <span class="w-2 h-2 rounded-full bg-white"></span> LIVE STAGE
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-black/60 backdrop-blur text-white border border-white/10">
            <i data-lucide="users" class="w-3.5 h-3.5 text-red-400"></i>
            <span id="roomViewerCount"><%= session.viewersCount || 124 %></span> Watching
          </span>
        </div>

        <!-- Filter Selector & Controls Overlay (Top Right) -->
        <div class="absolute top-4 right-4 z-20 flex items-center gap-2">
          <!-- Filter Select -->
          <div class="flex items-center gap-1.5 bg-black/60 backdrop-blur px-3 py-1.5 rounded-full border border-white/10 text-xs text-white">
            <i data-lucide="sparkles" class="w-3.5 h-3.5 text-amber-400"></i>
            <select id="liveFilterSelect" onchange="applyLiveFilter(this.value)" class="bg-transparent text-white font-bold text-xs outline-none cursor-pointer">
              <option value="glam" class="bg-gray-900 text-white" selected>🌟 Glam Glow</option>
              <option value="none" class="bg-gray-900 text-white">✨ Natural</option>
              <option value="golden" class="bg-gray-900 text-white">🌅 Golden Hour</option>
              <option value="vibrant" class="bg-gray-900 text-white">🎨 Vibrant</option>
              <option value="noir" class="bg-gray-900 text-white">🎬 Poetic Noir</option>
            </select>
          </div>

          <!-- Flip Mirror Toggle -->
          <button type="button" onclick="toggleMirror()" title="Toggle Camera Mirror" class="w-8 h-8 rounded-full bg-black/60 backdrop-blur border border-white/10 text-white flex items-center justify-center hover:bg-black transition-colors">
            <i data-lucide="flip-horizontal" class="w-4 h-4"></i>
          </button>
        </div>

        <!-- TikTok Live Host Banner & Floating Hearts Trigger -->
        <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between text-white z-20">
          <div class="flex items-center gap-3 bg-black/60 backdrop-blur px-4 py-2 rounded-2xl border border-white/10 shadow-lg">
            <img src="<%= session.hostAvatar || '/uploads/default-avatar.png' %>" alt="" class="w-10 h-10 rounded-full object-cover ring-2 ring-red-500">
            <div>
              <h3 class="font-bold text-sm leading-snug flex items-center gap-1.5">
                <%= session.hostName %>
                <span class="bg-red-600 text-[9px] px-1.5 py-0.2 rounded font-bold uppercase">HOST</span>
              </h3>
              <p class="text-[11px] text-gray-300">Reciting: <%= session.workTitle %></p>
            </div>
          </div>

          <!-- TikTok Style Big Floating Heart Button -->
          <button onclick="sendLiveHeart('<%= session._id %>')" class="w-14 h-14 rounded-full bg-gradient-to-tr from-red-600 to-pink-500 hover:scale-110 text-white flex items-center justify-center shadow-2xl transition-transform active:scale-125 border-2 border-white/20">
            <i data-lucide="heart" class="w-7 h-7 fill-white"></i>
          </button>
        </div>

        <!-- Floating hearts animation overlay container -->
        <div id="heartsContainer" class="absolute inset-0 pointer-events-none overflow-hidden z-30"></div>
        <!-- Gift Notification Banner Overlay -->
        <div id="giftNotificationBanner" class="absolute top-16 left-4 z-30 pointer-events-none space-y-2"></div>
      </div>

      <!-- TikTok Live Appreciation Gift Toolbar -->
      <div class="bg-white dark:bg-[#1E150F] p-4 rounded-2xl border border-brand-brown/10 dark:border-brand-brown/20 shadow-sm flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-2 text-xs font-bold text-gray-700 dark:text-white">
          <i data-lucide="gift" class="w-4.5 h-4.5 text-red-500"></i>
          Send Live TikTok Gift:
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <button onclick="sendGift('🌹 Rose')" class="px-3.5 py-1.5 rounded-full bg-red-50 dark:bg-red-950/30 text-red-600 dark:text-red-400 border border-red-200 dark:border-red-900/30 text-xs font-bold hover:scale-105 transition-transform flex items-center gap-1.5 shadow-sm">
            🌹 Rose
          </button>
          <button onclick="sendGift('📚 Golden Book')" class="px-3.5 py-1.5 rounded-full bg-amber-50 dark:bg-amber-950/30 text-amber-600 dark:text-amber-400 border border-amber-200 dark:border-amber-900/30 text-xs font-bold hover:scale-105 transition-transform flex items-center gap-1.5 shadow-sm">
            📚 Book
          </button>
          <button onclick="sendGift('💎 Diamond')" class="px-3.5 py-1.5 rounded-full bg-blue-50 dark:bg-blue-950/30 text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-900/30 text-xs font-bold hover:scale-105 transition-transform flex items-center gap-1.5 shadow-sm">
            💎 Diamond
          </button>
          <button onclick="sendGift('👑 Crown')" class="px-3.5 py-1.5 rounded-full bg-purple-50 dark:bg-purple-950/30 text-purple-600 dark:text-purple-400 border border-purple-200 dark:border-purple-900/30 text-xs font-bold hover:scale-105 transition-transform flex items-center gap-1.5 shadow-sm">
            👑 Crown
          </button>
        </div>
      </div>

      <!-- Live Read-Along Teleprompter Card -->
      <div class="bg-white dark:bg-[#1E150F] p-6 sm:p-8 rounded-3xl border border-brand-brown/10 dark:border-brand-brown/20 shadow-sm space-y-4">
        <div class="flex items-center justify-between border-b border-brand-brown/10 dark:border-brand-brown/15 pb-4">
          <div>
            <span class="text-[10px] font-bold uppercase tracking-wider text-brand-pink bg-brand-pink/20 px-2.5 py-0.5 rounded-full">Read Along</span>
            <h2 class="font-serif text-2xl font-bold text-gray-800 dark:text-white mt-1"><%= session.workTitle %></h2>
          </div>
          <% if (isHost) { %>
            <form action="/live/<%= session._id %>/end" method="POST" onsubmit="return confirm('End your live stream session?');">
              <button type="submit" class="px-4 py-2 bg-gray-900 hover:bg-black text-white font-bold rounded-xl text-xs shadow">
                End Broadcast
              </button>
            </form>
          <% } %>
        </div>

        <div class="prose prose-amber dark:prose-invert text-gray-700 dark:text-gray-200 text-base leading-relaxed max-h-72 overflow-y-auto pr-2 scrollbar-hide space-y-3 font-serif italic">
          <% if (session.workContent) { %>
            <% session.workContent.split('\n\n').forEach(function(p) { %>
              <p class="py-1"><%= p %></p>
            <% }) %>
          <% } else { %>
            <p class="text-gray-400 italic">No text provided. Listen live as <%= session.hostName %> recites!</p>
          <% } %>
        </div>
      </div>

    </div>

    <!-- RIGHT COLUMN: Real-Time Live Chat & Audience Feed (Col span 4) -->
    <div class="lg:col-span-4 bg-white dark:bg-[#1E150F] rounded-3xl border border-brand-brown/10 dark:border-brand-brown/20 shadow-sm flex flex-col h-[650px] overflow-hidden">
      
      <!-- Chat Header -->
      <div class="p-4 border-b border-brand-brown/10 dark:border-brand-brown/15 bg-brand-cream/20 dark:bg-brand-brown/10 flex items-center justify-between">
        <h3 class="font-bold text-sm text-gray-800 dark:text-white flex items-center gap-2">
          <i data-lucide="message-square" class="w-4 h-4 text-red-500"></i>
          TikTok Live Stream Chat
        </h3>
        <span class="text-[11px] font-bold text-red-500 flex items-center gap-1">
          <i data-lucide="heart" class="w-3.5 h-3.5 fill-red-500"></i>
          <span id="liveLikesCount"><%= session.likesCount %></span> Hearts
        </span>
      </div>

      <!-- Chat Stream Feed -->
      <div id="chatFeed" class="p-4 flex-grow overflow-y-auto space-y-3 text-xs">
        <div class="bg-brand-cream/40 dark:bg-brand-brown/10 p-3 rounded-2xl border border-brand-brown/5 text-gray-500 dark:text-gray-400 italic text-center">
          Welcome to <%= session.hostName %>'s live recitation stage! Keep comments encouraging and respectful.
        </div>
      </div>

      <!-- Chat Form Input -->
      <div class="p-4 border-t border-brand-brown/10 dark:border-brand-brown/15 bg-brand-cream/10">
        <form onsubmit="sendChatMessage(event)" class="flex gap-2">
          <input type="text" id="chatInput" placeholder="Send a live comment..." required class="flex-grow px-4 py-2.5 border border-brand-brown/20 dark:border-brand-brown/30 rounded-xl bg-white dark:bg-[#1C120C] text-xs text-gray-800 dark:text-white focus:outline-none focus:border-brand-brown">
          <button type="submit" class="px-4 py-2.5 bg-red-600 hover:bg-red-700 text-white font-bold rounded-xl text-xs shadow transition-colors">
            Send
          </button>
        </form>
      </div>

    </div>

  </div>

</div>

<style>
/* Beauty Face Filter Styles */
.filter-glam {
  filter: contrast(1.06) brightness(1.12) saturate(1.18) blur(0.2px) !important;
}
.filter-golden {
  filter: sepia(0.25) contrast(1.1) brightness(1.08) saturate(1.25) hue-rotate(-10deg) !important;
}
.filter-vibrant {
  filter: saturate(1.4) contrast(1.1) brightness(1.05) !important;
}
.filter-noir {
  filter: grayscale(1) contrast(1.25) brightness(1.05) !important;
}
</style>

<script>
let isMirrored = true;

function toggleMirror() {
  const video = document.getElementById('liveVideoFeed');
  isMirrored = !isMirrored;
  if (isMirrored) {
    video.classList.add('transform', '-scale-x-100');
  } else {
    video.classList.remove('transform', '-scale-x-100');
  }
}

// Apply live face filter to stream feed
function applyLiveFilter(filterName) {
  const video = document.getElementById('liveVideoFeed');
  video.className = 'w-full h-full object-cover transition-all duration-300 ' + (isMirrored ? 'transform -scale-x-100' : '');
  if (filterName !== 'none') {
    video.classList.add('filter-' + filterName);
  }
}

// Start Live Camera Stream
async function startLiveCamera() {
  try {
    const video = document.getElementById('liveVideoFeed');
    const overlay = document.getElementById('cameraStartOverlay');
    const stream = await navigator.mediaDevices.getUserMedia({
      video: { width: { ideal: 1280 }, height: { ideal: 720 }, facingMode: "user" },
      audio: true
    });
    video.srcObject = stream;
    await video.play();
    overlay.classList.add('hidden');
    applyLiveFilter('glam');
  } catch (e) {
    alert('Camera access note: Please allow camera permissions in your browser bar.');
  }
}

// Auto attempt start camera on page load
window.addEventListener('DOMContentLoaded', () => {
  startLiveCamera();
});

// TikTok Live Automated Reader Audience Simulation (Hearts & Comments)
const sampleAudienceComments = [
  "Love this poem so much! ❤️",
  "Your voice is so calming 🌹",
  "Reading along from Nairobi! 📚",
  "Such powerful prose ✨",
  "Recite the second stanza again please!",
  "Giving 5 stars to this live stage 💎",
  "Brilliant recital! 👑",
  "So inspiring! 🙌"
];

setInterval(() => {
  // Random heart floating
  if (Math.random() > 0.4) {
    sendLiveHeart('<%= session._id %>');
  }

  // Random viewer comment
  if (Math.random() > 0.6) {
    const randomUser = "Reader_" + Math.floor(1000 + Math.random() * 9000);
    const randomComment = sampleAudienceComments[Math.floor(Math.random() * sampleAudienceComments.length)];
    const feed = document.getElementById('chatFeed');
    const msg = document.createElement('div');
    msg.className = 'flex items-start gap-2 p-2.5 rounded-2xl bg-brand-cream/50 dark:bg-brand-brown/15 border border-brand-brown/5';
    msg.innerHTML = `
      <span class="font-bold text-brand-brown dark:text-brand-pink shrink-0">${randomUser}:</span>
      <span class="text-gray-800 dark:text-gray-200 leading-snug">${randomComment}</span>
    `;
    feed.appendChild(msg);
    feed.scrollTop = feed.scrollHeight;
  }
}, 4000);

// Send Audience Gift
function sendGift(giftName) {
  const user = "<%= user ? user.username : 'Reader' %>";
  const banner = document.getElementById('giftNotificationBanner');
  const toast = document.createElement('div');
  toast.className = 'bg-black/90 backdrop-blur text-white text-xs font-bold px-4 py-2 rounded-2xl border border-amber-400/40 shadow-xl flex items-center gap-2 animate-bounce';
  toast.innerHTML = `<span>✨ ${user} sent ${giftName}!</span>`;
  banner.appendChild(toast);

  // Add to live chat feed
  const feed = document.getElementById('chatFeed');
  const msg = document.createElement('div');
  msg.className = 'p-2.5 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-amber-700 dark:text-amber-300 font-bold text-center';
  msg.innerHTML = `🎁 ${user} sent ${giftName} to <%= session.hostName %>!`;
  feed.appendChild(msg);
  feed.scrollTop = feed.scrollHeight;

  setTimeout(() => toast.remove(), 3000);
}

// Live Chat Simulation & Messaging
function sendChatMessage(e) {
  e.preventDefault();
  const input = document.getElementById('chatInput');
  const text = input.value.trim();
  if (!text) return;

  const feed = document.getElementById('chatFeed');
  const msg = document.createElement('div');
  msg.className = 'flex items-start gap-2 p-2.5 rounded-2xl bg-brand-cream/50 dark:bg-brand-brown/15 border border-brand-brown/5';
  msg.innerHTML = `
    <span class="font-bold text-brand-brown dark:text-brand-pink shrink-0"><%= user ? user.username : 'Guest Reader' %>:</span>
    <span class="text-gray-800 dark:text-gray-200 leading-snug">${text}</span>
  `;
  feed.appendChild(msg);
  feed.scrollTop = feed.scrollHeight;
  input.value = '';
}

// Live TikTok-style Floating Hearts Animation
async function sendLiveHeart(sessionId) {
  try {
    const res = await fetch('/live/' + sessionId + '/like', { method: 'POST' });
    const data = await res.json();
    if (data.success) {
      document.getElementById('liveLikesCount').innerText = data.likesCount;
    }
  } catch (err) {}

  // Trigger visual floating heart
  const container = document.getElementById('heartsContainer');
  const heart = document.createElement('div');
  heart.innerHTML = '❤️';
  heart.style.position = 'absolute';
  heart.style.bottom = '20px';
  heart.style.right = (20 + Math.random() * 40) + 'px';
  heart.style.fontSize = (20 + Math.random() * 20) + 'px';
  heart.style.transition = 'all 2s ease-out';
  heart.style.opacity = '1';
  container.appendChild(heart);

  setTimeout(() => {
    heart.style.transform = `translateY(-${150 + Math.random() * 150}px) scale(1.5)`;
    heart.style.opacity = '0';
  }, 50);

  setTimeout(() => heart.remove(), 2100);
}
</script>

<%- include('partials/footer') %>
