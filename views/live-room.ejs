<%- include('partials/header') %>
<%- include('partials/navbar') %>

<!-- Socket.io Client -->
<script src="https://cdn.socket.io/4.7.5/socket.io.min.js"></script>

<!-- TikTok Live Room - Full Immersive Dual Stage Layout -->
<div id="live-room-wrapper" class="bg-black min-h-screen relative overflow-hidden flex flex-col justify-between text-white select-none">

  <!-- ==========================================
       1. TOP BAR (Host Info, Live Stats & Stream Tools)
       ========================================== -->
  <div class="relative z-40 flex items-start sm:items-center justify-between px-3 sm:px-6 py-3 bg-gradient-to-b from-black/85 via-black/50 to-transparent">
    
    <!-- Left: Host Badge -->
    <div class="flex items-center gap-2 bg-black/60 backdrop-blur-md px-3 py-1.5 rounded-full border border-white/15 max-w-[55%] sm:max-w-none">
      <img src="<%= session.hostAvatar || '/uploads/default-avatar.png' %>" class="w-8 h-8 sm:w-9 sm:h-9 rounded-full object-cover ring-2 ring-red-500 shrink-0" alt="<%= session.hostName %>">
      <div class="leading-tight truncate">
        <div class="flex items-center gap-1.5">
          <span class="text-white text-xs sm:text-sm font-bold truncate"><%= session.hostName %></span>
          <span class="bg-red-600 text-[9px] px-1.5 py-0.5 rounded font-black uppercase tracking-wider shrink-0">HOST</span>
        </div>
        <p class="text-gray-400 text-[10px] sm:text-xs truncate"><%= session.workTitle || 'Live Stage' %></p>
      </div>
      <% if (user && String(user._id) !== String(session.hostId)) { %>
        <button id="hostFollowBtn" onclick="toggleFollowUser('<%= session.hostId %>', 'hostFollowBtn')" class="ml-1 px-3 py-1 bg-red-600 hover:bg-red-700 text-white text-[10px] font-bold rounded-full transition-all flex items-center gap-1 shrink-0 shadow-md">
          <i data-lucide="user-plus" class="w-3 h-3"></i>
          <span id="hostFollowText">+ Follow</span>
        </button>
      <% } %>
    </div>

    <!-- Right: Stats, Audio, Cam & Close -->
    <div class="flex items-center justify-end flex-wrap gap-1.5 sm:gap-2 shrink max-w-[65%] sm:max-w-none">
      
      <!-- Live Beacon -->
      <span class="hidden sm:inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-red-600 text-white text-[10px] font-black uppercase tracking-wider animate-pulse">
        <span class="w-1.5 h-1.5 rounded-full bg-white"></span> LIVE
      </span>

      <!-- Viewers & People In Live (Clickable for Everyone) -->
      <button type="button" onclick="openParticipantsModal()" id="viewersPill" title="Tap to see everyone watching this live" class="flex items-center gap-1.5 bg-black/60 hover:bg-white/20 backdrop-blur-md px-2.5 sm:px-3 py-1.5 rounded-full border border-white/15 text-xs transition-all cursor-pointer group shadow-sm">
        <i data-lucide="users" class="w-3.5 h-3.5 text-blue-400 group-hover:scale-110 transition-transform"></i>
        <span id="viewerCount" class="font-bold font-mono text-white"><%= session.viewersCount || 1 %></span>
      </button>

      <!-- Likes Counter -->
      <div class="flex items-center gap-1 bg-black/60 backdrop-blur-md px-2.5 sm:px-3 py-1.5 rounded-full border border-red-500/30 text-xs text-red-400">
        <svg class="w-3.5 h-3.5 fill-red-500 text-red-500 animate-pulse" viewBox="0 0 24 24">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
        </svg>
        <span id="likesCount" class="font-bold font-mono text-white"><%= session.likesCount || 0 %></span>
      </div>

      <!-- Microphone Mute / Unmute Toggle (Broadcasters only) -->
      <button id="micToggleBtn" onclick="toggleMicrophone()" title="Mute / Unmute Microphone (Shortcut: Press M)" class="px-3 py-1.5 rounded-full bg-green-600/30 hover:bg-green-600/50 border border-green-500/50 flex items-center gap-1.5 text-xs text-green-400 font-bold transition-all shadow-md">
        <i data-lucide="mic" id="micIcon" class="w-3.5 h-3.5 text-green-400"></i>
        <span id="micStatusText" class="hidden sm:inline">Mic On</span>
      </button>

      <!-- Voice Monitor (Hear Myself) -->
      <button onclick="toggleVoiceLoopback()" id="voiceLoopbackBtn" title="Test Voice / Hear Myself in Headphones" class="w-8 h-8 rounded-full bg-black/60 backdrop-blur-md border border-white/15 flex items-center justify-center text-gray-400 hover:text-white hover:bg-white/20 transition-all">
        <i data-lucide="headphones" id="loopbackIcon" class="w-4 h-4"></i>
      </button>

      <!-- Manage Guests & Viewers (Host Only) -->
      <% if (isHost) { %>
        <button onclick="toggleGuestManager()" title="Manage Stage & Invite Guests" class="px-2.5 py-1.5 rounded-full bg-amber-500/20 hover:bg-amber-500/40 border border-amber-500/40 text-amber-400 text-xs font-bold flex items-center gap-1 transition-all shadow-md">
          <i data-lucide="users" class="w-3.5 h-3.5"></i>
          <span class="hidden sm:inline">Invite Guests</span>
        </button>
      <% } %>

      <!-- Camera Switcher -->
      <button onclick="switchCamera()" id="switchCamBtn" title="Switch Camera Source" class="px-2.5 py-1 rounded-full bg-black/60 backdrop-blur-md border border-white/15 text-xs text-amber-400 hover:bg-white/20 transition-all flex items-center gap-1">
        <i data-lucide="camera" class="w-3.5 h-3.5"></i>
        <span class="hidden sm:inline text-[11px] font-bold">Switch Cam</span>
      </button>

      <!-- Camera Flip / Mirror -->
      <button onclick="toggleMirror()" title="Flip Camera" class="w-8 h-8 rounded-full bg-black/60 backdrop-blur-md border border-white/15 flex items-center justify-center text-white hover:bg-white/20 transition-all">
        <i data-lucide="flip-horizontal" class="w-4 h-4"></i>
      </button>

      <!-- End Stream (Host) or Exit (Viewer) -->
      <% if (isHost) { %>
        <form action="/live/<%= session._id %>/end" method="POST" onsubmit="return confirm('End your live stream broadcast?');">
          <button type="submit" class="px-3 py-1.5 bg-red-600 hover:bg-red-700 text-white text-xs font-bold rounded-full shadow transition-all flex items-center gap-1 shrink-0 whitespace-nowrap">
            <i data-lucide="square" class="w-3 h-3 fill-white"></i>
            <span>End Live</span>
          </button>
        </form>
      <% } else { %>
        <a href="/live" class="px-3 py-1.5 bg-white/15 hover:bg-white/30 backdrop-blur-md rounded-full text-white text-xs font-bold flex items-center gap-1 transition-colors shrink-0 whitespace-nowrap" title="Leave Room">
          <i data-lucide="log-out" class="w-3 h-3"></i>
          <span>Leave</span>
        </a>
      <% } %>

    </div>
  </div>

  <!-- Unmute Stream Audio Banner (For Audience if autoplay muted) -->
  <div id="unmuteAudioBanner" class="hidden absolute top-16 left-1/2 -translate-x-1/2 z-40 bg-gradient-to-r from-red-600 to-pink-600 text-white px-4 py-1.5 rounded-full shadow-2xl flex items-center gap-2 cursor-pointer animate-bounce" onclick="enableViewerAudio()">
    <i data-lucide="volume-2" class="w-4 h-4"></i>
    <span class="text-xs font-bold">Tap to Unmute Host Audio 🔊</span>
  </div>

  <!-- Top Gifters Ribbon -->
  <div class="relative z-30 px-4 flex items-center gap-2 overflow-x-auto scrollbar-hide py-1">
    <% if (topGifters && topGifters.length > 0) { %>
      <span class="text-[10px] uppercase font-bold text-amber-400 tracking-wider shrink-0">Top Gifters:</span>
      <% topGifters.slice(0, 3).forEach(function(g, i) { %>
        <div class="flex items-center gap-1.5 bg-black/60 backdrop-blur-md border <%= i === 0 ? 'border-amber-500/50 bg-amber-500/10' : 'border-white/10' %> px-2.5 py-1 rounded-full text-xs shrink-0">
          <span><%= i === 0 ? '👑' : i === 1 ? '🥈' : '🥉' %></span>
          <span class="font-bold text-white truncate max-w-[80px]"><%= g.username %></span>
          <span class="text-amber-400 font-mono font-bold text-[11px]">+<%= g.totalPoints %></span>
        </div>
      <% }) %>
    <% } %>
  </div>

  <!-- ==========================================
       2. DYNAMIC LIVE STAGE (Single or Dual Split-Screen)
       ========================================== -->
  <div id="videoStageContainer" class="absolute inset-0 z-0 bg-black flex flex-col md:flex-row items-center justify-center transition-all duration-500" ondblclick="handleDoubleTapLike(event)">
    
    <!-- HOST VIDEO WINDOW -->
    <div id="hostVideoWrapper" class="relative w-full h-full flex-1 flex items-center justify-center bg-black overflow-hidden transition-all duration-300">
      <video id="liveVideoFeed" class="w-full h-full object-cover transform -scale-x-100 transition-all duration-300 filter-glam" autoplay playsinline></video>
      
      <!-- Top Host Tag & Speaking Indicator (Cleanly positioned at top, never blocked by bottom chat) -->
      <div class="absolute top-4 left-4 z-20 flex items-center gap-2">
        <div class="bg-red-600/90 text-white text-[9px] font-black px-2 py-0.5 rounded-full uppercase tracking-wider backdrop-blur-md shadow">
          HOST
        </div>
        <div id="hostSpeakingIndicator" class="flex items-center gap-1 bg-black/60 backdrop-blur-md px-2.5 py-0.5 rounded-full border border-white/15">
          <span class="w-1 h-2.5 bg-green-400 rounded-full animate-bounce"></span>
          <span class="w-1 h-3.5 bg-green-400 rounded-full animate-bounce delay-100"></span>
          <span class="w-1 h-2 bg-green-400 rounded-full animate-bounce delay-200"></span>
          <span class="text-[9px] font-bold text-green-400 ml-1" id="hostMicLabel">Mic Active</span>
        </div>
        <div id="hostMutedBadge" class="hidden bg-red-600/90 text-white text-[9px] font-bold px-2 py-0.5 rounded-full border border-red-400/30 flex items-center gap-1 shadow-lg">
          <i data-lucide="mic-off" class="w-2.5 h-2.5"></i> Muted
        </div>
      </div>
    </div>

    <!-- CO-HOST GUEST VIDEO WINDOW (Visible when guest is active) -->
    <div id="guestVideoWrapper" class="hidden relative w-full h-full flex-1 flex items-center justify-center bg-gray-950 border-t-2 md:border-t-0 md:border-l-2 border-brand-brown/40 overflow-hidden transition-all duration-300">
      <video id="guestVideoFeed" class="w-full h-full object-cover transform -scale-x-100 transition-all duration-300" autoplay playsinline></video>
      
      <!-- Top Guest Tag & Speaking Indicator -->
      <div class="absolute top-4 left-4 z-20 flex items-center gap-2">
        <div class="bg-blue-600/90 text-white text-[9px] font-black px-2 py-0.5 rounded-full uppercase tracking-wider backdrop-blur-md shadow">
          GUEST
        </div>
        <div id="guestSpeakingIndicator" class="flex items-center gap-1 bg-black/60 backdrop-blur-md px-2.5 py-0.5 rounded-full border border-white/15">
          <span class="w-1 h-2.5 bg-blue-400 rounded-full animate-bounce"></span>
          <span class="w-1 h-3.5 bg-blue-400 rounded-full animate-bounce delay-100"></span>
          <span class="text-[9px] font-bold text-blue-400 ml-1" id="guestStageName">Co-Host</span>
        </div>
        <div id="guestMutedBadge" class="hidden bg-red-600/90 text-white text-[9px] font-bold px-2 py-0.5 rounded-full border border-red-400/30 flex items-center gap-1 shadow-lg">
          <i data-lucide="mic-off" class="w-2.5 h-2.5"></i> Muted
        </div>
        <button id="guestFollowBtn" onclick="toggleFollowGuest()" class="px-2 py-0.5 bg-red-600/90 hover:bg-red-700 text-white text-[9px] font-bold rounded-full border border-white/20 flex items-center gap-1 transition-all shadow">
          <i data-lucide="user-plus" class="w-2.5 h-2.5"></i> <span id="guestFollowText">+ Follow</span>
        </button>
      </div>

      <!-- Host Action: Drop Guest Button -->
      <% if (isHost) { %>
        <button onclick="dropCurrentGuest()" title="Remove guest from stage" class="absolute top-4 right-4 z-30 px-3 py-1 bg-red-600/90 hover:bg-red-700 text-white text-[10px] font-bold rounded-full border border-red-400/30 flex items-center gap-1 transition-all shadow-lg">
          <i data-lucide="user-x" class="w-3 h-3"></i> Drop Guest
        </button>
      <% } %>

      <!-- Guest Action: Leave Stage Button -->
      <button id="leaveStageBtn" onclick="leaveCoHostStage()" class="hidden absolute top-4 right-4 z-30 px-3 py-1 bg-gray-800/90 hover:bg-gray-700 text-white text-[10px] font-bold rounded-full border border-white/20 flex items-center gap-1 transition-all shadow-lg">
        <i data-lucide="log-out" class="w-3 h-3"></i> Leave Stage
      </button>
    </div>

    <!-- Double Tap Ripple Effect Container -->
    <div id="doubleTapHeartsContainer" class="absolute inset-0 pointer-events-none overflow-hidden z-20"></div>

    <!-- Floating Upwards Hearts Container -->
    <div id="heartsStreamContainer" class="absolute right-4 bottom-24 w-20 h-96 pointer-events-none overflow-hidden z-30"></div>

    <!-- Large Center Gift Animation Display -->
    <div id="bigGiftCelebration" class="absolute inset-0 pointer-events-none z-40 flex flex-col items-center justify-center"></div>

  </div>

  <!-- Camera Permission Overlay (For Host) -->
  <% if (isHost) { %>
  <div id="cameraStartModal" class="absolute inset-0 z-50 bg-black/90 backdrop-blur-lg flex flex-col items-center justify-center p-6 text-center space-y-4">
    <div class="w-20 h-20 rounded-full bg-red-600/20 text-red-500 flex items-center justify-center ring-4 ring-red-500/30 animate-pulse">
      <i data-lucide="video" class="w-10 h-10"></i>
    </div>
    <div class="max-w-sm">
      <h3 class="font-serif text-2xl font-bold text-white">Start Your Live Recital</h3>
      <p class="text-xs text-gray-300 mt-1">Turn on your camera and microphone. Your followers will be able to see and hear you live!</p>
    </div>
    <button onclick="startLiveCamera()" class="px-8 py-3.5 bg-red-600 hover:bg-red-700 text-white font-bold rounded-2xl text-sm flex items-center gap-2 shadow-xl hover:scale-105 transition-all">
      <i data-lucide="camera" class="w-5 h-5"></i> Enable Camera & Microphone
    </button>
  </div>
  <% } %>

  <!-- Co-Host Request Modal (Host Receives) -->
  <% if (isHost) { %>
  <div id="coHostRequestModal" class="hidden absolute top-20 right-4 z-50 bg-black/95 backdrop-blur-xl border border-amber-500/40 rounded-3xl p-4 w-80 space-y-3 shadow-2xl animate-bounce">
    <div class="flex items-center justify-between">
      <span class="text-xs font-bold text-amber-400 uppercase tracking-wider flex items-center gap-1.5">
        <i data-lucide="users" class="w-4 h-4"></i> Guest Join Request
      </span>
      <button onclick="dismissCoHostModal()" class="text-gray-400 hover:text-white"><i data-lucide="x" class="w-4 h-4"></i></button>
    </div>
    <div class="flex items-center gap-3 bg-white/10 p-2.5 rounded-2xl">
      <img id="coHostAvatarImg" src="/uploads/default-avatar.png" class="w-10 h-10 rounded-full object-cover ring-2 ring-amber-500" alt="">
      <div>
        <p id="coHostRequesterName" class="text-sm font-bold text-white"></p>
        <p class="text-[10px] text-gray-300">Requested to join you on live stage</p>
      </div>
    </div>
    <!-- Guest Follow Button -->
      <div class="absolute top-4 left-4 z-30 flex items-center gap-2">
        <span class="bg-blue-600/90 text-white text-[9px] font-black px-2 py-0.5 rounded-full uppercase tracking-wider backdrop-blur-md">
          GUEST
        </span>
        <button id="guestFollowBtn" onclick="toggleFollowGuest()" class="px-2.5 py-0.5 bg-red-600/90 hover:bg-red-700 text-white text-[9px] font-bold rounded-full border border-white/20 flex items-center gap-1 transition-all shadow">
          <i data-lucide="user-plus" class="w-2.5 h-2.5"></i> <span id="guestFollowText">+ Follow</span>
        </button>
      </div>

      <div class="flex gap-2">
      <button onclick="acceptCoHost()" class="flex-1 py-2.5 bg-green-600 hover:bg-green-700 text-white text-xs font-bold rounded-xl transition-all shadow">
        Accept Guest
      </button>
      <button onclick="rejectCoHost()" class="flex-1 py-2.5 bg-red-600 hover:bg-red-700 text-white text-xs font-bold rounded-xl transition-all shadow">
        Decline
      </button>
    </div>
  </div>
  <% } %>

  <!-- Guest Join Stage Invitation Modal (Viewer Receives) -->
  <div id="guestJoinStageModal" class="hidden fixed inset-0 z-50 bg-black/85 backdrop-blur-md flex items-center justify-center p-4">
    <div class="bg-black/95 border border-amber-500/40 rounded-3xl p-6 max-w-sm w-full text-center space-y-4 shadow-2xl">
      <div class="w-16 h-16 rounded-full bg-amber-500/20 text-amber-400 flex items-center justify-center mx-auto ring-4 ring-amber-500/30 animate-pulse">
        <i data-lucide="video" class="w-8 h-8"></i>
      </div>
      <div>
        <h3 class="font-serif text-xl font-bold text-white">Join Live Stage</h3>
        <p class="text-xs text-gray-300 mt-1">You are invited to co-host with <%= session.hostName %>! Enable your camera and microphone to step on stage.</p>
      </div>
      <div class="flex gap-2.5">
        <button onclick="confirmJoinAsGuest()" class="flex-1 py-3 bg-green-600 hover:bg-green-700 text-white text-xs font-bold rounded-xl shadow-lg transition-all">
          Enable Cam & Join
        </button>
        <button onclick="declineGuestInvitation()" class="flex-1 py-3 bg-white/10 hover:bg-white/20 text-white text-xs font-bold rounded-xl transition-all">
          Decline
        </button>
      </div>
    </div>
  </div>

  <!-- ==========================================
       3. BOTTOM OVERLAYS (Floating Chat, Action Controls & Gifts)
       ========================================== -->
  <div class="relative z-30 p-3 sm:p-5 space-y-3">
    
    <!-- Floating Live Chat Feed -->
    <div id="liveChatFeed" class="max-h-48 sm:max-h-60 overflow-y-auto space-y-1.5 pr-2 scrollbar-hide max-w-lg">
      <div class="inline-block bg-black/60 backdrop-blur-md px-3.5 py-1.5 rounded-2xl border border-white/10">
        <span class="text-amber-400 text-xs font-bold">✨ Readers Africa:</span>
        <span class="text-gray-200 text-xs ml-1">Welcome to <%= session.hostName %>'s live session! Double tap the screen to like ❤️</span>
      </div>
    </div>

    <!-- Bottom Action Bar (Chat Input, Gift Button, Heart Button, Join Request) -->
    <div class="flex items-center gap-2">
      
      <!-- Chat Input Form -->
      <form onsubmit="sendLiveComment(event)" class="flex-1 relative">
        <input type="text" id="liveChatInput" placeholder="Send a live comment..." class="w-full pl-4 pr-10 py-2.5 rounded-full bg-black/60 backdrop-blur-md border border-white/20 text-white text-xs placeholder-gray-400 focus:outline-none focus:border-white/50 focus:ring-1 focus:ring-white/50" autocomplete="off">
        <button type="submit" class="absolute right-2 top-1/2 -translate-y-1/2 w-7 h-7 rounded-full bg-red-600 text-white flex items-center justify-center hover:bg-red-700 transition-colors">
          <i data-lucide="send" class="w-3.5 h-3.5"></i>
        </button>
      </form>

      <!-- Read Along Teleprompter Trigger -->
      <button onclick="toggleTeleprompter()" class="px-3 py-2.5 rounded-full bg-black/60 backdrop-blur-md border border-white/20 text-white text-xs font-bold flex items-center gap-1.5 hover:bg-white/20 transition-all shrink-0">
        <i data-lucide="book-open" class="w-4 h-4 text-amber-400"></i>
        <span class="hidden sm:inline">Read Along</span>
      </button>

      <!-- TikTok Live Beauty Filters Studio Button -->
      <button onclick="toggleBeautyPanel()" id="beautyBtn" title="Beauty Filters & Skin Glow" class="w-10 h-10 rounded-full bg-gradient-to-tr from-pink-600 via-rose-500 to-amber-400 text-white flex items-center justify-center shadow-lg hover:scale-110 active:scale-95 transition-all shrink-0">
        <i data-lucide="sparkles" class="w-5 h-5"></i>
      </button>

      <!-- Multi-Guest / Co-Host Request (Audience Only) -->
      <% if (user && String(user._id) !== String(session.hostId)) { %>
        <button id="coHostRequestBtn" onclick="requestToJoinLive()" title="Request to join live as guest" class="w-10 h-10 rounded-full bg-black/60 backdrop-blur-md border border-white/20 text-white flex items-center justify-center hover:bg-white/20 transition-all shrink-0">
          <i data-lucide="hand" class="w-5 h-5 text-amber-400"></i>
        </button>
      <% } %>

      <!-- TikTok Gift Tray Button -->
      <button onclick="toggleGiftTray()" id="giftBtn" title="Send Gift" class="w-10 h-10 rounded-full bg-gradient-to-tr from-amber-500 via-orange-500 to-red-500 text-white flex items-center justify-center shadow-lg hover:scale-110 active:scale-95 transition-all shrink-0">
        <i data-lucide="gift" class="w-5 h-5"></i>
      </button>

      <!-- Big Heart Like Button -->
      <button onclick="triggerLiveLike()" title="Send Hearts" class="w-11 h-11 rounded-full bg-gradient-to-tr from-red-600 to-pink-500 text-white flex items-center justify-center shadow-xl hover:scale-110 active:scale-125 transition-all shrink-0 border-2 border-white/30">
        <svg class="w-6 h-6 fill-white text-white" viewBox="0 0 24 24">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
        </svg>
      </button>

    </div>

    <!-- 4. TIKTOK GIFTS TRAY MODAL -->
    <div id="giftTrayModal" class="hidden bg-black/95 backdrop-blur-2xl border border-white/20 rounded-3xl p-4 sm:p-5 shadow-2xl transition-all">
      <div class="flex items-center justify-between mb-3 border-b border-white/10 pb-2">
        <div class="flex items-center gap-2">
          <i data-lucide="gift" class="w-4 h-4 text-amber-400"></i>
          <span class="text-sm font-bold text-white">Send a Live Gift</span>
        </div>
        <button onclick="toggleGiftTray()" class="text-gray-400 hover:text-white"><i data-lucide="x" class="w-4 h-4"></i></button>
      </div>

      <!-- Gift Options Grid -->
      <div class="grid grid-cols-3 sm:grid-cols-6 gap-2.5">
        
        <!-- 1. Rose -->
        <button onclick="sendLiveGift('rose', 'Rose', '🌹', 5)" class="group flex flex-col items-center p-3 rounded-2xl bg-white/5 hover:bg-gradient-to-b hover:from-red-600/30 hover:to-red-900/40 border border-white/10 hover:border-red-500 transition-all hover:scale-105">
          <span class="text-3xl sm:text-4xl group-hover:scale-125 transition-transform mb-1">🌹</span>
          <span class="text-xs font-bold text-white">Rose</span>
          <span class="text-[10px] font-bold text-amber-400 mt-0.5">5 pts</span>
        </button>

        <!-- 2. Golden Book -->
        <button onclick="sendLiveGift('book', 'Golden Book', '📚', 15)" class="group flex flex-col items-center p-3 rounded-2xl bg-white/5 hover:bg-gradient-to-b hover:from-amber-600/30 hover:to-amber-900/40 border border-white/10 hover:border-amber-500 transition-all hover:scale-105">
          <span class="text-3xl sm:text-4xl group-hover:scale-125 transition-transform mb-1">📚</span>
          <span class="text-xs font-bold text-white">Book</span>
          <span class="text-[10px] font-bold text-amber-400 mt-0.5">15 pts</span>
        </button>

        <!-- 3. Diamond -->
