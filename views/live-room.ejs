<%- include('partials/header') %>
<%- include('partials/navbar') %>

<!-- Socket.io Client -->
<script src="/socket.io/socket.io.js"></script>

<!-- TikTok Live Room - Full Immersive Layout -->
<div id="live-room-wrapper" class="bg-black min-h-screen relative overflow-hidden flex flex-col justify-between text-white select-none">

  <!-- 1. TOP BAR (Host Profile, Stats & Live Tools) -->
  <div class="relative z-40 flex items-center justify-between px-3 sm:px-6 py-3 bg-gradient-to-b from-black/80 via-black/40 to-transparent">
    
    <!-- Left: Host Info Badge -->
    <div class="flex items-center gap-2 bg-black/60 backdrop-blur-md px-3 py-1.5 rounded-full border border-white/15 max-w-[55%] sm:max-w-none">
      <img src="<%= session.hostAvatar || '/uploads/default-avatar.png' %>" class="w-8 h-8 sm:w-9 sm:h-9 rounded-full object-cover ring-2 ring-red-500 shrink-0" alt="<%= session.hostName %>">
      <div class="leading-tight truncate">
        <div class="flex items-center gap-1.5">
          <span class="text-white text-xs sm:text-sm font-bold truncate"><%= session.hostName %></span>
          <span class="bg-red-600 text-[9px] px-1.5 py-0.5 rounded font-black uppercase tracking-wider shrink-0">HOST</span>
        </div>
        <p class="text-gray-400 text-[10px] sm:text-xs truncate"><%= session.workTitle || 'Live Stage' %></p>
      </div>
      <% if (user && String(user._id) !== String(session.hostId)) { %>
        <button onclick="followHost()" class="ml-1 px-2.5 py-1 bg-red-600 hover:bg-red-700 text-white text-[10px] font-bold rounded-full transition-colors shrink-0">
          + Follow
        </button>
      <% } %>
    </div>

    <!-- Right: Viewer Count, Likes Count, Filter Selector & Close -->
    <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
      
      <!-- Live Indicator -->
      <span class="hidden sm:inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-red-600 text-white text-[10px] font-black uppercase tracking-wider animate-pulse">
        <span class="w-1.5 h-1.5 rounded-full bg-white"></span> LIVE
      </span>

      <!-- Viewers Count Badge -->
      <div class="flex items-center gap-1 bg-black/60 backdrop-blur-md px-2.5 sm:px-3 py-1.5 rounded-full border border-white/15 text-xs">
        <i data-lucide="eye" class="w-3.5 h-3.5 text-blue-400"></i>
        <span id="viewerCount" class="font-bold font-mono"><%= session.viewersCount || 1 %></span>
      </div>

      <!-- Likes Counter Badge -->
      <div class="flex items-center gap-1 bg-black/60 backdrop-blur-md px-2.5 sm:px-3 py-1.5 rounded-full border border-red-500/30 text-xs text-red-400">
        <svg class="w-3.5 h-3.5 fill-red-500 text-red-500 animate-pulse" viewBox="0 0 24 24">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
        </svg>
        <span id="likesCount" class="font-bold font-mono text-white"><%= session.likesCount || 0 %></span>
      </div>

      <!-- Real-Time Beauty Face Filter Switcher -->
      <div class="relative">
        <button onclick="toggleFilterMenu()" title="Live Beauty Filters" class="w-8 h-8 rounded-full bg-black/60 backdrop-blur-md border border-white/15 flex items-center justify-center text-amber-400 hover:bg-white/20 transition-all">
          <i data-lucide="sparkles" class="w-4 h-4"></i>
        </button>
        <!-- Filter Dropdown -->
        <div id="filterDropdown" class="hidden absolute right-0 mt-2 w-48 bg-black/95 backdrop-blur-xl border border-white/20 rounded-2xl p-2 shadow-2xl z-50 space-y-1">
          <p class="text-[10px] uppercase font-bold text-gray-400 px-2 py-1 tracking-wider">Beauty Filters</p>
          <button onclick="applyFilter('glam')" class="w-full text-left px-3 py-1.5 rounded-xl text-xs font-semibold hover:bg-white/15 flex items-center gap-2">
            <span>✨</span> Glam Glow
          </button>
          <button onclick="applyFilter('natural')" class="w-full text-left px-3 py-1.5 rounded-xl text-xs font-semibold hover:bg-white/15 flex items-center gap-2">
            <span>🌟</span> Natural HD
          </button>
          <button onclick="applyFilter('golden')" class="w-full text-left px-3 py-1.5 rounded-xl text-xs font-semibold hover:bg-white/15 flex items-center gap-2">
            <span>🌅</span> Golden Hour
          </button>
          <button onclick="applyFilter('vibrant')" class="w-full text-left px-3 py-1.5 rounded-xl text-xs font-semibold hover:bg-white/15 flex items-center gap-2">
            <span>🎨</span> Vibrant Pop
          </button>
          <button onclick="applyFilter('romance')" class="w-full text-left px-3 py-1.5 rounded-xl text-xs font-semibold hover:bg-white/15 flex items-center gap-2">
            <span>💖</span> Warm Romance
          </button>
          <button onclick="applyFilter('noir')" class="w-full text-left px-3 py-1.5 rounded-xl text-xs font-semibold hover:bg-white/15 flex items-center gap-2">
            <span>🎬</span> Vintage Noir
          </button>
        </div>
      </div>

      <!-- Camera Flip / Mirror -->
      <button onclick="toggleMirror()" title="Flip Camera" class="w-8 h-8 rounded-full bg-black/60 backdrop-blur-md border border-white/15 flex items-center justify-center text-white hover:bg-white/20 transition-all">
        <i data-lucide="flip-horizontal" class="w-4 h-4"></i>
      </button>

      <!-- End Stream (Host) or Exit (Viewer) -->
      <% if (isHost) { %>
        <form action="/live/<%= session._id %>/end" method="POST" onsubmit="return confirm('End your live stream broadcast?');">
          <button type="submit" class="px-3 py-1.5 bg-red-600 hover:bg-red-700 text-white text-xs font-bold rounded-full shadow transition-all flex items-center gap-1">
            <i data-lucide="square" class="w-3 h-3 fill-white"></i>
            <span class="hidden sm:inline">End Live</span>
          </button>
        </form>
      <% } else { %>
        <a href="/live" class="w-8 h-8 rounded-full bg-white/15 backdrop-blur-md flex items-center justify-center text-white hover:bg-white/30 transition-colors" title="Leave Room">
          <i data-lucide="x" class="w-4 h-4"></i>
        </a>
      <% } %>

    </div>
  </div>

  <!-- Top Gifters Ribbon -->
  <div class="relative z-30 px-4 flex items-center gap-2 overflow-x-auto scrollbar-hide py-1">
    <% if (topGifters && topGifters.length > 0) { %>
      <span class="text-[10px] uppercase font-bold text-amber-400 tracking-wider shrink-0">Top Gifters:</span>
      <% topGifters.slice(0, 3).forEach(function(g, i) { %>
        <div class="flex items-center gap-1.5 bg-black/60 backdrop-blur-md border <%= i === 0 ? 'border-amber-500/50 bg-amber-500/10' : 'border-white/10' %> px-2.5 py-1 rounded-full text-xs shrink-0">
          <span><%= i === 0 ? '👑' : i === 1 ? '🥈' : '🥉' %></span>
          <span class="font-bold text-white truncate max-w-[80px]"><%= g.username %></span>
          <span class="text-amber-400 font-mono font-bold text-[11px]">+<%= g.totalPoints %></span>
        </div>
      <% }) %>
    <% } %>
  </div>

  <!-- 2. FULL-SCREEN VIDEO STREAM FEED & OVERLAYS -->
  <div id="videoContainer" class="absolute inset-0 z-0 bg-black flex items-center justify-center" ondblclick="handleDoubleTapLike(event)">
    
    <!-- Live Video Element with Filters -->
    <video id="liveVideoFeed" class="w-full h-full object-cover transform -scale-x-100 filter-glam transition-all duration-300" autoplay playsinline muted></video>
    
    <!-- Ambient dark gradient overlays for readability -->
    <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-transparent to-black/90 pointer-events-none"></div>

    <!-- Double Tap Ripple Effect Container -->
    <div id="doubleTapHeartsContainer" class="absolute inset-0 pointer-events-none overflow-hidden z-20"></div>

    <!-- Floating Upwards Hearts Container -->
    <div id="heartsStreamContainer" class="absolute right-4 bottom-24 w-20 h-96 pointer-events-none overflow-hidden z-30"></div>

    <!-- Large Center Gift Animation Display -->
    <div id="bigGiftCelebration" class="absolute inset-0 pointer-events-none z-40 flex flex-col items-center justify-center"></div>

  </div>

  <!-- Camera Permission Overlay (For Host) -->
  <% if (isHost) { %>
  <div id="cameraStartModal" class="absolute inset-0 z-50 bg-black/90 backdrop-blur-lg flex flex-col items-center justify-center p-6 text-center space-y-4">
    <div class="w-20 h-20 rounded-full bg-red-600/20 text-red-500 flex items-center justify-center ring-4 ring-red-500/30 animate-pulse">
      <i data-lucide="video" class="w-10 h-10"></i>
    </div>
    <div class="max-w-sm">
      <h3 class="font-serif text-2xl font-bold text-white">Start Your Live Recital</h3>
      <p class="text-xs text-gray-300 mt-1">Tap below to turn on your camera and microphone. Your followers have been alerted!</p>
    </div>
    <button onclick="startLiveCamera()" class="px-8 py-3.5 bg-red-600 hover:bg-red-700 text-white font-bold rounded-2xl text-sm flex items-center gap-2 shadow-xl hover:scale-105 transition-all">
      <i data-lucide="camera" class="w-5 h-5"></i> Enable Camera & Start Broadcasting
    </button>
  </div>
  <% } %>

  <!-- Co-Host Request Modal (Host Only) -->
  <% if (isHost) { %>
  <div id="coHostRequestModal" class="hidden absolute top-20 right-4 z-50 bg-black/95 backdrop-blur-xl border border-amber-500/30 rounded-3xl p-4 w-80 space-y-3 shadow-2xl animate-bounce">
    <div class="flex items-center justify-between">
      <span class="text-xs font-bold text-amber-400 uppercase tracking-wider flex items-center gap-1.5">
        <i data-lucide="users" class="w-4 h-4"></i> Co-Host Request
      </span>
      <button onclick="dismissCoHostModal()" class="text-gray-400 hover:text-white"><i data-lucide="x" class="w-4 h-4"></i></button>
    </div>
    <div class="flex items-center gap-3 bg-white/10 p-2.5 rounded-2xl">
      <img id="coHostAvatarImg" src="/uploads/default-avatar.png" class="w-10 h-10 rounded-full object-cover ring-2 ring-amber-500" alt="">
      <div>
        <p id="coHostRequesterName" class="text-sm font-bold text-white"></p>
        <p class="text-[10px] text-gray-300">Wants to join your live stage</p>
      </div>
    </div>
    <div class="flex gap-2">
      <button onclick="acceptCoHost()" class="flex-1 py-2.5 bg-green-600 hover:bg-green-700 text-white text-xs font-bold rounded-xl transition-all">
        Accept
      </button>
      <button onclick="rejectCoHost()" class="flex-1 py-2.5 bg-red-600 hover:bg-red-700 text-white text-xs font-bold rounded-xl transition-all">
        Decline
      </button>
    </div>
  </div>
  <% } %>

  <!-- 3. BOTTOM OVERLAYS (Floating Chat, Action Controls & Gifts) -->
  <div class="relative z-30 p-3 sm:p-5 space-y-3">
    
    <!-- Floating Live Chat Feed -->
    <div id="liveChatFeed" class="max-h-48 sm:max-h-60 overflow-y-auto space-y-1.5 pr-2 scrollbar-hide max-w-lg">
      <div class="inline-block bg-black/60 backdrop-blur-md px-3.5 py-1.5 rounded-2xl border border-white/10">
        <span class="text-amber-400 text-xs font-bold">✨ Readers Africa:</span>
        <span class="text-gray-200 text-xs ml-1">Welcome to <%= session.hostName %>'s live session! Double tap the screen to like ❤️</span>
      </div>
    </div>

    <!-- Bottom Action Bar (Chat Input, Gift Button, Heart Button, Join Request) -->
    <div class="flex items-center gap-2">
      
      <!-- Chat Input Form -->
      <form onsubmit="sendLiveComment(event)" class="flex-1 relative">
        <input type="text" id="liveChatInput" placeholder="Send a live comment..." class="w-full pl-4 pr-10 py-2.5 rounded-full bg-black/60 backdrop-blur-md border border-white/20 text-white text-xs placeholder-gray-400 focus:outline-none focus:border-white/50 focus:ring-1 focus:ring-white/50" autocomplete="off">
        <button type="submit" class="absolute right-2 top-1/2 -translate-y-1/2 w-7 h-7 rounded-full bg-red-600 text-white flex items-center justify-center hover:bg-red-700 transition-colors">
          <i data-lucide="send" class="w-3.5 h-3.5"></i>
        </button>
      </form>

      <!-- Read Along Teleprompter Trigger -->
      <button onclick="toggleTeleprompter()" class="px-3 py-2.5 rounded-full bg-black/60 backdrop-blur-md border border-white/20 text-white text-xs font-bold flex items-center gap-1.5 hover:bg-white/20 transition-all shrink-0">
        <i data-lucide="book-open" class="w-4 h-4 text-amber-400"></i>
        <span class="hidden sm:inline">Read Along</span>
      </button>

      <!-- Multi-Guest / Co-Host Request (Audience Only) -->
      <% if (user && String(user._id) !== String(session.hostId)) { %>
        <button id="coHostRequestBtn" onclick="requestToJoinLive()" title="Request to join live" class="w-10 h-10 rounded-full bg-black/60 backdrop-blur-md border border-white/20 text-white flex items-center justify-center hover:bg-white/20 transition-all shrink-0">
          <i data-lucide="hand" class="w-5 h-5 text-amber-400"></i>
        </button>
      <% } %>

      <!-- TikTok Gift Tray Button -->
      <button onclick="toggleGiftTray()" id="giftBtn" title="Send Gift" class="w-10 h-10 rounded-full bg-gradient-to-tr from-amber-500 via-orange-500 to-red-500 text-white flex items-center justify-center shadow-lg hover:scale-110 active:scale-95 transition-all shrink-0">
        <i data-lucide="gift" class="w-5 h-5"></i>
      </button>

      <!-- Big Heart Like Button -->
      <button onclick="triggerLiveLike()" title="Send Hearts" class="w-11 h-11 rounded-full bg-gradient-to-tr from-red-600 to-pink-500 text-white flex items-center justify-center shadow-xl hover:scale-110 active:scale-125 transition-all shrink-0 border-2 border-white/30">
        <svg class="w-6 h-6 fill-white text-white" viewBox="0 0 24 24">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
        </svg>
      </button>

    </div>

    <!-- 4. TIKTOK GIFTS TRAY MODAL -->
    <div id="giftTrayModal" class="hidden bg-black/95 backdrop-blur-2xl border border-white/20 rounded-3xl p-4 sm:p-5 shadow-2xl transition-all">
      <div class="flex items-center justify-between mb-3 border-b border-white/10 pb-2">
        <div class="flex items-center gap-2">
          <i data-lucide="gift" class="w-4 h-4 text-amber-400"></i>
          <span class="text-sm font-bold text-white">Send a Live Gift</span>
        </div>
        <button onclick="toggleGiftTray()" class="text-gray-400 hover:text-white"><i data-lucide="x" class="w-4 h-4"></i></button>
      </div>

      <!-- Gift Options Grid -->
      <div class="grid grid-cols-3 sm:grid-cols-6 gap-2.5">
        
        <!-- 1. Rose -->
        <button onclick="sendLiveGift('rose', 'Rose', '🌹', 5)" class="group flex flex-col items-center p-3 rounded-2xl bg-white/5 hover:bg-gradient-to-b hover:from-red-600/30 hover:to-red-900/40 border border-white/10 hover:border-red-500 transition-all hover:scale-105">
          <span class="text-3xl sm:text-4xl group-hover:scale-125 transition-transform mb-1">🌹</span>
          <span class="text-xs font-bold text-white">Rose</span>
          <span class="text-[10px] font-bold text-amber-400 mt-0.5">5 pts</span>
        </button>

        <!-- 2. Golden Book -->
        <button onclick="sendLiveGift('book', 'Golden Book', '📚', 15)" class="group flex flex-col items-center p-3 rounded-2xl bg-white/5 hover:bg-gradient-to-b hover:from-amber-600/30 hover:to-amber-900/40 border border-white/10 hover:border-amber-500 transition-all hover:scale-105">
          <span class="text-3xl sm:text-4xl group-hover:scale-125 transition-transform mb-1">📚</span>
          <span class="text-xs font-bold text-white">Book</span>
          <span class="text-[10px] font-bold text-amber-400 mt-0.5">15 pts</span>
        </button>

        <!-- 3. Diamond -->
        <button onclick="sendLiveGift('diamond', 'Diamond', '💎', 50)" class="group flex flex-col items-center p-3 rounded-2xl bg-white/5 hover:bg-gradient-to-b hover:from-blue-600/30 hover:to-blue-900/40 border border-white/10 hover:border-blue-500 transition-all hover:scale-105">
          <span class="text-3xl sm:text-4xl group-hover:scale-125 transition-transform mb-1">💎</span>
          <span class="text-xs font-bold text-white">Diamond</span>
          <span class="text-[10px] font-bold text-amber-400 mt-0.5">50 pts</span>
        </button>

        <!-- 4. Royal Crown -->
        <button onclick="sendLiveGift('crown', 'Crown', '👑', 100)" class="group flex flex-col items-center p-3 rounded-2xl bg-white/5 hover:bg-gradient-to-b hover:from-purple-600/30 hover:to-purple-900/40 border border-white/10 hover:border-purple-500 transition-all hover:scale-105">
          <span class="text-3xl sm:text-4xl group-hover:scale-125 transition-transform mb-1">👑</span>
          <span class="text-xs font-bold text-white">Crown</span>
          <span class="text-[10px] font-bold text-amber-400 mt-0.5">100 pts</span>
        </button>

        <!-- 5. Africa Star -->
        <button onclick="sendLiveGift('africa_star', 'Africa Star', '⭐', 200)" class="group flex flex-col items-center p-3 rounded-2xl bg-white/5 hover:bg-gradient-to-b hover:from-yellow-500/30 hover:to-amber-900/40 border border-white/10 hover:border-yellow-400 transition-all hover:scale-105">
          <span class="text-3xl sm:text-4xl group-hover:scale-125 transition-transform mb-1">⭐</span>
          <span class="text-xs font-bold text-white">Africa Star</span>
          <span class="text-[10px] font-bold text-amber-400 mt-0.5">200 pts</span>
        </button>

        <!-- 6. Universe -->
        <button onclick="sendLiveGift('universe', 'Universe', '🌍', 500)" class="group flex flex-col items-center p-3 rounded-2xl bg-white/5 hover:bg-gradient-to-b hover:from-indigo-600/30 hover:to-purple-900/40 border border-white/10 hover:border-indigo-400 transition-all hover:scale-105">
          <span class="text-3xl sm:text-4xl group-hover:scale-125 transition-transform mb-1">🌍</span>
          <span class="text-xs font-bold text-white">Universe</span>
          <span class="text-[10px] font-bold text-amber-400 mt-0.5">500 pts</span>
        </button>

      </div>
    </div>

  </div>

  <!-- 5. SLIDE-UP TELEPROMPTER / READ ALONG SHEET -->
  <div id="teleprompterDrawer" class="fixed inset-x-0 bottom-0 z-50 transform translate-y-full transition-transform duration-300 max-h-[70vh] bg-black/95 backdrop-blur-2xl border-t border-white/20 rounded-t-3xl p-6 overflow-y-auto">
    <div class="flex items-center justify-between mb-4 border-b border-white/10 pb-3">
      <div>
        <span class="text-[10px] uppercase font-bold text-amber-400 tracking-wider">Live Read-Along</span>
        <h3 class="font-serif text-xl sm:text-2xl font-bold text-white"><%= session.workTitle %></h3>
      </div>
      <button onclick="toggleTeleprompter()" class="p-2 rounded-full bg-white/10 hover:bg-white/20 text-white">
        <i data-lucide="chevron-down" class="w-5 h-5"></i>
      </button>
    </div>
    <div class="text-gray-200 text-sm sm:text-base leading-relaxed font-serif italic space-y-4">
      <% if (session.workContent) { %>
        <% session.workContent.split('\n\n').forEach(function(p) { %>
          <p><%= p %></p>
        <% }) %>
      <% } else { %>
        <p class="text-gray-400 italic">No text provided. Listen live as <%= session.hostName %> recites!</p>
      <% } %>
    </div>
  </div>

</div>

<!-- Face Filter Styles -->
<style>
  /* Hide standard headers in live room */
  #main-navbar, footer { display: none !important; }
  body { background: black !important; overflow: hidden; }

  .filter-glam { filter: contrast(1.08) brightness(1.12) saturate(1.22) blur(0.25px) !important; }
  .filter-natural { filter: contrast(1.02) brightness(1.04) saturate(1.05) !important; }
  .filter-golden { filter: sepia(0.22) contrast(1.1) brightness(1.08) saturate(1.25) hue-rotate(-8deg) !important; }
  .filter-vibrant { filter: saturate(1.45) contrast(1.15) brightness(1.06) !important; }
  .filter-romance { filter: sepia(0.12) contrast(1.06) brightness(1.12) saturate(1.22) hue-rotate(325deg) !important; }
  .filter-noir { filter: grayscale(1) contrast(1.28) brightness(1.05) !important; }

  /* Floating heart upwards keyframes */
  .flying-heart-particle {
    position: absolute;
    bottom: 0;
    pointer-events: none;
    animation: flyUpAndFade 2.2s cubic-bezier(0.25, 1, 0.5, 1) forwards;
  }
  @keyframes flyUpAndFade {
    0% { opacity: 1; transform: translateY(0) scale(0.6) rotate(0deg); }
    30% { transform: translateY(-80px) scale(1.3) rotate(-10deg); }
    60% { transform: translateY(-180px) scale(1.1) rotate(10deg); opacity: 0.9; }
    100% { opacity: 0; transform: translateY(-300px) scale(0.7) rotate(-5deg); }
  }

  /* Double tap ripple heart */
  .tap-ripple-heart {
    position: absolute;
    pointer-events: none;
    animation: tapPop 0.8s ease-out forwards;
  }
  @keyframes tapPop {
    0% { opacity: 0; transform: translate(-50%, -50%) scale(0.3); }
    50% { opacity: 1; transform: translate(-50%, -50%) scale(1.4); }
    100% { opacity: 0; transform: translate(-50%, -50%) scale(2); }
  }

  /* Big Gift entrance */
  .gift-popup-banner {
    animation: giftCelebrate 2.5s ease-out forwards;
  }
  @keyframes giftCelebrate {
    0% { opacity: 0; transform: scale(0.3) translateY(60px); }
    20% { opacity: 1; transform: scale(1.2) translateY(-10px); }
    30% { transform: scale(1) translateY(0); }
    80% { opacity: 1; transform: scale(1) translateY(0); }
    100% { opacity: 0; transform: scale(0.8) translateY(-40px); }
  }
</style>

<script>
const ROOM_ID = '<%= session._id %>';
const IS_HOST = <%= isHost ? 'true' : 'false' %>;
const CURRENT_USER = {
  id: '<%= user ? user._id : "" %>',
  username: '<%= user ? user.username : "Guest Reader" %>',
  avatar: '<%= user ? (user.avatar || "/uploads/default-avatar.png") : "/uploads/default-avatar.png" %>'
};

// Socket.io Connection
const socket = io();
socket.emit('join-room', {
  roomId: ROOM_ID,
  userId: CURRENT_USER.id,
  username: CURRENT_USER.username,
  avatar: CURRENT_USER.avatar
});

// Viewers count update
socket.on('viewer-count', (data) => {
  const el = document.getElementById('viewerCount');
  if (el) el.textContent = data.count;
});

// Likes count update
socket.on('heart-received', (data) => {
  const el = document.getElementById('likesCount');
  if (el && data.likesCount) el.textContent = data.likesCount;
  spawnStreamHeart();
});

// User joined toast
socket.on('user-joined', (data) => {
  const feed = document.getElementById('liveChatFeed');
  if (!feed) return;
  const msg = document.createElement('div');
  msg.className = 'inline-flex items-center gap-1.5 bg-blue-500/20 backdrop-blur-md px-3 py-1 rounded-2xl border border-blue-500/20';
  msg.innerHTML = '<img src="' + data.avatar + '" class="w-3.5 h-3.5 rounded-full">' +
    '<span class="text-blue-300 text-[11px] font-semibold">' + data.username + ' joined the live</span>';
  feed.appendChild(msg);
  feed.scrollTop = feed.scrollHeight;
  setTimeout(() => msg.remove(), 4000);
});

// Chat message
socket.on('chat-message', (data) => {
  const feed = document.getElementById('liveChatFeed');
  if (!feed) return;
  const msg = document.createElement('div');
  msg.className = 'inline-flex items-start gap-1.5 bg-black/60 backdrop-blur-md px-3 py-1.5 rounded-2xl border border-white/10 max-w-[90%]';
  msg.innerHTML = '<span class="text-amber-400 text-xs font-bold shrink-0">' + data.username + ':</span>' +
    '<span class="text-white text-xs leading-relaxed">' + data.message + '</span>';
  feed.appendChild(msg);
  feed.scrollTop = feed.scrollHeight;
});

// Send Chat Comment
function sendLiveComment(e) {
  e.preventDefault();
  const input = document.getElementById('liveChatInput');
  const text = input.value.trim();
  if (!text) return;
  socket.emit('chat-message', {
    roomId: ROOM_ID,
    username: CURRENT_USER.username,
    avatar: CURRENT_USER.avatar,
    message: text
  });
  input.value = '';
}

// Likes & Hearts System (SVG-based, 100% Emoji-corruption proof)
const HEART_COLORS = [
  '#EF4444', '#EC4899', '#F43F5E', '#D946EF', '#F59E0B', '#FB7185'
];

function triggerLiveLike() {
  socket.emit('send-heart', { roomId: ROOM_ID });
  spawnStreamHeart();
}

function handleDoubleTapLike(e) {
  triggerLiveLike();
  const container = document.getElementById('doubleTapHeartsContainer');
  if (!container) return;
  const ripple = document.createElement('div');
  ripple.className = 'tap-ripple-heart';
  ripple.style.left = e.clientX + 'px';
  ripple.style.top = e.clientY + 'px';
  const color = HEART_COLORS[Math.floor(Math.random() * HEART_COLORS.length)];
  ripple.innerHTML = '<svg width="70" height="70" viewBox="0 0 24 24" fill="' + color + '">' +
    '<path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>' +
  '</svg>';
  container.appendChild(ripple);
  setTimeout(() => ripple.remove(), 800);
}

function spawnStreamHeart() {
  const container = document.getElementById('heartsStreamContainer');
  if (!container) return;
  const heart = document.createElement('div');
  heart.className = 'flying-heart-particle';
  const color = HEART_COLORS[Math.floor(Math.random() * HEART_COLORS.length)];
  const size = 20 + Math.floor(Math.random() * 18);
  heart.style.left = (Math.random() * 40) + 'px';
  heart.innerHTML = '<svg width="' + size + '" height="' + size + '" viewBox="0 0 24 24" fill="' + color + '">' +
    '<path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>' +
  '</svg>';
  container.appendChild(heart);
  setTimeout(() => heart.remove(), 2200);
}

// Gifts System
function toggleGiftTray() {
  document.getElementById('giftTrayModal').classList.toggle('hidden');
}

function sendLiveGift(type, label, emoji, points) {
  if (!CURRENT_USER.id) {
    alert('Please sign in to send gifts!');
    return;
  }
  socket.emit('send-gift', {
    roomId: ROOM_ID,
    userId: CURRENT_USER.id,
    username: CURRENT_USER.username,
    avatar: CURRENT_USER.avatar,
    giftType: type
  });
  document.getElementById('giftTrayModal').classList.add('hidden');
}

socket.on('gift-received', (data) => {
  // Center celebration banner
  const center = document.getElementById('bigGiftCelebration');
  if (center) {
    const banner = document.createElement('div');
    banner.className = 'gift-popup-banner text-center flex flex-col items-center';
    banner.innerHTML = '<div class="text-7xl sm:text-8xl mb-2 drop-shadow-2xl animate-bounce">' + data.emoji + '</div>' +
      '<div class="bg-black/85 backdrop-blur-xl border border-amber-400/50 px-5 py-2.5 rounded-full shadow-2xl">' +
        '<span class="text-amber-400 font-bold text-sm">' + data.username + '</span>' +
        '<span class="text-white text-xs ml-1">sent ' + data.label + '! (+' + data.points + ' pts)</span>' +
      '</div>';
    center.appendChild(banner);
    setTimeout(() => banner.remove(), 2500);
  }

  // Chat message
  const feed = document.getElementById('liveChatFeed');
  if (feed) {
    const msg = document.createElement('div');
    msg.className = 'inline-flex items-center gap-1.5 bg-gradient-to-r from-amber-500/20 to-orange-500/20 backdrop-blur-md px-3 py-1.5 rounded-2xl border border-amber-500/30';
    msg.innerHTML = '<span class="text-amber-400 font-bold text-xs">🎁 ' + data.username + '</span>' +
      '<span class="text-white text-xs">sent ' + data.emoji + ' ' + data.label + ' (+' + data.points + ' pts)</span>';
    feed.appendChild(msg);
    feed.scrollTop = feed.scrollHeight;
  }
});

// Beauty Filters Switcher
function toggleFilterMenu() {
  document.getElementById('filterDropdown').classList.toggle('hidden');
}

function applyFilter(filterName) {
  const video = document.getElementById('liveVideoFeed');
  if (!video) return;
  video.className = video.className.replace(/filter-\w+/g, '').trim();
  video.classList.add('filter-' + filterName);
  document.getElementById('filterDropdown').classList.add('hidden');
}

// Camera Flip / Mirror
let isMirrored = true;
function toggleMirror() {
  const video = document.getElementById('liveVideoFeed');
  if (!video) return;
  isMirrored = !isMirrored;
  if (isMirrored) {
    video.classList.add('-scale-x-100');
  } else {
    video.classList.remove('-scale-x-100');
  }
}

// Teleprompter Toggle
let teleprompterOpen = false;
function toggleTeleprompter() {
  const drawer = document.getElementById('teleprompterDrawer');
  if (!drawer) return;
  teleprompterOpen = !teleprompterOpen;
  drawer.style.transform = teleprompterOpen ? 'translateY(0)' : 'translateY(100%)';
}

// Co-Host Requests
let pendingCoHostUserId = '';
function requestToJoinLive() {
  if (!CURRENT_USER.id) { alert('Please sign in to request join!'); return; }
  socket.emit('co-host-request', {
    roomId: ROOM_ID,
    userId: CURRENT_USER.id,
    username: CURRENT_USER.username,
    avatar: CURRENT_USER.avatar
  });
  const btn = document.getElementById('coHostRequestBtn');
  if (btn) {
    btn.innerHTML = '<i data-lucide="check" class="w-5 h-5 text-green-400"></i>';
    btn.disabled = true;
  }
}

socket.on('co-host-request', (data) => {
  if (!IS_HOST) return;
  pendingCoHostUserId = data.userId;
  const modal = document.getElementById('coHostRequestModal');
  document.getElementById('coHostAvatarImg').src = data.avatar;
  document.getElementById('coHostRequesterName').textContent = data.username;
  modal.classList.remove('hidden');
});

function acceptCoHost() {
  socket.emit('co-host-accept', {
    roomId: ROOM_ID,
    userId: pendingCoHostUserId,
    username: document.getElementById('coHostRequesterName').textContent
  });
  document.getElementById('coHostRequestModal').classList.add('hidden');
}

function rejectCoHost() {
  socket.emit('co-host-reject', { roomId: ROOM_ID, userId: pendingCoHostUserId });
  document.getElementById('coHostRequestModal').classList.add('hidden');
}

function dismissCoHostModal() {
  document.getElementById('coHostRequestModal').classList.add('hidden');
}

// Camera Start (Host)
async function startLiveCamera() {
  try {
    const video = document.getElementById('liveVideoFeed');
    const modal = document.getElementById('cameraStartModal');
    const stream = await navigator.mediaDevices.getUserMedia({
      video: { width: { ideal: 1280 }, height: { ideal: 720 }, facingMode: "user" },
      audio: true
    });
    video.srcObject = stream;
    await video.play();
    if (modal) modal.classList.add('hidden');
  } catch (err) {
    alert('Camera note: Please allow camera permissions in your browser bar.');
  }
}

function followHost() {
  if (CURRENT_USER.id) {
    fetch('/users/<%= session.hostId %>/follow', { method: 'POST' });
  }
}

// Auto attempt camera if host
window.addEventListener('DOMContentLoaded', () => {
  if (typeof lucide !== 'undefined') lucide.createIcons();
  if (IS_HOST) {
    startLiveCamera();
  }
});
</script>

