// ── Co-Host / Multi-Guest Stage Management ──
let pendingCoHostUserId = '';
let coHostRequestTimer = null;
let coHostRequestTimeLeft = 0;

// Viewer sends request
function requestToJoinLive() {
  if (!CURRENT_USER.id) { alert('Please sign in to request join!'); return; }
  
  const btn = document.getElementById('coHostRequestBtn');
  
  // If already requested, this acts as a CANCEL button
  if (btn.classList.contains('is-requested')) {
    cancelCoHostRequest();
    return;
  }
  
  socket.emit('co-host-request', {
    roomId: ROOM_ID,
    userId: CURRENT_USER.id,
    username: CURRENT_USER.username,
    avatar: CURRENT_USER.avatar
  });
  
  btn.classList.add('is-requested');
  btn.classList.add('border-amber-400', 'bg-black/80'); 
  btn.title = "Cancel request";
  
  coHostRequestTimeLeft = 15;
  updateRequestBtnTimer(btn);
  
  coHostRequestTimer = setInterval(() => {
    coHostRequestTimeLeft--;
    if (coHostRequestTimeLeft <= 0) {
      cancelCoHostRequest(true); // auto-expired
    } else {
      updateRequestBtnTimer(btn);
    }
  }, 1000);

  showCameraToast('✋ Join request sent to host!');
}

function updateRequestBtnTimer(btn) {
  btn.innerHTML = `<span class="text-[10px] font-bold text-amber-400">${coHostRequestTimeLeft}s</span>`;
}

function cancelCoHostRequest(isAutoExpired = false) {
  clearInterval(coHostRequestTimer);
  socket.emit('co-host-cancel-request', { roomId: ROOM_ID, userId: CURRENT_USER.id });
  
  const btn = document.getElementById('coHostRequestBtn');
  if (btn) {
    btn.classList.remove('is-requested', 'border-amber-400', 'bg-black/80');
    btn.title = "Request to join live as guest";
    btn.innerHTML = '<i data-lucide="hand" class="w-5 h-5 text-amber-400"></i>';
    if (typeof lucide !== 'undefined') lucide.createIcons();
  }
  
  if (isAutoExpired) {
    showCameraToast('⏳ Join request expired. You can try again.');
  } else {
    showCameraToast('Join request cancelled.');
  }
}

// Host receives request
socket.on('co-host-request', (data) => {
  if (!IS_HOST) return;
  pendingCoHostUserId = data.userId;
  const modal = document.getElementById('coHostRequestModal');
  document.getElementById('coHostAvatarImg').src = data.avatar;
  document.getElementById('coHostRequesterName').textContent = data.username;
  modal.classList.remove('hidden');
});

// Host receives request cancellation
socket.on('co-host-request-cancelled', (data) => {
  if (!IS_HOST) return;
  if (pendingCoHostUserId === data.userId) {
    document.getElementById('coHostRequestModal').classList.add('hidden');
    pendingCoHostUserId = '';
    showCameraToast('Guest join request cancelled.');
  }
});

// Host accepts request
function acceptCoHost() {
  socket.emit('co-host-accept', {
    roomId: ROOM_ID,
    userId: pendingCoHostUserId,
    username: document.getElementById('coHostRequesterName').textContent
  });
