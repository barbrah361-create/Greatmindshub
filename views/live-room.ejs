<%- include('partials/header') %>
<%- include('partials/navbar') %>

<!-- Socket.io Client -->
<script src="/socket.io/socket.io.js"></script>

<!-- TikTok Live Room — Full Immersive Dark Layout -->
<div id="live-room-wrapper" class="bg-black min-h-screen relative overflow-hidden">

  <!-- --- TOP BAR (Host Info + Viewers + Close) --- -->
  <div class="absolute top-0 left-0 right-0 z-40 flex items-center justify-between px-4 py-3">
    <!-- Host badge -->
    <div class="flex items-center gap-2.5 bg-black/60 backdrop-blur-lg px-3 py-1.5 rounded-full border border-white/10">
      <img src="<%= session.hostAvatar || '/uploads/default-avatar.png' %>" class="w-9 h-9 rounded-full object-cover ring-2 ring-red-500" alt="">
      <div class="leading-tight">
        <span class="text-white text-xs font-bold flex items-center gap-1"><%= session.hostName %> <span class="bg-red-600 text-[8px] px-1.5 py-0.5 rounded font-black uppercase">HOST</span></span>
        <span class="text-gray-400 text-[10px]"><%= session.workTitle %></span>
      </div>
      <% if (user && String(user._id) !== String(session.hostId)) { %>
        <button onclick="followHost()" class="ml-1 px-2.5 py-1 bg-red-600 hover:bg-red-700 text-white text-[10px] font-bold rounded-full transition-colors">Follow</button>
      <% } %>
    </div>

    <!-- Right side: viewers + close -->
    <div class="flex items-center gap-2">
      <div class="flex items-center gap-1.5 bg-black/60 backdrop-blur px-3 py-1.5 rounded-full border border-white/10">
        <i data-lucide="eye" class="w-3.5 h-3.5 text-red-400"></i>
        <span id="viewerCount" class="text-white text-xs font-bold"><%= session.viewersCount %></span>
      </div>
      <a href="/live" class="w-8 h-8 rounded-full bg-white/10 backdrop-blur flex items-center justify-center text-white hover:bg-white/20 transition-colors">
        <i data-lucide="x" class="w-4 h-4"></i>
      </a>
    </div>
  </div>

  <!-- --- TOP GIFTERS BAR --- -->
  <div class="absolute top-16 left-4 z-30 flex items-center gap-1.5">
    <% topGifters.slice(0, 3).forEach(function(g, i) { %>
      <div class="flex items-center gap-1 bg-gradient-to-r <%= i === 0 ? 'from-amber-500/30 to-amber-600/20 border-amber-500/30' : 'from-white/5 to-white/10 border-white/10' %> backdrop-blur px-2 py-1 rounded-full border text-[10px]">
        <span class="<%= i === 0 ? 'text-amber-400' : 'text-gray-400' %> font-bold"><%= i === 0 ? '??' : i === 1 ? '??' : '??' %></span>
        <span class="text-white font-semibold truncate max-w-[60px]"><%= g.username %></span>
        <span class="text-amber-400 font-bold"><%= g.totalPoints %></span>
      </div>
    <% }) %>
  </div>

  <!-- --- VIDEO FEED (Full Screen Background) --- -->
  <div class="absolute inset-0 z-0">
    <video id="liveVideoFeed" class="w-full h-full object-cover transform -scale-x-100" autoplay playsinline muted></video>
    <!-- Gradient overlay for readability -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-black/40"></div>
  </div>

  <!-- Camera start overlay -->
  <% if (isHost) { %>
  <div id="cameraOverlay" class="absolute inset-0 z-50 bg-black/90 backdrop-blur flex flex-col items-center justify-center text-center space-y-4">
    <div class="w-20 h-20 rounded-full bg-red-600/20 text-red-500 flex items-center justify-center animate-pulse ring-4 ring-red-500/30">
      <i data-lucide="video" class="w-10 h-10"></i>
    </div>
    <h3 class="font-serif text-2xl font-bold text-white">Start Broadcasting</h3>
    <p class="text-xs text-gray-400 max-w-xs">Enable your camera to go live. Your followers have been notified!</p>
    <button onclick="startCamera()" class="px-6 py-3 bg-red-600 hover:bg-red-700 text-white font-bold rounded-2xl text-sm flex items-center gap-2 shadow-lg">
      <i data-lucide="camera" class="w-4 h-4"></i> Go Live Now
    </button>
  </div>
  <% } %>

  <!-- --- FLOATING HEARTS CONTAINER --- -->
  <div id="heartsContainer" class="absolute right-4 bottom-48 w-16 h-64 pointer-events-none z-30 overflow-hidden"></div>

  <!-- --- GIFT ANIMATION OVERLAY --- -->
  <div id="giftOverlay" class="absolute inset-0 pointer-events-none z-40 flex items-center justify-center"></div>

  <!-- --- CO-HOST REQUEST POPUP (Host Only) --- -->
  <% if (isHost) { %>
  <div id="coHostPopup" class="hidden absolute top-24 right-4 z-50 bg-black/90 backdrop-blur-lg border border-white/20 rounded-2xl p-4 w-72 space-y-3 shadow-2xl">
    <h4 class="text-white text-sm font-bold flex items-center gap-2"><i data-lucide="hand-metal" class="w-4 h-4 text-amber-400"></i> Join Request</h4>
    <div id="coHostRequestInfo" class="flex items-center gap-3">
      <img id="coHostAvatar" src="" class="w-10 h-10 rounded-full object-cover ring-2 ring-amber-500" alt="">
      <span id="coHostName" class="text-white text-sm font-semibold"></span>
    </div>
    <div class="flex gap-2">
      <button onclick="acceptCoHost()" class="flex-1 py-2 bg-green-600 hover:bg-green-700 text-white text-xs font-bold rounded-xl transition-colors">Accept</button>
      <button onclick="rejectCoHost()" class="flex-1 py-2 bg-red-600 hover:bg-red-700 text-white text-xs font-bold rounded-xl transition-colors">Decline</button>
    </div>
  </div>
  <% } %>

  <!-- --- BOTTOM SECTION: Chat + Actions --- -->
  <div class="absolute bottom-0 left-0 right-0 z-30 p-4 space-y-3">

    <!-- Live Chat Feed (TikTok floating style) -->
    <div id="chatFeed" class="space-y-1.5 max-h-52 overflow-y-auto scrollbar-hide">
      <div class="inline-block bg-white/10 backdrop-blur px-3 py-1.5 rounded-2xl">
        <span class="text-gray-400 text-[11px]">Welcome to <%= session.hostName %>'s live stage! Be respectful ??</span>
      </div>
    </div>

    <!-- Bottom Action Bar -->
    <div class="flex items-center gap-2">
      <!-- Chat input -->
      <form onsubmit="sendChat(event)" class="flex-1 relative">
        <input type="text" id="chatInput" placeholder="Say something nice..." class="w-full pl-4 pr-10 py-2.5 bg-white/10 backdrop-blur border border-white/10 rounded-full text-white text-xs placeholder-gray-400 focus:outline-none focus:border-white/30" autocomplete="off">
        <button type="submit" class="absolute right-2 top-1/2 -translate-y-1/2 text-white">
          <i data-lucide="send" class="w-4 h-4"></i>
        </button>
      </form>

      <!-- Gift Button -->
      <button onclick="toggleGiftPanel()" id="giftToggleBtn" class="w-10 h-10 rounded-full bg-gradient-to-r from-amber-500 to-orange-500 text-white flex items-center justify-center shadow-lg hover:scale-110 transition-transform">
        <i data-lucide="gift" class="w-5 h-5"></i>
      </button>

      <!-- Heart Button -->
      <button onclick="tapHeart()" class="w-10 h-10 rounded-full bg-gradient-to-tr from-red-600 to-pink-500 text-white flex items-center justify-center shadow-lg hover:scale-110 transition-transform active:scale-125">
        <i data-lucide="heart" class="w-5 h-5 fill-white"></i>
      </button>

      <!-- Request to Join (Non-host) -->
      <% if (user && String(user._id) !== String(session.hostId)) { %>
      <button onclick="requestCoHost()" id="joinRequestBtn" class="w-10 h-10 rounded-full bg-white/10 backdrop-blur border border-white/20 text-white flex items-center justify-center hover:bg-white/20 transition-colors" title="Request to join live">
        <i data-lucide="hand-metal" class="w-5 h-5"></i>
      </button>
      <% } %>
    </div>

    <!-- Gift Panel (Hidden by default) -->
    <div id="giftPanel" class="hidden bg-black/90 backdrop-blur-lg border border-white/10 rounded-2xl p-4">
      <div class="flex items-center justify-between mb-3">
        <span class="text-white text-xs font-bold">Send a Gift</span>
        <button onclick="toggleGiftPanel()" class="text-gray-400 hover:text-white"><i data-lucide="x" class="w-4 h-4"></i></button>
      </div>
      <div class="grid grid-cols-3 sm:grid-cols-6 gap-2">
        <button onclick="sendGift('rose')" class="flex flex-col items-center gap-1 p-3 rounded-xl bg-white/5 hover:bg-white/10 border border-white/5 transition-colors group">
          <span class="text-2xl group-hover:scale-125 transition-transform">??</span>
          <span class="text-[10px] text-gray-400 font-semibold">Rose</span>
          <span class="text-[9px] text-amber-400 font-bold">5 pts</span>
        </button>
        <button onclick="sendGift('book')" class="flex flex-col items-center gap-1 p-3 rounded-xl bg-white/5 hover:bg-white/10 border border-white/5 transition-colors group">
          <span class="text-2xl group-hover:scale-125 transition-transform">??</span>
          <span class="text-[10px] text-gray-400 font-semibold">Book</span>
          <span class="text-[9px] text-amber-400 font-bold">15 pts</span>
        </button>
        <button onclick="sendGift('diamond')" class="flex flex-col items-center gap-1 p-3 rounded-xl bg-white/5 hover:bg-white/10 border border-white/5 transition-colors group">
          <span class="text-2xl group-hover:scale-125 transition-transform">??</span>
          <span class="text-[10px] text-gray-400 font-semibold">Diamond</span>
          <span class="text-[9px] text-amber-400 font-bold">50 pts</span>
        </button>
        <button onclick="sendGift('crown')" class="flex flex-col items-center gap-1 p-3 rounded-xl bg-white/5 hover:bg-white/10 border border-white/5 transition-colors group">
          <span class="text-2xl group-hover:scale-125 transition-transform">??</span>
          <span class="text-[10px] text-gray-400 font-semibold">Crown</span>
          <span class="text-[9px] text-amber-400 font-bold">100 pts</span>
        </button>
        <button onclick="sendGift('africa_star')" class="flex flex-col items-center gap-1 p-3 rounded-xl bg-white/5 hover:bg-white/10 border border-white/5 transition-colors group">
          <span class="text-2xl group-hover:scale-125 transition-transform">?</span>
          <span class="text-[10px] text-gray-400 font-semibold">Africa Star</span>
          <span class="text-[9px] text-amber-400 font-bold">200 pts</span>
        </button>
        <button onclick="sendGift('universe')" class="flex flex-col items-center gap-1 p-3 rounded-xl bg-white/5 hover:bg-white/10 border border-white/5 transition-colors group">
          <span class="text-2xl group-hover:scale-125 transition-transform">??</span>
          <span class="text-[10px] text-gray-400 font-semibold">Universe</span>
          <span class="text-[9px] text-amber-400 font-bold">500 pts</span>
        </button>
      </div>
    </div>
  </div>

  <!-- --- TELEPROMPTER PANEL (Slide-up) --- -->
  <div id="teleprompterPanel" class="absolute bottom-0 left-0 right-0 z-20 transform translate-y-full transition-transform duration-500">
    <div class="bg-black/95 backdrop-blur-lg border-t border-white/10 rounded-t-3xl p-6 max-h-[60vh] overflow-y-auto">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-white font-serif text-lg font-bold"><%= session.workTitle %></h3>
        <button onclick="toggleTeleprompter()" class="text-gray-400 hover:text-white"><i data-lucide="chevron-down" class="w-5 h-5"></i></button>
      </div>
      <div class="text-gray-300 text-sm leading-relaxed font-serif italic space-y-3">
        <% if (session.workContent) { %>
          <% session.workContent.split('\n\n').forEach(function(p) { %>
            <p><%= p %></p>
          <% }) %>
        <% } else { %>
          <p class="text-gray-500">No text provided. Listen live!</p>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Teleprompter toggle button -->
  <button onclick="toggleTeleprompter()" class="absolute bottom-20 left-4 z-30 px-3 py-1.5 bg-white/10 backdrop-blur border border-white/10 rounded-full text-white text-[10px] font-bold flex items-center gap-1.5 hover:bg-white/20 transition-colors">
    <i data-lucide="book-open" class="w-3.5 h-3.5"></i> Read Along
  </button>

  <!-- End Stream button (Host only) -->
  <% if (isHost) { %>
  <form action="/live/<%= session._id %>/end" method="POST" class="absolute top-16 right-4 z-40" onsubmit="return confirm('End your live stream?');">
    <button type="submit" class="px-4 py-2 bg-red-600/80 hover:bg-red-700 backdrop-blur text-white text-xs font-bold rounded-full border border-red-500/30 flex items-center gap-1.5 transition-colors">
      <i data-lucide="square" class="w-3 h-3 fill-white"></i> End Live
    </button>
  </form>
  <% } %>

</div>

<style>
  /* Hide navbar & footer in live room for full immersion */
  #main-navbar, footer { display: none !important; }
  body { background: black !important; overflow: hidden; }

  /* Floating heart animation */
  .floating-heart {
    position: absolute;
    bottom: 0;
    animation: floatUp 2.5s ease-out forwards;
    pointer-events: none;
  }
  @keyframes floatUp {
    0% { opacity: 1; transform: translateY(0) scale(1); }
    50% { opacity: 0.8; transform: translateY(-120px) scale(1.3) translateX(10px); }
    100% { opacity: 0; transform: translateY(-250px) scale(0.8) translateX(-5px); }
  }

  /* Gift entrance animation */
  .gift-entrance {
    animation: giftBounce 2s ease-out forwards;
  }
  @keyframes giftBounce {
    0% { opacity: 0; transform: scale(0.3) translateY(50px); }
    30% { opacity: 1; transform: scale(1.5) translateY(-20px); }
    50% { transform: scale(1.2) translateY(0); }
    70% { transform: scale(1.3) translateY(-10px); }
    100% { opacity: 0; transform: scale(1) translateY(-40px); }
  }

  /* Join notification */
  .join-toast {
    animation: slideIn 0.4s ease-out, fadeOut 0.5s ease-in 2.5s forwards;
  }
  @keyframes slideIn { from { opacity: 0; transform: translateX(-30px); } to { opacity: 1; transform: translateX(0); } }
  @keyframes fadeOut { to { opacity: 0; } }
</style>

<script>
const ROOM_ID = '<%= session._id %>';
const IS_HOST = <%= isHost ? 'true' : 'false' %>;
const CURRENT_USER = {
  id: '<%= user ? user._id : "" %>',
  username: '<%= user ? user.username : "Guest" %>',
  avatar: '<%= user ? (user.avatar || "/uploads/default-avatar.png") : "/uploads/default-avatar.png" %>'
};

// -- Socket.io Connection --
const socket = io();
socket.emit('join-room', { roomId: ROOM_ID, userId: CURRENT_USER.id, username: CURRENT_USER.username, avatar: CURRENT_USER.avatar });

// Viewer count updates
socket.on('viewer-count', (data) => {
  document.getElementById('viewerCount').textContent = data.count;
});

// User joined notification
socket.on('user-joined', (data) => {
  const feed = document.getElementById('chatFeed');
  const div = document.createElement('div');
  div.className = 'join-toast inline-flex items-center gap-1.5 bg-blue-500/20 backdrop-blur px-3 py-1.5 rounded-2xl';
  div.innerHTML = '<img src="' + data.avatar + '" class="w-4 h-4 rounded-full">' +
    '<span class="text-blue-300 text-[11px] font-semibold">' + data.username + ' joined the live</span>';
  feed.appendChild(div);
  feed.scrollTop = feed.scrollHeight;
  setTimeout(() => div.remove(), 3000);
});

// -- Chat --
socket.on('chat-message', (data) => {
  const feed = document.getElementById('chatFeed');
  const div = document.createElement('div');
  div.className = 'inline-flex items-start gap-1.5 bg-white/10 backdrop-blur px-3 py-1.5 rounded-2xl max-w-[85%]';
  div.innerHTML = '<span class="text-amber-400 text-[11px] font-bold shrink-0">' + data.username + '</span>' +
    '<span class="text-white text-[11px]">' + data.message + '</span>';
  feed.appendChild(div);
  feed.scrollTop = feed.scrollHeight;
});

function sendChat(e) {
  e.preventDefault();
  const input = document.getElementById('chatInput');
  const msg = input.value.trim();
  if (!msg) return;
  socket.emit('chat-message', { roomId: ROOM_ID, username: CURRENT_USER.username, avatar: CURRENT_USER.avatar, message: msg });
  input.value = '';
}

// -- Hearts --
socket.on('heart-received', (data) => {
  spawnFloatingHeart();
});

function tapHeart() {
  socket.emit('send-heart', { roomId: ROOM_ID });
  spawnFloatingHeart();
}

function spawnFloatingHeart() {
  const container = document.getElementById('heartsContainer');
  const heart = document.createElement('div');
  heart.className = 'floating-heart';
  const emojis = ['??', '??', '??', '??', '??'];
  heart.textContent = emojis[Math.floor(Math.random() * emojis.length)];
  heart.style.left = Math.random() * 40 + 'px';
  heart.style.fontSize = (18 + Math.random() * 16) + 'px';
  container.appendChild(heart);
  setTimeout(() => heart.remove(), 2600);
}

// -- Gifts --
function toggleGiftPanel() {
  document.getElementById('giftPanel').classList.toggle('hidden');
}

function sendGift(giftType) {
  if (!CURRENT_USER.id) { alert('Please sign in to send gifts!'); return; }
  socket.emit('send-gift', { roomId: ROOM_ID, userId: CURRENT_USER.id, username: CURRENT_USER.username, avatar: CURRENT_USER.avatar, giftType });
  document.getElementById('giftPanel').classList.add('hidden');
}

socket.on('gift-received', (data) => {
  // Big gift animation in center
  const overlay = document.getElementById('giftOverlay');
  const div = document.createElement('div');
  div.className = 'gift-entrance text-center';
  div.innerHTML = '<div class="text-7xl mb-2">' + data.emoji + '</div>' +
    '<div class="text-white text-sm font-bold bg-black/60 backdrop-blur px-4 py-2 rounded-full">' +
    data.username + ' sent ' + data.label + '!</div>';
  overlay.appendChild(div);
  setTimeout(() => div.remove(), 2500);

  // Chat announcement
  const feed = document.getElementById('chatFeed');
  const msg = document.createElement('div');
  msg.className = 'inline-flex items-center gap-1.5 bg-gradient-to-r from-amber-500/20 to-orange-500/20 backdrop-blur px-3 py-1.5 rounded-2xl border border-amber-500/20';
  msg.innerHTML = '<span class="text-amber-400 text-[11px] font-bold">?? ' + data.username + '</span>' +
    '<span class="text-white text-[11px]">sent ' + data.emoji + ' ' + data.label + ' (+' + data.points + ' pts)</span>';
  feed.appendChild(msg);
  feed.scrollTop = feed.scrollHeight;
});

// -- Co-Host Requests --
let pendingCoHostUserId = '';

function requestCoHost() {
  if (!CURRENT_USER.id) { alert('Please sign in!'); return; }
  socket.emit('co-host-request', { roomId: ROOM_ID, userId: CURRENT_USER.id, username: CURRENT_USER.username, avatar: CURRENT_USER.avatar });
  const btn = document.getElementById('joinRequestBtn');
  if (btn) { btn.innerHTML = '<i data-lucide="check" class="w-5 h-5"></i>'; btn.disabled = true; btn.classList.add('opacity-50'); }
  if (typeof lucide !== 'undefined') lucide.createIcons();
}

socket.on('co-host-request', (data) => {
  if (!IS_HOST) return;
  pendingCoHostUserId = data.userId;
  const popup = document.getElementById('coHostPopup');
  document.getElementById('coHostAvatar').src = data.avatar;
  document.getElementById('coHostName').textContent = data.username + ' wants to join your live!';
  popup.classList.remove('hidden');
});

function acceptCoHost() {
  socket.emit('co-host-accept', { roomId: ROOM_ID, userId: pendingCoHostUserId, username: document.getElementById('coHostName').textContent.split(' wants')[0] });
  document.getElementById('coHostPopup').classList.add('hidden');
}

function rejectCoHost() {
  socket.emit('co-host-reject', { roomId: ROOM_ID, userId: pendingCoHostUserId });
  document.getElementById('coHostPopup').classList.add('hidden');
}

socket.on('co-host-accepted', (data) => {
  const feed = document.getElementById('chatFeed');
  const div = document.createElement('div');
  div.className = 'inline-flex items-center gap-1.5 bg-green-500/20 backdrop-blur px-3 py-1.5 rounded-2xl';
  div.innerHTML = '<span class="text-green-400 text-[11px] font-bold">? ' + data.username + ' is now a co-host!</span>';
  feed.appendChild(div);
  feed.scrollTop = feed.scrollHeight;
});

socket.on('co-host-rejected', (data) => {
  if (data.userId === CURRENT_USER.id) {
    const feed = document.getElementById('chatFeed');
    const div = document.createElement('div');
    div.className = 'inline-block bg-red-500/20 backdrop-blur px-3 py-1.5 rounded-2xl';
    div.innerHTML = '<span class="text-red-400 text-[11px]">Your join request was declined.</span>';
    feed.appendChild(div);
    feed.scrollTop = feed.scrollHeight;
  }
});

// -- Stream ended --
socket.on('stream-ended', () => {
  const wrapper = document.getElementById('live-room-wrapper');
  wrapper.innerHTML = '<div class="flex flex-col items-center justify-center min-h-screen text-center px-4 space-y-4">' +
    '<div class="w-20 h-20 rounded-full bg-white/5 text-gray-500 flex items-center justify-center"><i data-lucide="video-off" class="w-10 h-10"></i></div>' +
    '<h2 class="font-serif text-2xl font-bold text-white">Live stream has ended</h2>' +
    '<p class="text-gray-400 text-sm">Thanks for watching!</p>' +
    '<a href="/live" class="px-6 py-3 bg-red-600 hover:bg-red-700 text-white font-bold rounded-xl text-sm">Browse Live Rooms</a></div>';
  if (typeof lucide !== 'undefined') lucide.createIcons();
});

// -- Camera (Host only) --
async function startCamera() {
  try {
    const video = document.getElementById('liveVideoFeed');
    const stream = await navigator.mediaDevices.getUserMedia({ video: { width: { ideal: 1280 }, height: { ideal: 720 }, facingMode: "user" }, audio: true });
    video.srcObject = stream;
    await video.play();
    document.getElementById('cameraOverlay').classList.add('hidden');
  } catch(e) { alert('Please allow camera access in your browser.'); }
}

// -- Teleprompter --
let teleprompterOpen = false;
function toggleTeleprompter() {
  const panel = document.getElementById('teleprompterPanel');
  teleprompterOpen = !teleprompterOpen;
  panel.style.transform = teleprompterOpen ? 'translateY(0)' : 'translateY(100%)';
}

function followHost() { if (CURRENT_USER.id) fetch('/users/<%= session.hostId %>/follow', { method: 'POST' }); }

// Init Lucide icons
window.addEventListener('DOMContentLoaded', () => { if (typeof lucide !== 'undefined') lucide.createIcons(); });
</script>
