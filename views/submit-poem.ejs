<%- include('partials/header') %>
<%- include('partials/navbar') %>
<%- include('partials/flash') %>

<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 flex-grow">
  <!-- Header -->
  <div class="text-center mb-12">
    <span class="text-brand-brown dark:text-brand-pink text-xs font-bold uppercase tracking-widest">Publish Your Masterpiece</span>
    <h1 class="font-serif text-4xl font-bold mt-3 text-gray-800 dark:text-white">Submit a New Poem</h1>
    <p class="text-gray-500 dark:text-gray-400 max-w-xl mx-auto mt-3 text-sm leading-relaxed">
      Share your stanzas, verses, and lyric compositions with our growing global reading audience.
    </p>
  </div>

  <!-- Form Container -->
  <div class="book-card p-6 sm:p-10 border border-brand-brown/10 dark:border-brand-brown/20 bg-white dark:bg-[#1E150F] shadow-md rounded-2xl relative overflow-hidden">
    <div class="absolute top-0 left-0 right-0 h-1 bg-brand-brown"></div>

    <form action="/poems/submit" method="POST" class="space-y-6">
      
      <!-- Title -->
      <div>
        <label for="poem-title" class="block text-xs uppercase tracking-wider font-bold text-gray-500 dark:text-gray-300 mb-2">Poem Title</label>
        <input type="text" id="poem-title" name="title" required placeholder="e.g. Echoes of the Morning Wind" class="w-full rounded-xl border border-brand-brown/20 dark:border-brand-brown/30 bg-brand-cream/10 dark:bg-brand-dark/20 px-4 py-3 text-sm focus:ring-2 focus:ring-brand-brown dark:focus:ring-brand-pink focus:outline-none dark:text-white leading-relaxed">
      </div>

      <!-- Genre & Tags Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Genre Selector -->
        <div>
          <label for="poem-genre" class="block text-xs uppercase tracking-wider font-bold text-gray-500 dark:text-gray-300 mb-2">Poetry Sub-Genre</label>
          <select id="poem-genre" name="genre" class="w-full rounded-xl border border-brand-brown/20 dark:border-brand-brown/30 bg-brand-cream/10 dark:bg-brand-dark/20 px-4 py-3 text-sm focus:ring-2 focus:ring-brand-brown dark:focus:ring-brand-pink focus:outline-none dark:text-white">
            <option value="Classic Verse">Classic Verse</option>
            <option value="Haiku / Tanka">Haiku / Tanka</option>
            <option value="Free Verse" selected>Free Verse</option>
            <option value="Sonnets">Sonnets</option>
            <option value="Ballads">Ballads</option>
            <option value="Epic Poetry">Epic Poetry</option>
            <option value="Odes & Elegies">Odes & Elegies</option>
            <option value="Spoken Word / Rap">Spoken Word / Rap</option>
          </select>
        </div>

        <!-- Tags -->
        <div>
          <label for="poem-tags" class="block text-xs uppercase tracking-wider font-bold text-gray-500 dark:text-gray-300 mb-2">Tags (Comma-separated)</label>
          <input type="text" id="poem-tags" name="tags" placeholder="e.g. love, nature, melancholy, hope" class="w-full rounded-xl border border-brand-brown/20 dark:border-brand-brown/30 bg-brand-cream/10 dark:bg-brand-dark/20 px-4 py-3 text-sm focus:ring-2 focus:ring-brand-brown dark:focus:ring-brand-pink focus:outline-none dark:text-white leading-relaxed">
        </div>
      </div>

      <!-- Poem Body Content -->
      <div>
        <label for="poem-content" class="block text-xs uppercase tracking-wider font-bold text-gray-500 dark:text-gray-300 mb-2">Your Poem (Full Content)</label>
        <textarea id="poem-content" name="content" rows="12" required placeholder="Write your verse here... use spacing and line breaks to set the rhythm of your poem." class="w-full font-serif text-base sm:text-lg rounded-xl border border-brand-brown/20 dark:border-brand-brown/30 bg-brand-cream/10 dark:bg-brand-dark/20 p-5 focus:ring-2 focus:ring-brand-brown dark:focus:ring-brand-pink focus:outline-none dark:text-white leading-loose italic"></textarea>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-end gap-3 pt-4 border-t border-brand-brown/10 dark:border-brand-brown/15">
        <a href="/poems" class="w-full sm:w-auto text-center px-6 py-3 border border-brand-brown/15 text-gray-700 dark:text-gray-300 font-semibold rounded-xl text-xs hover:bg-brand-cream/20 transition-colors">
          Cancel Submission
        </a>
        <button type="submit" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3 bg-brand-brown hover:bg-brand-accent text-white font-bold rounded-xl text-xs shadow-md transition-all">
          <i data-lucide="send" class="w-4 h-4"></i>
          Publish Poem
        </button>
      </div>

    </form>
  </div>
</div>

<%- include('partials/footer') %>
