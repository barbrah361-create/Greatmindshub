<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10">
  
  <!-- Inbox Container -->
  <div class="bg-white dark:bg-[#1E150F] rounded-3xl border border-brand-brown/15 dark:border-brand-brown/25 shadow-xl overflow-hidden min-h-[680px] flex flex-col md:flex-row">
    
    <!-- ====================================================
         LEFT SIDEBAR: Conversations, Requests & Settings
         ==================================================== -->
    <div class="w-full md:w-80 lg:w-96 border-b md:border-b-0 md:border-r border-brand-brown/10 dark:border-brand-brown/20 flex flex-col shrink-0 bg-brand-cream/20 dark:bg-brand-dark/20">
      
      <!-- Top Title & Settings Menu -->
      <div class="p-4 border-b border-brand-brown/10 dark:border-brand-brown/20 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-full bg-brand-brown/10 text-brand-brown dark:text-brand-pink flex items-center justify-center">
            <i data-lucide="message-square" class="w-4 h-4"></i>
          </div>
          <h2 class="font-serif text-lg font-bold text-gray-900 dark:text-white">Direct Messages</h2>
        </div>

        <button onclick="togglePrivacyModal()" title="DM Privacy & Blocked Users" class="p-2 rounded-xl text-gray-500 hover:text-brand-brown dark:hover:text-brand-pink hover:bg-brand-cream/40 transition-colors">
          <i data-lucide="settings" class="w-4 h-4"></i>
        </button>
      </div>

      <!-- Navigation Tabs: Primary vs Message Requests -->
      <div class="px-4 pt-3 flex gap-2 border-b border-brand-brown/10 dark:border-brand-brown/20">
        <a href="/messages?tab=primary" class="pb-2.5 px-2 text-xs font-bold transition-all border-b-2 flex items-center gap-1.5 <%= tab === 'primary' ? 'border-brand-brown text-brand-brown dark:text-brand-pink' : 'border-transparent text-gray-500 hover:text-gray-700' %>">
          <span>Primary</span>
          <span class="text-[10px] px-1.5 py-0.2 rounded-full bg-brand-brown/10"><%= primaryConversations.length %></span>
        </a>
        <a href="/messages?tab=requests" class="pb-2.5 px-2 text-xs font-bold transition-all border-b-2 flex items-center gap-1.5 <%= tab === 'requests' ? 'border-brand-brown text-brand-brown dark:text-brand-pink' : 'border-transparent text-gray-500 hover:text-gray-700' %>">
          <span>Requests</span>
          <% if (requestCount > 0) { %>
            <span class="text-[10px] px-1.5 py-0.2 rounded-full bg-red-600 text-white font-black animate-pulse"><%= requestCount %></span>
          <% } else { %>
            <span class="text-[10px] px-1.5 py-0.2 rounded-full bg-gray-200 dark:bg-gray-800">0</span>
          <% } %>
        </a>
      </div>

      <!-- Conversation List -->
      <div class="flex-1 overflow-y-auto divide-y divide-brand-brown/5 dark:divide-brand-brown/10 scrollbar-thin">
        
        <% const list = tab === 'requests' ? requestConversations : primaryConversations; %>

        <% if (list && list.length > 0) { %>
          <% list.forEach(function(conv) { %>
            <% const isActive = activeOtherUser && String(activeOtherUser._id) === String(conv.otherUser._id); %>
            <a href="/messages/<%= conv.otherUser._id %>" class="flex items-center gap-3 p-3.5 hover:bg-brand-cream/50 dark:hover:bg-brand-brown/15 transition-all <%= isActive ? 'bg-brand-pink/30 dark:bg-brand-brown/25 border-l-4 border-brand-brown' : '' %>">
              <div class="relative shrink-0">
                <img src="<%= conv.otherUser.avatar || '/uploads/default-avatar.png' %>" class="w-11 h-11 rounded-full object-cover ring-1 ring-brand-brown/20" alt="<%= conv.otherUser.username %>">
                <% if (conv.unreadCount > 0) { %>
                  <span class="absolute -top-1 -right-1 w-4 h-4 rounded-full bg-red-600 text-white text-[9px] font-black flex items-center justify-center border-2 border-white dark:border-[#1E150F]">
                    <%= conv.unreadCount %>
                  </span>
                <% } %>
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-bold text-gray-900 dark:text-white truncate flex items-center gap-1">
                    <%= conv.otherUser.username %>
                    <% if (conv.otherUser.verified) { %>
                      <i data-lucide="check-circle" class="w-3 h-3 text-blue-500 fill-blue-500"></i>
                    <% } %>
                  </span>
                  <span class="text-[10px] text-gray-400 shrink-0 font-mono">
                    <%= new Date(conv.lastMessageAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
                  </span>
                </div>
                <p class="text-[11px] text-gray-500 dark:text-gray-400 truncate mt-0.5 <%= conv.unreadCount > 0 ? 'font-bold text-gray-900 dark:text-white' : '' %>">
                  <%= conv.lastMessage %>
                </p>
              </div>
            </a>
          <% }) %>
        <% } else { %>
          <div class="text-center py-16 px-4 space-y-2">
            <div class="w-12 h-12 rounded-full bg-brand-brown/10 text-brand-brown dark:text-brand-pink flex items-center justify-center mx-auto">
              <i data-lucide="<%= tab === 'requests' ? 'inbox' : 'message-circle' %>" class="w-6 h-6"></i>
            </div>
            <p class="text-xs font-bold text-gray-700 dark:text-gray-300">
              <%= tab === 'requests' ? 'No message requests' : 'No direct conversations yet' %>
            </p>
            <p class="text-[11px] text-gray-400 max-w-xs mx-auto">
              <%= tab === 'requests' ? 'When new creators reach out, their requests will appear here for your review.' : 'Connect with poets, authors, and readers by visiting their profile and clicking Message.' %>
            </p>
          </div>
        <% } %>

      </div>

    </div>

    <!-- ====================================================
         RIGHT CHAT PANE: Active Conversation & Messaging
         ==================================================== -->
    <div class="flex-1 flex flex-col bg-white dark:bg-[#1E150F] min-w-0">
      
      <% if (activeOtherUser) { %>
        
        <!-- Header -->
        <div class="p-3.5 sm:p-4 border-b border-brand-brown/10 dark:border-brand-brown/20 flex items-center justify-between gap-3 bg-brand-cream/10 dark:bg-brand-dark/10">
          <div class="flex items-center gap-3 truncate">
            <a href="/messages" class="md:hidden p-1.5 rounded-lg text-gray-500 hover:bg-brand-cream/40"><i data-lucide="chevron-left" class="w-5 h-5"></i></a>
            <img src="<%= activeOtherUser.avatar %>" class="w-10 h-10 rounded-full object-cover ring-2 ring-brand-brown/20 shrink-0" alt="">
            <div class="truncate">
              <a href="/authors/<%= activeOtherUser._id %>" class="text-sm font-bold text-gray-900 dark:text-white hover:text-brand-brown hover:underline truncate flex items-center gap-1">
                <%= activeOtherUser.username %>
                <% if (activeOtherUser.verified) { %>
                  <i data-lucide="check-circle" class="w-3.5 h-3.5 text-blue-500 fill-blue-500"></i>
                <% } %>
              </a>
              <p class="text-[10px] text-gray-400 truncate"><%= activeOtherUser.bio || 'Readers Africa Creator' %></p>
            </div>
          </div>

          <!-- Actions Dropdown: Block, View Profile -->
          <div class="flex items-center gap-2 shrink-0">
            <a href="/authors/<%= activeOtherUser._id %>" class="px-3 py-1.5 rounded-xl border border-brand-brown/20 text-xs font-semibold text-gray-700 dark:text-gray-300 hover:bg-brand-cream/40 transition-colors hidden sm:inline-block">
              View Profile
            </a>

            <div class="relative">
              <button onclick="toggleUserActionDropdown()" class="p-2 rounded-xl text-gray-500 hover:text-brand-brown dark:hover:text-brand-pink hover:bg-brand-cream/40">
                <i data-lucide="more-vertical" class="w-4 h-4"></i>
              </button>
              <div id="userActionMenu" class="hidden absolute right-0 mt-2 w-48 rounded-2xl bg-white dark:bg-[#1E150F] border border-brand-brown/15 shadow-2xl py-1.5 z-30">
                <% if (activeOtherUser.isBlocked) { %>
                  <form action="/messages/users/<%= activeOtherUser._id %>/unblock" method="POST">
                    <button type="submit" class="w-full text-left px-4 py-2 text-xs font-semibold text-green-600 dark:text-green-400 hover:bg-brand-cream/40 flex items-center gap-2">
                      <i data-lucide="user-check" class="w-3.5 h-3.5"></i> Unblock User
                    </button>
                  </form>
                <% } else { %>
                  <form action="/messages/users/<%= activeOtherUser._id %>/block" method="POST" onsubmit="return confirm('Block this user? They will not be able to message you or see your direct stage.');">
                    <button type="submit" class="w-full text-left px-4 py-2 text-xs font-semibold text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/20 flex items-center gap-2">
                      <i data-lucide="slash" class="w-3.5 h-3.5"></i> Block User
                    </button>
                  </form>
                <% } %>
              </div>
            </div>
          </div>
        </div>

        <!-- Pending Message Request Alert Banner -->
        <% if (isPendingRequest) { %>
          <div class="bg-gradient-to-r from-amber-500/10 via-orange-500/10 to-amber-500/10 border-b border-amber-500/20 p-4 text-center space-y-2">
            <p class="text-xs font-bold text-amber-800 dark:text-amber-300">
              💬 Message Request from <%= activeOtherUser.username %>
            </p>
            <p class="text-[11px] text-gray-600 dark:text-gray-400 max-w-md mx-auto">
              Accept this request if you wish to allow them to chat with you. They will not know you have viewed it until you accept.
            </p>
            <div class="flex items-center justify-center gap-3 pt-1">
              <form action="/messages/requests/<%= activeOtherUser._id %>/accept" method="POST">
                <button type="submit" class="px-4 py-1.5 bg-brand-brown hover:bg-brand-accent text-white text-xs font-bold rounded-xl shadow transition-all">
                  Accept Request
                </button>
              </form>
              <form action="/messages/requests/<%= activeOtherUser._id %>/decline" method="POST" onsubmit="return confirm('Decline this message request?');">
                <button type="submit" class="px-4 py-1.5 border border-red-500/30 text-red-600 dark:text-red-400 hover:bg-red-500/10 text-xs font-bold rounded-xl transition-all">
                  Decline
                </button>
              </form>
            </div>
          </div>
        <% } %>

        <!-- Chat Stream Messages Feed -->
        <div id="messagesFeed" class="flex-1 p-4 sm:p-6 overflow-y-auto space-y-3.5 scrollbar-thin">
          <% if (messages && messages.length > 0) { %>
            <% messages.forEach(function(msg) { %>
              <% const isMine = String(msg.senderId) === String(user._id); %>
              <div class="flex flex-col <%= isMine ? 'items-end' : 'items-start' %>">
                <div class="flex items-end gap-2 max-w-[80%] sm:max-w-md <%= isMine ? 'flex-row-reverse' : '' %>">
                  <img src="<%= msg.senderAvatar || '/uploads/default-avatar.png' %>" class="w-7 h-7 rounded-full object-cover ring-1 ring-brand-brown/15 shrink-0 mb-1" alt="">
                  <div class="p-3.5 rounded-2xl text-xs sm:text-sm leading-relaxed shadow-sm <%= isMine ? 'bg-brand-brown text-white rounded-br-none' : 'bg-brand-cream/60 dark:bg-[#2A1D15] text-gray-900 dark:text-gray-100 rounded-bl-none border border-brand-brown/10 dark:border-brand-brown/20' %>">
                    <%= msg.content %>
                  </div>
                </div>
                <span class="text-[9px] text-gray-400 font-mono mt-1 px-9">
                  <%= new Date(msg.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
                </span>
              </div>
            <% }) %>
          <% } else { %>
            <div class="text-center py-20 text-gray-400 space-y-2">
              <div class="w-12 h-12 rounded-full bg-brand-brown/10 text-brand-brown dark:text-brand-pink flex items-center justify-center mx-auto">
                <i data-lucide="send" class="w-5 h-5"></i>
              </div>
              <p class="text-xs font-semibold">Start the conversation with <%= activeOtherUser.username %></p>
              <p class="text-[10px]">Send a friendly greeting or compliment on their poetry and novels.</p>
            </div>
          <% } %>
        </div>

        <!-- Chat Input Form -->
        <% if (activeOtherUser.isBlocked) { %>
          <div class="p-4 border-t border-brand-brown/10 text-center bg-red-500/10 text-red-600 dark:text-red-400 text-xs font-semibold">
            You have blocked this user. Unblock them to send direct messages.
          </div>
        <% } else { %>
          <form action="/messages/<%= activeOtherUser._id %>" method="POST" class="p-3 sm:p-4 border-t border-brand-brown/10 dark:border-brand-brown/20 flex items-center gap-2 bg-brand-cream/10 dark:bg-brand-dark/10">
            <input type="text" name="content" required placeholder="Write a direct message..." class="flex-1 px-4 py-2.5 rounded-2xl border border-brand-brown/20 dark:border-brand-brown/30 bg-white dark:bg-[#1E150F] text-xs sm:text-sm focus:outline-none focus:ring-1 focus:ring-brand-brown dark:text-white" autocomplete="off">
            <button type="submit" class="px-5 py-2.5 bg-brand-brown hover:bg-brand-accent text-white font-bold rounded-2xl text-xs shadow-md transition-all flex items-center gap-1.5 shrink-0">
              <span>Send</span> <i data-lucide="send" class="w-3.5 h-3.5"></i>
            </button>
          </form>
        <% } %>

      <% } else { %>
        
        <!-- Empty Selection Slate -->
        <div class="flex-1 flex flex-col items-center justify-center p-8 text-center space-y-4">
          <div class="w-20 h-20 rounded-3xl bg-brand-brown/10 text-brand-brown dark:text-brand-pink flex items-center justify-center ring-4 ring-brand-brown/10">
            <i data-lucide="messages-square" class="w-10 h-10"></i>
          </div>
          <div>
            <h3 class="font-serif text-xl font-bold text-gray-900 dark:text-white">Your Direct Messages</h3>
            <p class="text-xs text-gray-500 dark:text-gray-400 max-w-sm mt-1 leading-relaxed">
              Send private direct messages to authors, discuss favorite novels and poems, or connect with readers.
            </p>
          </div>
          <button onclick="togglePrivacyModal()" class="px-5 py-2.5 rounded-2xl border border-brand-brown/20 text-xs font-semibold text-brand-brown dark:text-brand-pink hover:bg-brand-cream/40 flex items-center gap-1.5 transition-all">
            <i data-lucide="shield" class="w-3.5 h-3.5"></i> Message Privacy & Blocked List
          </button>
        </div>

      <% } %>

    </div>

  </div>

</div>

<!-- ====================================================
     PRIVACY & BLOCKED USERS MODAL
     ==================================================== -->
<div id="privacySettingsModal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4">
  <div class="bg-white dark:bg-[#1E150F] border border-brand-brown/20 rounded-3xl p-6 max-w-md w-full shadow-2xl space-y-5">
    
    <div class="flex items-center justify-between border-b border-brand-brown/10 pb-3">
      <div class="flex items-center gap-2">
        <span class="p-1.5 rounded-xl bg-brand-brown/10 text-brand-brown dark:text-brand-pink">
          <i data-lucide="shield" class="w-4 h-4"></i>
        </span>
        <h3 class="font-serif text-lg font-bold text-gray-900 dark:text-white">DM Privacy & Blocked Users</h3>
      </div>
      <button onclick="togglePrivacyModal()" class="text-gray-400 hover:text-gray-600 dark:hover:text-white"><i data-lucide="x" class="w-4 h-4"></i></button>
    </div>

    <!-- Message Request Privacy Setting -->
    <form action="/messages/settings/privacy" method="POST" class="space-y-3">
      <label class="block text-xs font-bold text-gray-800 dark:text-gray-200">Who Can Send You Direct Messages:</label>
      <div class="space-y-2">
        <label class="flex items-center gap-3 p-3 rounded-xl border border-brand-brown/15 hover:bg-brand-cream/30 dark:hover:bg-brand-brown/10 cursor-pointer">
          <input type="radio" name="privacy" value="everyone" <%= currentPrivacy === 'everyone' ? 'checked' : '' %> class="accent-brand-brown">
          <div>
            <p class="text-xs font-bold text-gray-900 dark:text-white">Everyone</p>
            <p class="text-[10px] text-gray-500">Anyone can send message requests</p>
          </div>
        </label>
        <label class="flex items-center gap-3 p-3 rounded-xl border border-brand-brown/15 hover:bg-brand-cream/30 dark:hover:bg-brand-brown/10 cursor-pointer">
          <input type="radio" name="privacy" value="followers" <%= currentPrivacy === 'followers' ? 'checked' : '' %> class="accent-brand-brown">
          <div>
            <p class="text-xs font-bold text-gray-900 dark:text-white">Followers Only</p>
            <p class="text-[10px] text-gray-500">Only creators and readers who follow you can message</p>
          </div>
        </label>
        <label class="flex items-center gap-3 p-3 rounded-xl border border-brand-brown/15 hover:bg-brand-cream/30 dark:hover:bg-brand-brown/10 cursor-pointer">
          <input type="radio" name="privacy" value="none" <%= currentPrivacy === 'none' ? 'checked' : '' %> class="accent-brand-brown">
          <div>
            <p class="text-xs font-bold text-gray-900 dark:text-white">No One</p>
            <p class="text-[10px] text-gray-500">Close direct inbox completely</p>
          </div>
        </label>
      </div>
      <button type="submit" class="w-full py-2.5 bg-brand-brown hover:bg-brand-accent text-white font-bold rounded-xl text-xs transition-all shadow">
        Save Privacy Preferences
      </button>
    </form>

    <!-- Blocked Users List -->
    <div class="border-t border-brand-brown/10 pt-4 space-y-3">
      <h4 class="text-xs font-bold text-gray-800 dark:text-gray-200">Blocked Users (<%= blockedUsers.length %>)</h4>
      <div class="max-h-36 overflow-y-auto space-y-2 scrollbar-thin">
        <% if (blockedUsers && blockedUsers.length > 0) { %>
          <% blockedUsers.forEach(function(bu) { %>
            <div class="flex items-center justify-between p-2 rounded-xl bg-brand-cream/30 dark:bg-brand-dark/30 border border-brand-brown/10">
              <div class="flex items-center gap-2 truncate">
                <img src="<%= bu.avatar || '/uploads/default-avatar.png' %>" class="w-7 h-7 rounded-full object-cover" alt="">
                <span class="text-xs font-semibold text-gray-800 dark:text-gray-200 truncate"><%= bu.username %></span>
              </div>
              <form action="/messages/users/<%= bu._id %>/unblock" method="POST">
                <button type="submit" class="px-2.5 py-1 bg-green-600 hover:bg-green-700 text-white text-[10px] font-bold rounded-lg transition-all">
                  Unblock
                </button>
              </form>
            </div>
          <% }) %>
        <% } else { %>
          <p class="text-[11px] text-gray-400 text-center py-2">No blocked users.</p>
        <% } %>
      </div>
    </div>

  </div>
</div>

<script>
function togglePrivacyModal() {
  document.getElementById('privacySettingsModal').classList.toggle('hidden');
}

function toggleUserActionDropdown() {
  const menu = document.getElementById('userActionMenu');
  if (menu) menu.classList.toggle('hidden');
}

// Auto scroll messages to bottom
window.addEventListener('DOMContentLoaded', () => {
  const feed = document.getElementById('messagesFeed');
  if (feed) feed.scrollTop = feed.scrollHeight;
  if (typeof lucide !== 'undefined') lucide.createIcons();
});
</script>

<%- include('partials/footer') %>
