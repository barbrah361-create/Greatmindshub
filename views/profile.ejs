<%- include('partials/header') %>
<%- include('partials/navbar') %>
<%- include('partials/flash') %>

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex-grow">
  <div class="rounded-[32px] border border-brand-brown/10 dark:border-brand-brown/20 bg-white dark:bg-[#18110C] shadow-[0_20px_80px_rgba(0,0,0,0.08)] overflow-hidden">
    <div class="bg-[radial-gradient(circle_at_top_left,_rgba(247,214,224,0.16),_transparent_35%),linear-gradient(180deg,_rgba(247,214,224,0.12),_transparent_70%)] dark:bg-[radial-gradient(circle_at_top_left,_rgba(247,214,224,0.08),_transparent_35%),linear-gradient(180deg,_rgba(255,255,255,0.04),_transparent_70%)] p-8 sm:p-10">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="text-xs uppercase tracking-[0.32em] text-brand-brown/70 dark:text-brand-pink/70 mb-3">Personal Archive</p>
          <h1 class="font-serif text-3xl sm:text-4xl font-bold text-gray-900 dark:text-brand-pink">Welcome to your profile</h1>
          <p class="mt-3 max-w-2xl text-sm sm:text-base text-gray-500 dark:text-gray-300">Keep your account polished with a new avatar, bio, and secure credentials. Your reader persona is the first impression in our library.</p>
        </div>
        <div class="grid grid-cols-3 sm:grid-cols-5 gap-3 text-center sm:w-full lg:w-auto">
          <div class="rounded-3xl bg-brand-cream/80 dark:bg-white/5 border border-brand-brown/10 dark:border-brand-pink/20 p-4">
            <p class="text-xl sm:text-2xl font-bold text-red-500 flex items-center justify-center gap-1">
              <i data-lucide="heart" class="w-4 h-4 fill-red-500"></i>
              <%= typeof tiktokLikes !== 'undefined' ? tiktokLikes : '0' %>
            </p>
            <p class="text-[10px] uppercase tracking-[0.15em] text-gray-500 dark:text-gray-400 mt-1">Total Likes</p>
          </div>
          <div onclick="openNetworkModal('followers', '<%= profileUser._id %>')" class="cursor-pointer hover:scale-105 transition-all rounded-3xl bg-brand-cream/80 dark:bg-white/5 border border-brand-brown/10 dark:border-brand-pink/20 p-4">
            <p class="text-xl sm:text-2xl font-semibold text-gray-900 dark:text-white"><%= typeof followersCount !== 'undefined' ? followersCount : '0' %></p>
            <p class="text-[10px] uppercase tracking-[0.15em] text-gray-500 dark:text-gray-400 mt-1">Followers</p>
          </div>
          <div onclick="openNetworkModal('following', '<%= profileUser._id %>')" class="cursor-pointer hover:scale-105 transition-all rounded-3xl bg-brand-cream/80 dark:bg-white/5 border border-brand-brown/10 dark:border-brand-pink/20 p-4">
            <p class="text-xl sm:text-2xl font-semibold text-gray-900 dark:text-white"><%= typeof followingCount !== 'undefined' ? followingCount : '0' %></p>
            <p class="text-[10px] uppercase tracking-[0.15em] text-gray-500 dark:text-gray-400 mt-1">Following</p>
          </div>
          <div class="rounded-3xl bg-brand-cream/80 dark:bg-white/5 border border-brand-brown/10 dark:border-brand-pink/20 p-4">
            <p class="text-xl sm:text-2xl font-semibold text-gray-900 dark:text-white"><%= profileUser.favorites?.length || 0 %></p>
            <p class="text-[10px] uppercase tracking-[0.15em] text-gray-500 dark:text-gray-400 mt-1">Favorites</p>
          </div>
          <div class="rounded-3xl bg-brand-cream/80 dark:bg-white/5 border border-brand-brown/10 dark:border-brand-pink/20 p-4">
            <p class="text-xl sm:text-2xl font-semibold text-gray-900 dark:text-white"><%= typeof streak !== 'undefined' ? streak : 0 %></p>
            <p class="text-[10px] uppercase tracking-[0.15em] text-gray-500 dark:text-gray-400 mt-1">Read Streak</p>
          </div>
          <div class="rounded-3xl bg-brand-cream/80 dark:bg-white/5 border border-brand-brown/10 dark:border-brand-pink/20 p-4">
            <p class="text-xl sm:text-2xl font-semibold text-gray-900 dark:text-white">🔥 <%= typeof authorStreak !== 'undefined' ? authorStreak : 0 %></p>
            <p class="text-[10px] uppercase tracking-[0.15em] text-gray-500 dark:text-gray-400 mt-1">Write Streak</p>
          </div>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 px-4 pb-10 pt-8 sm:px-6 lg:px-8">
      <aside class="lg:col-span-4 bg-white dark:bg-[#1E150F] border border-brand-brown/10 dark:border-brand-brown/20 rounded-3xl p-6 shadow-sm">
        <div class="relative inline-flex mx-auto">
          <img src="<%= profileUser.avatar || '/uploads/default-avatar.png' %>" alt="<%= profileUser.username %>" class="w-36 h-36 rounded-full object-cover ring-4 ring-brand-pink shadow-lg">
          <form action="/auth/profile/avatar" method="POST" enctype="multipart/form-data" class="absolute bottom-1 right-1">
            <label for="avatar-input" class="w-11 h-11 rounded-full bg-brand-brown hover:bg-brand-accent text-white flex items-center justify-center cursor-pointer shadow-md transition-colors" aria-label="Upload new profile photo">
              <i data-lucide="camera" class="w-4 h-4"></i>
            </label>
            <input type="file" id="avatar-input" name="avatar" class="hidden" accept="image/*" onchange="document.getElementById('avatar-submit-btn').click();">
            <button type="submit" id="avatar-submit-btn" class="hidden"></button>
          </form>
        </div>

        <div class="mt-7 text-center">
          <h2 class="font-serif text-2xl font-bold text-gray-900 dark:text-white"><%= profileUser.username %></h2>
          <span class="inline-flex items-center justify-center mt-3 px-4 py-2 rounded-full bg-brand-pink/20 text-brand-brown dark:text-brand-pink text-xs font-semibold uppercase tracking-[0.24em] border border-brand-pink/30"> <%= profileUser.role %> Member </span>
          <p class="mt-3 text-sm text-gray-500 dark:text-gray-400">Member since <span class="font-semibold text-gray-800 dark:text-white"><%= new Date(profileUser.createdAt).toLocaleDateString() %></span></p>
          <div class="mt-4 rounded-2xl border border-brand-pink/20 bg-brand-cream/70 dark:bg-white/5 px-4 py-3 text-sm text-gray-700 dark:text-gray-200">
            <div class="flex items-center justify-between mb-2">
              <span class="font-semibold">Profile completion</span>
              <span class="font-semibold text-brand-brown dark:text-brand-pink"><%= typeof profileCompletion !== 'undefined' ? profileCompletion : 0 %>%</span>
            </div>
            <div class="h-2 rounded-full bg-brand-brown/10 dark:bg-white/10 overflow-hidden">
              <div class="h-full rounded-full bg-gradient-to-r from-brand-brown to-brand-pink" style="width:<%= typeof profileCompletion !== 'undefined' ? profileCompletion : 0 %>%"></div>
            </div>
          </div>
        </div>

        <div class="mt-8 space-y-4">
          <% if (typeof achievements !== 'undefined' && achievements.length > 0) { %>
            <div class="rounded-3xl bg-brand-cream/90 dark:bg-white/5 border border-brand-brown/10 dark:border-brand-pink/20 p-5">
              <h3 class="text-xs font-semibold text-gray-700 dark:text-gray-300 uppercase tracking-[0.24em] mb-3">🏆 Achievements</h3>
              <div class="flex flex-wrap gap-2">
                <% achievements.forEach(function(achievement) { %>
                  <span class="px-2.5 py-1 rounded-full bg-brand-pink/20 text-brand-brown dark:text-brand-pink text-[10px] font-bold border border-brand-pink/25 shadow-sm">
                    <%= achievement %>
                  </span>
                <% }) %>
              </div>
            </div>
          <% } %>

          <div class="rounded-3xl bg-brand-cream/90 dark:bg-white/5 border border-brand-brown/10 dark:border-brand-pink/20 p-5">
            <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300 uppercase tracking-[0.24em] mb-3">About your profile</h3>
            <% if (profileUser.bio) { %>
              <p class="text-sm text-gray-700 dark:text-gray-200 leading-relaxed"><%= profileUser.bio %></p>
            <% } else { %>
              <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed italic">No public bio yet. Add something memorable about your reading journey.</p>
            <% } %>
          </div>

          <div class="grid grid-cols-1 gap-3">
            <% if (profileUser.location || profileUser.nationality) { %>
              <div class="rounded-3xl bg-white dark:bg-[#24180F] border border-brand-brown/10 dark:border-brand-brown/20 p-4">
                <p class="text-sm text-gray-500 dark:text-gray-400 uppercase tracking-[0.24em] mb-2">Location</p>
                <p class="text-base font-semibold text-gray-900 dark:text-white"><%= profileUser.location || profileUser.nationality %></p>
              </div>
            <% } %>
            <% if (profileUser.website) { %>
              <div class="rounded-3xl bg-white dark:bg-[#24180F] border border-brand-brown/10 dark:border-brand-brown/20 p-4">
                <p class="text-sm text-gray-500 dark:text-gray-400 uppercase tracking-[0.24em] mb-2">Website</p>
                <a href="<%= profileUser.website %>" target="_blank" rel="noopener noreferrer" class="text-brand-brown dark:text-brand-pink font-semibold hover:underline break-words"><%= profileUser.website %></a>
              </div>
            <% } %>
            <% if (profileUser.twitter || profileUser.instagram || profileUser.linkedin || profileUser.facebook || profileUser.tiktok || profileUser.youtube) { %>
              <div class="rounded-3xl bg-white dark:bg-[#24180F] border border-brand-brown/10 dark:border-brand-brown/20 p-4">
                <p class="text-sm text-gray-500 dark:text-gray-400 uppercase tracking-[0.24em] mb-3">Social links</p>
                <div class="flex flex-wrap gap-2 text-sm">
                  <% if (profileUser.twitter) { %>
                    <a href="<%= profileUser.twitter %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full bg-brand-cream/80 px-3 py-2 text-gray-900 dark:bg-white/5 dark:text-white hover:text-brand-brown dark:hover:text-brand-pink"><i data-lucide="twitter" class="w-4 h-4"></i><span>Twitter</span></a>
                  <% } %>
                  <% if (profileUser.instagram) { %>
                    <a href="<%= profileUser.instagram %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full bg-brand-cream/80 px-3 py-2 text-gray-900 dark:bg-white/5 dark:text-white hover:text-brand-brown dark:hover:text-brand-pink"><i data-lucide="instagram" class="w-4 h-4"></i><span>Instagram</span></a>
                  <% } %>
                  <% if (profileUser.linkedin) { %>
                    <a href="<%= profileUser.linkedin %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full bg-brand-cream/80 px-3 py-2 text-gray-900 dark:bg-white/5 dark:text-white hover:text-brand-brown dark:hover:text-brand-pink"><i data-lucide="linkedin" class="w-4 h-4"></i><span>LinkedIn</span></a>
                  <% } %>
                  <% if (profileUser.facebook) { %>
                    <a href="<%= profileUser.facebook %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full bg-brand-cream/80 px-3 py-2 text-gray-900 dark:bg-white/5 dark:text-white hover:text-brand-brown dark:hover:text-brand-pink"><i data-lucide="facebook" class="w-4 h-4"></i><span>Facebook</span></a>
                  <% } %>
                  <% if (profileUser.tiktok) { %>
                    <a href="<%= profileUser.tiktok %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full bg-brand-cream/80 px-3 py-2 text-gray-900 dark:bg-white/5 dark:text-white hover:text-brand-brown dark:hover:text-brand-pink"><i data-lucide="music-2" class="w-4 h-4"></i><span>TikTok</span></a>
                  <% } %>
                  <% if (profileUser.youtube) { %>
                    <a href="<%= profileUser.youtube %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full bg-brand-cream/80 px-3 py-2 text-gray-900 dark:bg-white/5 dark:text-white hover:text-brand-brown dark:hover:text-brand-pink"><i data-lucide="youtube" class="w-4 h-4"></i><span>YouTube</span></a>
                  <% } %>
                </div>
              </div>
            <% } %>
          </div>
        </div>
      </aside>

      <main class="lg:col-span-8 space-y-6">
        <section class="bg-white dark:bg-[#1E150F] border border-brand-brown/10 dark:border-brand-brown/20 rounded-3xl p-6 sm:p-8 shadow-sm">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
            <div>
              <h2 class="font-serif text-xl font-bold text-gray-900 dark:text-brand-pink">Edit Your Profile</h2>
              <p class="text-sm text-gray-500 dark:text-gray-400">Update your public name, biography, and reading style.</p>
            </div>
            <div class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.28em] text-brand-brown/70 dark:text-brand-pink/70 font-semibold">
              <i data-lucide="refresh-cw" class="w-4 h-4"></i>
              Always kept current
            </div>
          </div>

          <form action="/auth/profile/update" method="POST" class="space-y-5">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="username" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Username</label>
                <input type="text" id="username" name="username" value="<%= profileUser.username %>" required class="block w-full px-4 py-3 border border-brand-brown/20 dark:border-brand-brown/30 rounded-2xl bg-brand-cream/10 dark:bg-[#2E1E12] text-gray-800 dark:text-white placeholder-gray-400 focus:outline-none focus:border-brand-brown dark:focus:border-brand-pink text-sm transition-all" />
              </div>
              <div>
                <label class="block text-sm font-semibold text-gray-400 dark:text-gray-500 mb-1.5">Registered Email</label>
                <input type="email" value="<%= profileUser.email %>" readonly class="block w-full px-4 py-3 border border-brand-brown/10 dark:border-brand-brown/15 rounded-2xl bg-gray-50 dark:bg-[#24180F] text-gray-400 dark:text-gray-500 text-sm cursor-not-allowed" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="location" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Location</label>
                <input type="text" id="location" name="location" value="<%= profileUser.location %>" class="block w-full px-4 py-3 border border-brand-brown/20 dark:border-brand-brown/30 rounded-2xl bg-brand-cream/10 dark:bg-[#2E1E12] text-gray-800 dark:text-white placeholder-gray-400 focus:outline-none focus:border-brand-brown dark:focus:border-brand-pink text-sm transition-all" placeholder="e.g. Lagos, Nigeria" />
              </div>
              <div>
                <label for="country" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Country</label>
                <input type="text" id="country" name="country" value="<%= profileUser.nationality %>" class="block w-full px-4 py-3 border border-brand-brown/20 dark:border-brand-brown/30 rounded-2xl bg-brand-cream/10 dark:bg-[#2E1E12] text-gray-800 dark:text-white placeholder-gray-400 focus:outline-none focus:border-brand-brown dark:focus:border-brand-pink text-sm transition-all" placeholder="Nigeria" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="languages" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Languages</label>
                <input type="text" id="languages" name="languages" value="<%= profileUser.writingStyle %>" class="block w-full px-4 py-3 border border-brand-brown/20 dark:border-brand-brown/30 rounded-2xl bg-brand-cream/10 dark:bg-[#2E1E12] text-gray-800 dark:text-white placeholder-gray-400 focus:outline-none focus:border-brand-brown dark:focus:border-brand-pink text-sm transition-all" placeholder="English, Swahili" />
              </div>
              <div>
                <label for="website" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Website</label>
                <input type="url" id="website" name="website" value="<%= profileUser.website %>" class="block w-full px-4 py-3 border border-brand-brown/20 dark:border-brand-brown/30 rounded-2xl bg-brand-cream/10 dark:bg-[#2E1E12] text-gray-800 dark:text-white placeholder-gray-400 focus:outline-none focus:border-brand-brown dark:focus:border-brand-pink text-sm transition-all" placeholder="https://" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="twitter" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Twitter</label>
                <input type="url" id="twitter" name="twitter" value="<%= profileUser.twitter %>" class="block w-full px-4 py-3 border border-brand-brown/20 dark:border-brand-brown/30 rounded-2xl bg-brand-cream/10 dark:bg-[#2E1E12] text-gray-800 dark:text-white placeholder-gray-400 focus:outline-none focus:border-brand-brown dark:focus:border-brand-pink text-sm transition-all" placeholder="https://x.com/yourhandle" />
              </div>
              <div>
                <label for="instagram" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Instagram</label>
                <input type="url" id="instagram" name="instagram" value="<%= profileUser.instagram %>" class="block w-full px-4 py-3 border border-brand-brown/20 dark:border-brand-brown/30 rounded-2xl bg-brand-cream/10 dark:bg-[#2E1E12] text-gray-800 dark:text-white placeholder-gray-400 focus:outline-none focus:border-brand-brown dark:focus:border-brand-pink text-sm transition-all" placeholder="https://instagram.com/yourhandle" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="linkedin" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">LinkedIn</label>
                <input type="url" id="linkedin" name="linkedin" value="<%= profileUser.linkedin %>" class="block w-full px-4 py-3 border border-brand-brown/20 dark:border-brand-brown/30 rounded-2xl bg-brand-cream/10 dark:bg-[#2E1E12] text-gray-800 dark:text-white placeholder-gray-400 focus:outline-none focus:border-brand-brown dark:focus:border-brand-pink text-sm transition-all" placeholder="https://linkedin.com/in/yourname" />
              </div>
              <div>
                <label for="facebook" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Facebook</label>
                <input type="url" id="facebook" name="facebook" value="<%= profileUser.facebook %>" class="block w-full px-4 py-3 border border-brand-brown/20 dark:border-brand-brown/30 rounded-2xl bg-brand-cream/10 dark:bg-[#2E1E12] text-gray-800 dark:text-white placeholder-gray-400 focus:outline-none focus:border-brand-brown dark:focus:border-brand-pink text-sm transition-all" placeholder="https://facebook.com/yourname" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="tiktok" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">TikTok</label>
                <input type="url" id="tiktok" name="tiktok" value="<%= profileUser.tiktok %>" class="block w-full px-4 py-3 border border-brand-brown/20 dark:border-brand-brown/30 rounded-2xl bg-brand-cream/10 dark:bg-[#2E1E12] text-gray-800 dark:text-white placeholder-gray-400 focus:outline-none focus:border-brand-brown dark:focus:border-brand-pink text-sm transition-all" placeholder="https://tiktok.com/@yourhandle" />
              </div>
              <div>
                <label for="youtube" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">YouTube</label>
                <input type="url" id="youtube" name="youtube" value="<%= profileUser.youtube %>" class="block w-full px-4 py-3 border border-brand-brown/20 dark:border-brand-brown/30 rounded-2xl bg-brand-cream/10 dark:bg-[#2E1E12] text-gray-800 dark:text-white placeholder-gray-400 focus:outline-none focus:border-brand-brown dark:focus:border-brand-pink text-sm transition-all" placeholder="https://youtube.com/@yourchannel" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="genres" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Favorite Genres</label>
                <input type="text" id="genres" name="genres" value="<%= (profileUser.genres || []).join(', ') %>" class="block w-full px-4 py-3 border border-brand-brown/20 dark:border-brand-brown/30 rounded-2xl bg-brand-cream/10 dark:bg-[#2E1E12] text-gray-800 dark:text-white placeholder-gray-400 focus:outline-none focus:border-brand-brown dark:focus:border-brand-pink text-sm transition-all" placeholder="Fantasy, Romance" />
              </div>
              <div>
                <label for="favoriteAuthors" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Favorite Authors</label>
                <input type="text" id="favoriteAuthors" name="favoriteAuthors" value="<%= (profileUser.awards || []).join(', ') %>" class="block w-full px-4 py-3 border border-brand-brown/20 dark:border-brand-brown/30 rounded-2xl bg-brand-cream/10 dark:bg-[#2E1E12] text-gray-800 dark:text-white placeholder-gray-400 focus:outline-none focus:border-brand-brown dark:focus:border-brand-pink text-sm transition-all" placeholder="Aminata, Chinua" />
              </div>
            </div>

            <div>
              <label for="bio" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Biography / Literary Taste</label>
              <textarea id="bio" name="bio" rows="5" class="block w-full px-4 py-4 border border-brand-brown/20 dark:border-brand-brown/30 rounded-3xl bg-brand-cream/10 dark:bg-[#24180F] text-gray-800 dark:text-white placeholder-gray-400 focus:outline-none focus:border-brand-brown dark:focus:border-brand-pink text-sm transition-all" placeholder="Share the genres and authors that shape your reading life..."><%= profileUser.bio %></textarea>
            </div>

            <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
              <p class="text-xs text-gray-500 dark:text-gray-400">Your profile is visible to the library community when you post comments and ratings.</p>
              <button type="submit" class="inline-flex items-center gap-2 px-6 py-3 bg-brand-brown hover:bg-brand-accent text-white rounded-2xl shadow-md hover:shadow-lg transition-all duration-200 text-sm font-semibold">
                <i data-lucide="save" class="w-4 h-4"></i>
                Save Profile
              </button>
            </div>
          </form>
        </section>

        <section class="bg-white dark:bg-[#1E150F] border border-brand-brown/10 dark:border-brand-brown/20 rounded-3xl p-6 sm:p-8 shadow-sm">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
            <div>
              <h2 class="font-serif text-xl font-bold text-gray-900 dark:text-brand-pink">Security & access</h2>
              <p class="text-sm text-gray-500 dark:text-gray-400">Protect your account with a strong password and keep your reading vault secure.</p>
            </div>
            <span class="inline-flex items-center gap-2 rounded-full border border-brand-brown/10 dark:border-brand-pink/20 bg-brand-cream/90 dark:bg-white/5 px-4 py-2 text-xs font-semibold uppercase tracking-[0.24em] text-brand-brown dark:text-brand-pink">Password change</span>
          </div>

          <form action="/auth/profile/password" method="POST" class="space-y-5">
            <div>
              <label for="currentPassword" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Current Password</label>
              <input type="password" id="currentPassword" name="currentPassword" required class="block w-full px-4 py-3 border border-brand-brown/20 dark:border-brand-brown/30 rounded-2xl bg-brand-cream/10 dark:bg-[#24180F] text-gray-800 dark:text-white placeholder-gray-400 focus:outline-none focus:border-brand-brown dark:focus:border-brand-pink text-sm transition-all" placeholder="••••••••" />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="newPassword" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">New Password</label>
                <input type="password" id="newPassword" name="newPassword" required class="block w-full px-4 py-3 border border-brand-brown/20 dark:border-brand-brown/30 rounded-2xl bg-brand-cream/10 dark:bg-[#24180F] text-gray-800 dark:text-white placeholder-gray-400 focus:outline-none focus:border-brand-brown dark:focus:border-brand-pink text-sm transition-all" placeholder="••••••••" />
              </div>
              <div>
                <label for="confirmNewPassword" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Confirm New Password</label>
                <input type="password" id="confirmNewPassword" name="confirmNewPassword" required class="block w-full px-4 py-3 border border-brand-brown/20 dark:border-brand-brown/30 rounded-2xl bg-brand-cream/10 dark:bg-[#24180F] text-gray-800 dark:text-white placeholder-gray-400 focus:outline-none focus:border-brand-brown dark:focus:border-brand-pink text-sm transition-all" placeholder="••••••••" />
              </div>
            </div>

            <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
              <p class="text-xs text-gray-500 dark:text-gray-400">A strong password keeps your reading collection and account safe.</p>
              <button type="submit" class="inline-flex items-center gap-2 px-6 py-3 bg-brand-brown hover:bg-brand-accent text-white rounded-2xl shadow-md hover:shadow-lg transition-all duration-200 text-sm font-semibold">
                <i data-lucide="key-round" class="w-4 h-4"></i>
                Change Password
              </button>
            </div>
          </form>
        </section>
      </main>
    </div>
  </div>

  <!-- My Uploads & Reposts -->
  <div class="mt-10 bg-white dark:bg-[#18110C] rounded-[32px] border border-brand-brown/10 dark:border-brand-brown/20 p-8 shadow-sm">
    <!-- Tab Navigation -->
    <div class="flex gap-2 border-b border-brand-brown/10 dark:border-brand-brown/15 pb-0 mb-6 overflow-x-auto">
      <button onclick="showTab('tab-poems')" id="btn-tab-poems"
        class="tab-btn px-5 py-2.5 rounded-t-xl text-sm font-semibold border-b-2 border-brand-brown dark:border-brand-pink text-brand-brown dark:text-brand-pink transition-all whitespace-nowrap">
        🖊 My Poems
      </button>
      <button onclick="showTab('tab-novels')" id="btn-tab-novels"
        class="tab-btn px-5 py-2.5 rounded-t-xl text-sm font-semibold border-b-2 border-transparent text-gray-500 dark:text-gray-400 hover:text-brand-brown dark:hover:text-brand-pink transition-all whitespace-nowrap">
        📚 My Novels
      </button>
      <button onclick="showTab('tab-reposts')" id="btn-tab-reposts"
        class="tab-btn px-5 py-2.5 rounded-t-xl text-sm font-semibold border-b-2 border-transparent text-gray-500 dark:text-gray-400 hover:text-brand-brown dark:hover:text-brand-pink transition-all whitespace-nowrap">
        🔁 Reposts
      </button>
    </div>

    <!-- Poems Tab -->
    <div id="tab-poems" class="tab-panel">
      <% if (typeof userPoems !== 'undefined' && userPoems.length > 0) { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <% userPoems.forEach(function(poem) { %>
            <div class="group bg-brand-cream/40 dark:bg-white/5 rounded-2xl border border-brand-brown/10 dark:border-brand-pink/10 p-5 hover:border-brand-pink/50 hover:shadow-md transition-all relative">
              <div class="flex items-start justify-between mb-3">
                <span class="text-[10px] font-bold uppercase tracking-widest px-2 py-0.5 rounded-full
                  <%= poem.approvalStatus === 'approved' ? 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400' : 'bg-yellow-100 text-yellow-700 dark:bg-yellow-900/30 dark:text-yellow-400' %>">
                  <%= poem.approvalStatus === 'approved' ? 'Live' : 'Pending Payment' %>
                </span>
                <span class="flex items-center gap-1 text-xs text-red-500">
                  <i data-lucide="heart" class="w-3 h-3 fill-red-500"></i>
                  <%= (poem.likes || []).length %>
                </span>
              </div>
              <h3 class="font-serif font-bold text-gray-900 dark:text-white text-base mb-1 line-clamp-2 group-hover:text-brand-brown dark:group-hover:text-brand-pink transition-colors">
                <a href="/poems/<%= poem._id %>" class="hover:underline"><%= poem.title %></a>
              </h3>
              <p class="text-xs text-gray-400 line-clamp-2 mt-1"><%= poem.content ? poem.content.replace(/<[^>]+>/g, '').substring(0, 100) : '' %>...</p>
              <div class="flex items-center justify-between mt-3 pt-2 border-t border-brand-brown/5">
                <span class="text-[10px] text-gray-400"><%= poem.genre || 'Poetry' %></span>
                <div class="flex items-center gap-3">
                  <% if (user && String(profileUser._id) === String(user._id)) { %>
                    <a href="/poems/<%= poem._id %>/edit" class="text-[10px] text-brand-brown dark:text-brand-pink hover:underline font-bold">Edit</a>
                    <form action="/poems/<%= poem._id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to permanently delete this poem?');" class="inline">
                      <button type="submit" class="text-[10px] text-red-500 hover:underline font-bold">Delete</button>
                    </form>
                    <% if (poem.approvalStatus !== 'approved') { %>
                      <a href="/poems/<%= poem._id %>" class="text-[10px] text-yellow-600 hover:underline font-bold">Pay</a>
                    <% } %>
                  <% } %>
                  <span class="text-[10px] text-gray-405 flex items-center gap-1">
                    <i data-lucide="message-circle" class="w-3 h-3"></i> <%= (poem.comments || []).length %>
                  </span>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
        <div class="mt-5 text-center">
          <a href="/poems/submit" class="inline-flex items-center gap-2 px-5 py-2.5 bg-brand-brown hover:bg-brand-accent text-white rounded-2xl text-sm font-semibold transition-all shadow">
            <i data-lucide="plus" class="w-4 h-4"></i> Upload New Poem — KES 100
          </a>
        </div>
      <% } else { %>
        <div class="text-center py-12">
          <i data-lucide="feather" class="w-12 h-12 text-brand-brown/30 dark:text-brand-pink/30 mx-auto mb-4"></i>
          <p class="text-gray-500 dark:text-gray-400 mb-4">You haven't published any poems yet.</p>
          <a href="/poems/submit" class="inline-flex items-center gap-2 px-6 py-3 bg-brand-brown hover:bg-brand-accent text-white rounded-2xl font-semibold text-sm shadow transition-all">
            <i data-lucide="plus" class="w-4 h-4"></i> Publish Your First Poem — KES 100
          </a>
        </div>
      <% } %>
    </div>

    <!-- Novels Tab -->
    <div id="tab-novels" class="tab-panel hidden">
      <% if (typeof userNovels !== 'undefined' && userNovels.length > 0) { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <% userNovels.forEach(function(novel) { %>
            <div class="group bg-brand-cream/40 dark:bg-white/5 rounded-2xl border border-brand-brown/10 dark:border-brand-pink/10 p-5 hover:border-brand-pink/50 hover:shadow-md transition-all relative">
              <div class="flex items-start justify-between mb-3">
                <span class="text-[10px] font-bold uppercase tracking-widest px-2 py-0.5 rounded-full
                  <%= novel.approvalStatus === 'approved' ? 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400' : 'bg-yellow-100 text-yellow-700 dark:bg-yellow-900/30 dark:text-yellow-400' %>">
                  <%= novel.approvalStatus === 'approved' ? 'Published' : 'Pending Payment' %>
                </span>
                <span class="flex items-center gap-1 text-xs text-red-500">
                  <i data-lucide="heart" class="w-3 h-3 fill-red-500"></i>
                  <%= (novel.likes || []).length %>
                </span>
              </div>
              <h3 class="font-serif font-bold text-gray-900 dark:text-white text-base mb-1 line-clamp-2 group-hover:text-brand-brown dark:group-hover:text-brand-pink transition-colors">
                <a href="/novels/<%= novel._id %>" class="hover:underline"><%= novel.title %></a>
              </h3>
              <p class="text-xs text-gray-400 line-clamp-2 mt-1"><%= novel.description ? novel.description.substring(0, 100) : '' %>...</p>
              <div class="flex items-center justify-between mt-3 pt-2 border-t border-brand-brown/5">
                <span class="text-[10px] text-gray-400"><%= novel.genre %></span>
                <div class="flex items-center gap-3">
                  <% if (user && String(profileUser._id) === String(user._id)) { %>
                    <a href="/novels/<%= novel._id %>/edit" class="text-[10px] text-brand-brown dark:text-brand-pink hover:underline font-bold">Edit</a>
                    <form action="/novels/<%= novel._id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to permanently delete this novel?');" class="inline">
                      <button type="submit" class="text-[10px] text-red-500 hover:underline font-bold">Delete</button>
                    </form>
                    <% if (novel.approvalStatus !== 'approved') { %>
                      <a href="/novels/<%= novel._id %>" class="text-[10px] text-yellow-600 hover:underline font-bold">Pay</a>
                    <% } %>
                  <% } %>
                  <span class="text-[10px] text-gray-405 flex items-center gap-1">
                    <i data-lucide="book-open" class="w-3 h-3"></i> <%= novel.readerCount || 0 %>
                  </span>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
        <div class="mt-5 text-center">
          <a href="/novels/submit" class="inline-flex items-center gap-2 px-5 py-2.5 bg-brand-brown hover:bg-brand-accent text-white rounded-2xl text-sm font-semibold transition-all shadow">
            <i data-lucide="plus" class="w-4 h-4"></i> Upload New Novel — KES 100
          </a>
        </div>
      <% } else { %>
        <div class="text-center py-12">
          <i data-lucide="book" class="w-12 h-12 text-brand-brown/30 dark:text-brand-pink/30 mx-auto mb-4"></i>
          <p class="text-gray-500 dark:text-gray-400 mb-4">You haven't published any novels yet.</p>
          <a href="/novels/submit" class="inline-flex items-center gap-2 px-6 py-3 bg-brand-brown hover:bg-brand-accent text-white rounded-2xl font-semibold text-sm shadow transition-all">
            <i data-lucide="plus" class="w-4 h-4"></i> Publish Your First Novel — KES 100
          </a>
        </div>
      <% } %>
    </div>

    <!-- Reposts Tab -->
    <div id="tab-reposts" class="tab-panel hidden">
      <% if (typeof userReposts !== 'undefined' && userReposts.length > 0) { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <% userReposts.forEach(function(poem) { %>
            <div class="group bg-brand-cream/40 dark:bg-white/5 rounded-2xl border border-brand-brown/10 dark:border-brand-pink/10 p-5 hover:border-brand-pink/50 transition-all">
              <div class="flex items-center gap-1.5 text-[10px] text-brand-pink font-bold uppercase tracking-wider mb-3">
                <i data-lucide="repeat-2" class="w-3 h-3"></i> Reposted
              </div>
              <h3 class="font-serif font-bold text-gray-900 dark:text-white text-base mb-1 line-clamp-2">
                <a href="/poems/<%= poem._id %>" class="hover:text-brand-brown dark:hover:text-brand-pink transition-colors"><%= poem.title %></a>
              </h3>
              <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">by <span class="font-semibold"><%= poem.authorName %></span></p>
              <p class="text-xs text-gray-400 line-clamp-2"><%= poem.content ? poem.content.substring(0, 100) : '' %>...</p>
              <div class="flex items-center justify-between mt-3 pt-2 border-t border-brand-brown/5">
                <span class="flex items-center gap-1 text-xs text-red-500">
                  <i data-lucide="heart" class="w-3 h-3 fill-red-500"></i>
                  <%= (poem.likes || []).length %>
                </span>
                <form action="/poems/<%= poem._id %>/repost" method="POST">
                  <button type="submit" class="text-[10px] text-red-400 hover:text-red-600 font-semibold transition-colors">Remove Repost</button>
                </form>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="text-center py-12">
          <i data-lucide="repeat-2" class="w-12 h-12 text-brand-brown/30 dark:text-brand-pink/30 mx-auto mb-4"></i>
          <p class="text-gray-500 dark:text-gray-400">No reposts yet. Explore poems and hit "Repost" to share them here.</p>
          <a href="/poems" class="inline-flex items-center gap-2 mt-4 px-5 py-2.5 border border-brand-brown/30 text-brand-brown dark:text-brand-pink rounded-2xl text-sm font-semibold hover:bg-brand-pink/10 transition-all">
            Browse Poems
          </a>
        </div>
      <% } %>
    </div>
  </div>

  <script>
  function showTab(id) {
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.add('hidden'));
    document.querySelectorAll('.tab-btn').forEach(b => {
      b.classList.remove('border-brand-brown', 'dark:border-brand-pink', 'text-brand-brown', 'dark:text-brand-pink');
      b.classList.add('border-transparent', 'text-gray-500', 'dark:text-gray-400');
    });
    document.getElementById(id).classList.remove('hidden');
    const btn = document.getElementById('btn-' + id);
    btn.classList.remove('border-transparent', 'text-gray-500', 'dark:text-gray-400');
    btn.classList.add('border-brand-brown', 'dark:border-brand-pink', 'text-brand-brown', 'dark:text-brand-pink');
  }
  </script>

  <!-- People You May Know (Suggested Members & Creators) -->

  <% if (typeof suggestedUsers !== 'undefined' && suggestedUsers.length > 0) { %>
    <div class="mt-10 bg-white dark:bg-[#18110C] rounded-[32px] border border-brand-brown/10 dark:border-brand-brown/20 p-8 shadow-sm">
      <div class="flex items-center justify-between border-b border-brand-brown/10 dark:border-brand-brown/15 pb-4 mb-6">
        <div>
          <span class="text-[10px] font-bold uppercase tracking-widest text-brand-pink bg-brand-pink/20 px-2.5 py-0.5 rounded-full">Community</span>
          <h2 class="font-serif text-2xl font-bold text-gray-900 dark:text-white mt-1 flex items-center gap-2">
            <i data-lucide="user-plus" class="w-6 h-6 text-brand-brown dark:text-brand-pink"></i>
            People You May Know
          </h2>
        </div>
        <a href="/authors" class="text-xs font-semibold text-brand-brown dark:text-brand-pink hover:underline">Explore All &rarr;</a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        <% suggestedUsers.forEach(function(sUser) { %>
          <div class="bg-brand-cream/30 dark:bg-white/5 p-5 rounded-2xl border border-brand-brown/10 flex flex-col justify-between items-center text-center space-y-3 group hover:border-brand-pink/50 transition-colors">
            <a href="/authors/<%= sUser._id %>" class="group-hover:scale-105 transition-transform">
              <img src="<%= sUser.avatar %>" alt="" class="w-16 h-16 rounded-full object-cover ring-2 ring-brand-pink shadow-md mx-auto">
            </a>
            <div>
              <a href="/authors/<%= sUser._id %>" class="font-bold text-sm text-gray-900 dark:text-white hover:underline block truncate"><%= sUser.username %></a>
              <p class="text-[11px] text-gray-400 line-clamp-1 mt-0.5"><%= sUser.bio %></p>
            </div>

            <div class="flex items-center justify-center gap-3 text-[10px] text-gray-500 border-y border-brand-brown/5 w-full py-1.5">
              <span class="flex items-center gap-1"><i data-lucide="heart" class="w-3 h-3 text-red-500 fill-red-500"></i> <%= sUser.likes %></span>
              <span class="flex items-center gap-1"><i data-lucide="users" class="w-3 h-3 text-brand-brown"></i> <%= sUser.followersCount %></span>
            </div>

            <form action="/authors/<%= sUser._id %>/follow" method="POST" class="w-full">
              <button type="submit" class="w-full py-1.5 px-3 rounded-xl bg-brand-brown hover:bg-brand-accent text-white font-bold text-xs shadow transition-colors flex items-center justify-center gap-1">
                <i data-lucide="user-plus" class="w-3.5 h-3.5"></i>
                <%= sUser.isFollowing ? 'Following' : 'Follow' %>
              </button>
            </form>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>
</div>

<%- include('partials/network-modal') %>
<%- include('partials/footer') %>
