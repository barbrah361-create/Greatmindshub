<%- include('partials/header') %>
<%- include('partials/navbar') %>
<%- include('partials/flash') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 flex-grow">
  <!-- Header -->
  <div class="text-center mb-12">
    <span class="text-brand-brown dark:text-brand-pink text-xs font-bold uppercase tracking-widest">Lyre & Verse</span>
    <h1 class="font-serif text-4xl sm:text-5xl font-bold mt-3 text-gray-800 dark:text-white">The Poetry Collective</h1>
    <p class="text-gray-500 dark:text-gray-400 max-w-2xl mx-auto mt-4 text-sm sm:text-base leading-relaxed">
      A quiet sanctuary for verses, stanzas, and rhythmic prose. Explore original works from creators around the globe.
    </p>
    <div class="mt-8">
      <a href="/poems/submit" class="inline-flex items-center gap-2 px-6 py-3 bg-brand-brown hover:bg-brand-accent text-white font-semibold rounded-full transition-all duration-200 text-sm shadow-md">
        <i data-lucide="feather" class="w-4 h-4"></i>
        Submit Your Verse
      </a>
    </div>
  </div>

  <!-- Filters / Sorter -->
  <div class="flex flex-col sm:flex-row items-center justify-between border-b border-brand-brown/10 dark:border-brand-brown/20 pb-5 mb-10 gap-4">
    <div class="text-sm text-gray-500 dark:text-gray-400">
      Showing page <span class="font-semibold text-brand-brown dark:text-brand-pink"><%= page %></span> of <span class="font-semibold"><%= totalPages || 1 %></span>
    </div>
    
    <div class="flex items-center gap-2">
      <span class="text-xs text-gray-400 uppercase tracking-wider font-semibold">Sort by:</span>
      <div class="inline-flex rounded-full p-1 bg-brand-cream/80 dark:bg-[#1E150F] border border-brand-brown/10">
        <a href="/poems?sort=latest" class="px-4 py-1.5 rounded-full text-xs font-medium transition-colors <%= sort === 'latest' ? 'bg-brand-brown text-white shadow-sm' : 'text-gray-500 hover:text-brand-brown dark:hover:text-brand-pink' %>">
          Latest
        </a>
        <a href="/poems?sort=popular" class="px-4 py-1.5 rounded-full text-xs font-medium transition-colors <%= sort === 'popular' ? 'bg-brand-brown text-white shadow-sm' : 'text-gray-500 hover:text-brand-brown dark:hover:text-brand-pink' %>">
          Views
        </a>
        <a href="/poems?sort=liked" class="px-4 py-1.5 rounded-full text-xs font-medium transition-colors <%= sort === 'liked' ? 'bg-brand-brown text-white shadow-sm' : 'text-gray-500 hover:text-brand-brown dark:hover:text-brand-pink' %>">
          Most Liked
        </a>
      </div>
    </div>
  </div>

  <% if (poems && poems.length > 0) { %>
    <!-- Poem Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <% poems.forEach(function(poem) { %>
        <div class="book-card p-6 flex flex-col hover:shadow-lg transition-all duration-300 border border-brand-brown/10 dark:border-brand-brown/20 bg-white dark:bg-[#1E150F] relative group">
          <div class="absolute top-4 right-4 text-[10px] uppercase tracking-wider font-semibold bg-brand-pink/20 text-brand-brown dark:text-brand-pink px-2.5 py-1 rounded-full border border-brand-pink/30">
            <%= poem.genre || 'Poetry' %>
          </div>

          <div class="flex-grow mt-2">
            <h2 class="font-serif text-2xl font-bold text-gray-800 dark:text-white mb-2 group-hover:text-brand-accent transition-colors">
              <a href="/poems/<%= poem._id %>"><%= poem.title %></a>
            </h2>
            <p class="text-xs text-gray-400 dark:text-gray-500 mb-4">
              By <span class="font-semibold text-brand-brown dark:text-brand-pink"><%= poem.authorName %></span>
            </p>

            <div class="text-sm italic text-gray-600 dark:text-gray-300 leading-relaxed mb-6 font-serif line-clamp-4 whitespace-pre-line">
              <%= poem.content %>
            </div>
          </div>

          <div class="flex items-center justify-between border-t border-brand-brown/10 dark:border-brand-brown/15 pt-4 mt-auto">
            <div class="flex items-center gap-3.5 text-xs text-gray-400 dark:text-gray-500">
              <span class="flex items-center gap-1">
                <i data-lucide="eye" class="w-4 h-4 text-brand-brown dark:text-brand-pink"></i>
                <%= poem.viewCount || 0 %>
              </span>
              <span class="flex items-center gap-1">
                <i data-lucide="heart" class="w-4 h-4 text-red-500 fill-red-500/20"></i>
                <%= poem.likes ? poem.likes.length : 0 %>
              </span>
            </div>

            <a href="/poems/<%= poem._id %>" class="px-4 py-1.5 bg-brand-cream dark:bg-brand-brown/10 hover:bg-brand-pink/30 text-brand-brown dark:text-brand-pink font-semibold rounded-lg text-xs transition-colors flex items-center gap-1.5">
              Read Full Verse
              <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
            </a>
          </div>
        </div>
      <% }) %>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
      <div class="flex items-center justify-center gap-2 mt-12 pt-8 border-t border-brand-brown/10 dark:border-brand-brown/20">
        <% if (page > 1) { %>
          <a href="/poems?page=<%= page - 1 %>&sort=<%= sort %>" class="p-2 border border-brand-brown/20 text-gray-600 dark:text-gray-300 rounded-lg hover:bg-brand-cream/10 transition-colors">
            <i data-lucide="chevron-left" class="w-4 h-4"></i>
          </a>
        <% } %>

        <% for (let i = 1; i <= totalPages; i++) { %>
          <% if (i === page) { %>
            <span class="px-3.5 py-1.5 bg-brand-brown text-white font-bold rounded-lg text-xs">
              <%= i %>
            </span>
          <% } else { %>
            <a href="/poems?page=<%= i %>&sort=<%= sort %>" class="px-3.5 py-1.5 border border-brand-brown/20 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-brand-cream/10 text-xs transition-colors">
              <%= i %>
            </a>
          <% } %>
        <% } %>

        <% if (page < totalPages) { %>
          <a href="/poems?page=<%= page + 1 %>&sort=<%= sort %>" class="p-2 border border-brand-brown/20 text-gray-600 dark:text-gray-300 rounded-lg hover:bg-brand-cream/10 transition-colors">
            <i data-lucide="chevron-right" class="w-4 h-4"></i>
          </a>
        <% } %>
      </div>
    <% } %>

  <% } else { %>
    <!-- Empty State -->
    <div class="book-card p-16 text-center border border-brand-brown/10 dark:border-brand-brown/20 bg-white dark:bg-[#1E150F] max-w-2xl mx-auto space-y-5">
      <div class="w-16 h-16 rounded-full bg-brand-cream dark:bg-brand-brown/10 text-brand-brown dark:text-brand-pink flex items-center justify-center mx-auto shadow-sm">
        <i data-lucide="feather" class="w-8 h-8"></i>
      </div>
      <h3 class="font-serif text-2xl font-bold text-gray-800 dark:text-white">No Verses Yet</h3>
      <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed max-w-sm mx-auto">
        Be the first of your generation to submit a masterpiece. Write and publish a poem today to share with readers worldwide!
      </p>
      <a href="/poems/submit" class="inline-flex items-center gap-2 px-6 py-2.5 bg-brand-brown hover:bg-brand-accent text-white font-semibold rounded-lg text-xs shadow-md transition-all">
        <i data-lucide="plus" class="w-4 h-4"></i>
        Publish a Poem
      </a>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
