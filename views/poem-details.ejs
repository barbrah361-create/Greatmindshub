<%- include('partials/header') %>
<%- include('partials/navbar') %>
<%- include('partials/flash') %>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 flex-grow">
  
  <!-- Back Button -->
  <div class="mb-8">
    <a href="/poems" class="inline-flex items-center gap-1.5 text-xs text-gray-500 hover:text-brand-brown dark:hover:text-brand-pink transition-colors font-medium">
      <i data-lucide="chevron-left" class="w-4 h-4"></i>
      Back to Poem Collective
    </a>
  </div>

  <!-- Poem Presentation Card -->
  <article class="book-card p-8 sm:p-16 border border-brand-brown/10 dark:border-brand-brown/20 bg-white dark:bg-[#1E150F] shadow-md relative overflow-hidden mb-12">
    <!-- Style accents like a luxury printed page -->
    <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-brand-brown via-brand-pink to-brand-accent"></div>
    
    <div class="text-center mb-10">
      <span class="text-[10px] uppercase tracking-[0.25em] bg-brand-pink/20 text-brand-brown dark:text-brand-pink font-bold px-3 py-1 rounded-full border border-brand-pink/30 inline-block mb-4">
        <%= poem.genre || 'Poetry' %>
      </span>
      <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-extrabold text-gray-800 dark:text-white leading-tight mb-3">
        <%= poem.title %>
      </h1>
      <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 flex items-center justify-center gap-3">
        <span>Composed by 
          <% if (poem.authorId) { %>
            <a href="/authors/<%= poem.authorId %>" class="font-bold text-brand-brown dark:text-brand-pink text-sm hover:underline"><%= poem.authorName %></a>
          <% } else { %>
            <span class="font-bold text-brand-brown dark:text-brand-pink text-sm"><%= poem.authorName %></span>
          <% } %>
        </span>
        <% if (poem.authorId) { %>
          <form action="/authors/<%= poem.authorId %>/follow" method="POST" class="inline">
            <button type="submit" class="px-3 py-1 rounded-full bg-brand-pink/20 hover:bg-brand-pink/40 text-brand-brown dark:text-brand-pink text-[11px] font-bold border border-brand-pink/30 flex items-center gap-1">
              <i data-lucide="user-plus" class="w-3 h-3"></i>
              Follow Author
            </button>
          </form>
        <% } %>
      </p>
      <div class="w-16 h-px bg-brand-brown/20 dark:bg-brand-pink/20 mx-auto mt-6"></div>
    </div>

    <!-- Poem Content -->
    <div class="font-serif text-lg sm:text-xl text-gray-700 dark:text-gray-200 leading-loose italic max-w-lg mx-auto whitespace-pre-line text-center md:text-left md:pl-12 my-12 tracking-wide">
      <%= poem.content %>
    </div>

    <div class="w-full h-px bg-brand-brown/10 dark:bg-brand-pink/10 my-8"></div>

    <!-- Stats & Action Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div class="flex items-center gap-5 text-xs text-gray-500 dark:text-gray-400">
        <span class="flex items-center gap-1.5">
          <i data-lucide="eye" class="w-4 h-4 text-brand-brown dark:text-brand-pink"></i>
          <strong><%= poem.viewCount || 0 %></strong> Views
        </span>
        <span class="flex items-center gap-1.5">
          <i data-lucide="calendar" class="w-4 h-4 text-brand-brown dark:text-brand-pink"></i>
          Published <%= new Date(poem.createdAt).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' }) %>
        </span>
      </div>

      <div class="flex gap-2">
        <!-- Like Action Form -->
        <form action="/poems/<%= poem._id %>/like" method="POST" class="inline">
          <% const hasLiked = user && poem.likes && poem.likes.includes(user._id); %>
          <button type="submit" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs font-semibold shadow-sm border transition-all duration-200 <%= hasLiked ? 'bg-red-500 border-red-500 text-white hover:bg-red-600' : 'bg-brand-cream dark:bg-brand-brown/10 hover:bg-brand-pink/30 text-gray-700 dark:text-gray-200 border-brand-brown/15' %>">
            <i data-lucide="heart" class="w-4 h-4 <%= hasLiked ? 'fill-white' : 'text-red-500 fill-red-500/10' %>"></i>
            <%= hasLiked ? 'Liked' : 'Like Poem' %>
            <span class="font-bold pl-1 border-l border-current/25"><%= poem.likes ? poem.likes.length : 0 %></span>
          </button>
        </form>

        <button onclick="navigator.clipboard.writeText(window.location.href); alert('Poem link copied to clipboard!');" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-semibold shadow-sm border border-brand-brown/15 bg-brand-cream dark:bg-brand-brown/10 text-gray-750 dark:text-gray-200 hover:bg-brand-pink/30">
          <i data-lucide="share-2" class="w-4 h-4 text-brand-brown dark:text-brand-pink"></i>
          Share
        </button>
      </div>
    </div>
  </article>

  <!-- Comments / Discussion Section -->
  <section class="book-card p-6 sm:p-10 border border-brand-brown/10 dark:border-brand-brown/20 bg-white dark:bg-[#1E150F] shadow-sm rounded-2xl">
    <h3 class="font-serif text-2xl font-bold text-gray-800 dark:text-white mb-6 flex items-center gap-2.5">
      <i data-lucide="message-square" class="w-5.5 h-5.5 text-brand-brown dark:text-brand-pink"></i>
      Discussion & Replies
      <span class="text-xs bg-brand-pink/30 text-brand-brown dark:text-brand-pink px-2.5 py-0.5 rounded-full font-sans font-bold">
        <%= poem.comments ? poem.comments.length : 0 %>
      </span>
    </h3>

    <!-- Write a Comment Form -->
    <form action="/poems/<%= poem._id %>/comment" method="POST" class="space-y-4 mb-8">
      <% if (!user) { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="guestName" class="block text-xs uppercase tracking-wider font-bold text-gray-550 dark:text-gray-350 mb-1.5">Your Name (Optional)</label>
            <input type="text" id="guestName" name="guestName" placeholder="e.g. Anonymous Guest" class="w-full rounded-xl border border-brand-brown/20 dark:border-brand-brown/30 bg-brand-cream/30 dark:bg-brand-dark/20 px-4 py-2.5 text-sm focus:ring-2 focus:ring-brand-brown dark:focus:ring-brand-pink focus:outline-none dark:text-white leading-relaxed">
          </div>
          <div class="flex items-end pb-1.5">
            <span class="text-xs text-gray-400">You are posting as a guest. Or <a href="/auth/login" class="font-bold text-brand-brown dark:text-brand-pink hover:underline">Log in</a> to use your account.</span>
          </div>
        </div>
      <% } %>
      <div>
        <textarea id="comment-textarea" name="content" rows="3" required placeholder="Write a thoughtful critique or response to this poem..." class="w-full rounded-xl border border-brand-brown/20 dark:border-brand-brown/30 bg-brand-cream/30 dark:bg-brand-dark/20 p-4 text-sm focus:ring-2 focus:ring-brand-brown dark:focus:ring-brand-pink focus:outline-none dark:text-white leading-relaxed"></textarea>
      </div>
      <div class="flex justify-end">
        <button type="submit" class="inline-flex items-center gap-2 px-6 py-2.5 bg-brand-brown hover:bg-brand-accent text-white font-semibold rounded-xl text-xs transition-colors shadow-sm">
          Post Comment
        </button>
      </div>
    </form>

    <!-- Comments List with Replies -->
    <div class="space-y-6">
      <% if (poem.comments && poem.comments.length > 0) { %>
        <% poem.comments.forEach(function(comment) { %>
          <div class="border-b border-brand-brown/10 dark:border-brand-brown/15 pb-6 last:border-b-0 last:pb-0 space-y-3">
            <div class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-full bg-brand-cream border border-brand-brown/10 shadow-sm shrink-0 overflow-hidden flex items-center justify-center font-bold text-sm text-brand-brown dark:text-brand-pink">
                <% if (comment.userAvatar) { %>
                  <img src="<%= comment.userAvatar %>" alt="<%= comment.username %>" class="w-full h-full object-cover">
                <% } else { %>
                  <%= comment.username.substring(0, 2).toUpperCase() %>
                <% } %>
              </div>

              <div class="flex-grow">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2.5">
                    <span class="font-bold text-sm text-gray-800 dark:text-white"><%= comment.username %></span>
                    <span class="text-[10px] text-gray-400 font-medium"><%= new Date(comment.createdAt).toLocaleDateString(undefined, { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span>
                  </div>
                  
                  <button onclick="document.getElementById('replyBox-<%= comment._id %>').classList.toggle('hidden');" class="text-xs text-brand-brown dark:text-brand-pink font-semibold hover:underline flex items-center gap-1">
                    <i data-lucide="corner-up-left" class="w-3.5 h-3.5"></i> Reply
                  </button>
                </div>
                <p class="text-sm text-gray-600 dark:text-gray-300 mt-1 leading-relaxed">
                  <%= comment.content %>
                </p>

                <!-- Inline Reply Box -->
                <div id="replyBox-<%= comment._id %>" class="hidden mt-3 pt-3 border-t border-brand-brown/5">
                  <form action="/poems/<%= poem._id %>/comment/<%= comment._id %>/reply" method="POST" class="space-y-3">
                    <% if (!user) { %>
                      <input type="text" name="guestName" placeholder="Your Name" class="w-full px-3 py-1.5 rounded-lg border border-brand-brown/20 bg-brand-cream/20 text-xs text-gray-800 dark:text-white">
                    <% } %>
                    <textarea name="content" rows="2" required placeholder="Reply to <%= comment.username %>..." class="w-full p-3 rounded-xl border border-brand-brown/20 dark:border-brand-brown/30 bg-brand-cream/20 dark:bg-brand-dark/20 text-xs text-gray-800 dark:text-white focus:outline-none"></textarea>
                    <div class="flex justify-end gap-2">
                      <button type="button" onclick="document.getElementById('replyBox-<%= comment._id %>').classList.add('hidden');" class="px-3 py-1 text-xs text-gray-400 hover:underline">Cancel</button>
                      <button type="submit" class="px-4 py-1.5 bg-brand-brown text-white font-bold rounded-lg text-xs shadow">Submit Reply</button>
                    </div>
                  </form>
                </div>

                <!-- Nested Replies Threads -->
                <% if (comment.replies && comment.replies.length > 0) { %>
                  <div class="mt-4 space-y-3 pl-4 border-l-2 border-brand-pink/40 dark:border-brand-brown/20">
                    <% comment.replies.forEach(function(reply) { %>
                      <div class="flex items-start gap-2.5 text-xs bg-brand-cream/30 dark:bg-brand-brown/10 p-3 rounded-xl border border-brand-brown/5">
                        <div class="w-7 h-7 rounded-full bg-brand-cream overflow-hidden shrink-0 flex items-center justify-center font-bold text-[10px] text-brand-brown">
                          <% if (reply.userAvatar) { %>
                            <img src="<%= reply.userAvatar %>" alt="" class="w-full h-full object-cover">
                          <% } else { %>
                            <%= reply.username.substring(0, 2).toUpperCase() %>
                          <% } %>
                        </div>
                        <div>
                          <div class="flex items-center gap-2">
                            <span class="font-bold text-gray-800 dark:text-white"><%= reply.username %></span>
                            <span class="text-[9px] text-gray-400"><%= new Date(reply.createdAt).toLocaleDateString() %></span>
                          </div>
                          <p class="text-gray-600 dark:text-gray-300 mt-0.5 leading-relaxed"><%= reply.content %></p>
                        </div>
                      </div>
                    <% }) %>
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="text-center py-8 text-gray-400 text-xs">
          <p>No comments on this poem yet. Be the first to start the conversation!</p>
        </div>
      <% } %>
    </div>
  </section>
</div>

<%- include('partials/footer') %>
