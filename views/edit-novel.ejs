<%- include('partials/header') %>
<%- include('partials/navbar') %>
<%- include('partials/flash') %>

<!-- Quill Editor CSS -->
<link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet" />

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 flex-grow">
  
  <div class="mb-8 border-b border-brand-brown/10 dark:border-brand-brown/25 pb-6">
    <span class="text-brand-brown dark:text-brand-pink text-xs font-bold uppercase tracking-widest">Update Your Book</span>
    <h1 class="font-serif text-3xl sm:text-4xl font-bold text-gray-800 dark:text-white mt-2">Edit Novel</h1>
    <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">Update catalog information, rewrite pages, or manage chapters using the visual outline.</p>
  </div>

  <form id="editNovelForm" action="/novels/<%= novel._id %>/edit" method="POST" enctype="multipart/form-data" class="bg-white dark:bg-[#1E150F] p-6 sm:p-10 rounded-2xl shadow-sm border border-brand-brown/10 dark:border-brand-brown/20 space-y-6">
    
    <!-- Title -->
    <div>
      <label for="title" class="block text-xs uppercase tracking-wider font-bold text-gray-500 dark:text-gray-300 mb-2">Novel Title</label>
      <input type="text" id="title" name="title" required value="<%= novel.title %>" class="block w-full px-4 py-3 border border-brand-brown/20 dark:border-brand-brown/30 rounded-xl bg-brand-cream/10 text-gray-800 dark:text-white focus:outline-none focus:border-brand-brown dark:focus:border-brand-pink text-sm transition-all" placeholder="e.g. Whispers of the Savannah">
    </div>

    <!-- Genre & Year -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <div>
        <label for="genre" class="block text-xs uppercase tracking-wider font-bold text-gray-500 dark:text-gray-300 mb-2">Genre / Category</label>
        <select id="genre" name="genre" required class="block w-full px-4 py-3 border border-brand-brown/20 dark:border-brand-brown/30 rounded-xl bg-white dark:bg-[#1E150F] text-gray-800 dark:text-white focus:outline-none focus:border-brand-brown dark:focus:border-brand-pink text-sm transition-all">
          <% categories.forEach(function(category) { %>
            <option value="<%= category %>" <%= novel.genre === category ? 'selected' : '' %>><%= category %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label for="publicationYear" class="block text-xs uppercase tracking-wider font-bold text-gray-500 dark:text-gray-300 mb-2">Publication Year</label>
        <input type="number" id="publicationYear" name="publicationYear" required value="<%= novel.publicationYear %>" class="block w-full px-4 py-3 border border-brand-brown/20 dark:border-brand-brown/30 rounded-xl bg-brand-cream/10 text-gray-800 dark:text-white focus:outline-none focus:border-brand-brown dark:focus:border-brand-pink text-sm transition-all" placeholder="e.g. 2026">
      </div>
    </div>

    <!-- Cover Image & Short Description -->
    <div class="grid grid-cols-1 gap-6">
      <div>
        <label for="coverImage" class="block text-xs uppercase tracking-wider font-bold text-gray-500 dark:text-gray-300 mb-2">Book Cover Image</label>
        <% if (novel.coverImage) { %>
          <div class="flex items-center gap-4 mb-3 p-3 bg-brand-brown/5 rounded-xl border border-brand-brown/10">
            <img src="<%= novel.coverImage %>" alt="Cover" class="w-16 h-20 rounded object-cover shadow border border-brand-brown/10">
            <div class="text-xs text-gray-500">
              <p class="font-bold text-gray-700 dark:text-gray-300">Existing Cover Active</p>
              <p>Upload a new image to replace it.</p>
            </div>
          </div>
        <% } %>
        <input type="file" id="coverImage" name="coverImage" accept="image/*" class="block w-full text-sm text-gray-500 dark:text-gray-400 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-brand-brown file:text-white hover:file:bg-brand-accent">
        <p class="text-[10px] text-gray-400 mt-1.5">Supported: png, jpg, jpeg, webp. Limit 5MB.</p>
      </div>
      <div>
        <label for="description" class="block text-xs uppercase tracking-wider font-bold text-gray-500 dark:text-gray-300 mb-2">Short Description</label>
        <input type="text" id="description" name="description" required value="<%= novel.description %>" class="block w-full px-4 py-3 border border-brand-brown/20 dark:border-brand-brown/30 rounded-xl bg-brand-cream/10 text-gray-800 dark:text-white focus:outline-none focus:border-brand-brown dark:focus:border-brand-pink text-sm transition-all" placeholder="A brief hook (1-2 sentences) shown on catalog cards.">
      </div>
    </div>

    <!-- Synopsis -->
    <div>
      <label for="synopsis" class="block text-xs uppercase tracking-wider font-bold text-gray-500 dark:text-gray-300 mb-2">Synopsis / Plot Summary</label>
      <textarea id="synopsis" name="synopsis" rows="4" required class="block w-full px-4 py-3 border border-brand-brown/20 dark:border-brand-brown/30 rounded-xl bg-brand-cream/10 text-gray-800 dark:text-white placeholder-gray-400 focus:outline-none focus:border-brand-brown dark:focus:border-brand-pink text-sm transition-all" placeholder="Describe the story, the stakes, and major themes..."><%= novel.synopsis %></textarea>
    </div>

    <!-- Chapter Builder Section -->
    <div class="p-6 bg-brand-cream/10 dark:bg-brand-brown/5 rounded-2xl border border-brand-brown/15 dark:border-brand-brown/25">
      <div class="flex items-center justify-between border-b border-brand-brown/10 pb-3 mb-4">
        <h3 class="font-serif font-bold text-gray-800 dark:text-white text-base flex items-center gap-2">
          <i data-lucide="book-open" class="w-5 h-5 text-brand-brown dark:text-brand-pink"></i>
          Novel Chapter Builder
        </h3>
        <button type="button" id="addChapterBtn" class="inline-flex items-center gap-1 px-3 py-1.5 bg-brand-brown text-white text-xs font-semibold rounded-lg hover:bg-brand-accent transition-colors shadow">
          <i data-lucide="plus" class="w-3.5 h-3.5"></i> Add Chapter
        </button>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-start">
        <!-- Sidebar: Chapter List (Col span 4) -->
        <div class="md:col-span-4 bg-brand-cream/20 dark:bg-white/5 rounded-xl border border-brand-brown/10 p-4 space-y-3">
          <span class="text-[10px] font-bold uppercase tracking-wider text-gray-400">Chapters Outline</span>
          <div id="chapter-list" class="space-y-1.5 max-h-72 overflow-y-auto pr-1">
            <!-- Dynamically injected chapters -->
          </div>
        </div>

        <!-- Editor Pane: Current Chapter details (Col span 8) -->
        <div class="md:col-span-8 space-y-4">
          <div>
            <label class="block text-[10px] uppercase font-bold text-gray-400 mb-1">Current Chapter Heading</label>
            <input type="text" id="chapterTitleInput" placeholder="e.g. Chapter 1: The Departure" class="w-full rounded-lg border border-brand-brown/20 bg-white dark:bg-brand-dark/20 px-3.5 py-2 text-sm dark:text-white focus:ring-1 focus:ring-brand-brown focus:outline-none">
          </div>

          <div>
            <label class="block text-[10px] uppercase font-bold text-gray-400 mb-1">Chapter Content</label>
            <div id="toolbar-container" class="rounded-t-lg border border-brand-brown/20 bg-brand-pink/5">
              <span class="ql-formats">
                <button class="ql-bold"></button>
                <button class="ql-italic"></button>
                <button class="ql-underline"></button>
              </span>
              <span class="ql-formats">
                <select class="ql-align"></select>
              </span>
              <span class="ql-formats">
                <button class="ql-clean"></button>
              </span>
            </div>
            <div id="chapter-editor" class="min-h-[220px] max-h-[350px] overflow-y-auto rounded-b-lg border-x border-b border-brand-brown/20 bg-white font-serif text-base p-4 leading-relaxed"></div>
          </div>
          
          <div class="flex justify-between items-center text-xs">
            <button type="button" id="deleteChapterBtn" class="text-red-500 font-semibold hover:underline flex items-center gap-1">
              <i data-lucide="trash-2" class="w-3.5 h-3.5"></i> Delete Current Chapter
            </button>
            <span class="text-gray-400 font-mono" id="chapterCountLabel">Chapters: 1</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Hidden Textarea to submit compiled chapters -->
    <textarea id="contentText" name="contentText" class="hidden"></textarea>

    <!-- Footer buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-4 border-t border-brand-brown/10 dark:border-brand-brown/25">
      <a href="/novels/<%= novel._id %>" class="w-full sm:w-auto px-5 py-3 rounded-xl border border-brand-brown/20 text-gray-700 dark:text-gray-300 font-semibold text-sm hover:bg-brand-cream/10 text-center">Cancel</a>
      <button id="saveNovelBtn" type="submit" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3 bg-brand-brown hover:bg-brand-accent text-white font-semibold rounded-xl shadow-md hover:shadow-lg transition-all duration-200 text-sm">
        <i data-lucide="save" class="w-4 h-4"></i>
        Save Changes
      </button>
    </div>

  </form>
</div>

<!-- Danger Zone -->
<div class="mt-6 p-6 border border-red-200 dark:border-red-900/30 bg-red-50/15 dark:bg-red-950/10 rounded-2xl space-y-3">
  <h3 class="font-serif font-bold text-red-600 dark:text-red-400 text-sm flex items-center gap-2">
    <i data-lucide="trash-2" class="w-4 h-4"></i>
    Danger Zone
  </h3>
  <p class="text-xs text-gray-500 dark:text-gray-400">
    Permanently delete this novel and remove it from Readers Africa. This action is irreversible.
  </p>
  <form action="/novels/<%= novel._id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to permanently delete this novel? This action cannot be undone.');">
    <button type="submit" class="w-full sm:w-auto px-5 py-2.5 bg-red-600 hover:bg-red-700 text-white font-semibold rounded-xl text-xs shadow-sm transition-colors">
      Delete Novel
    </button>
  </form>
</div>

<!-- Quill Editor JS & Chapter Builder Logic -->
<script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Setup Quill Editor for Chapter Content
    const quill = new Quill('#chapter-editor', {
      theme: 'snow',
      modules: {
        toolbar: '#toolbar-container'
      }
    });

    // Parse chapters from EJS
    let chapters = [];
    <% if (novel.contentPages && novel.contentPages.length > 0) { %>
      <% novel.contentPages.forEach(function(pageContent, idx) { %>
        (function() {
          let pageHtml = `<%- pageContent.replace(/`/g, "\\`").replace(/<\/script>/gi, '') %>`;
          let title = "Chapter <%= idx + 1 %>";
          let content = pageHtml;
          
          let h2Match = pageHtml.match(/<h2>(.*?)<\/h2>/);
          if (h2Match) {
            title = h2Match[1];
            content = pageHtml.replace(/<h2>.*?<\/h2>/, '');
          }
          chapters.push({ title, content });
        })();
      <% }) %>
    <% } else { %>
      chapters.push({ title: 'Chapter 1: The Beginning', content: '<p>Compose chapter contents...</p>' });
    <% } %>

    let activeIndex = 0;

    const listContainer = document.getElementById('chapter-list');
    const titleInput = document.getElementById('chapterTitleInput');
    const deleteBtn = document.getElementById('deleteChapterBtn');
    const addBtn = document.getElementById('addChapterBtn');
    const countLabel = document.getElementById('chapterCountLabel');

    // Save current active chapter content
    function saveActiveChapter() {
      if (chapters[activeIndex]) {
        chapters[activeIndex].title = titleInput.value.trim() || `Chapter ${activeIndex + 1}`;
        chapters[activeIndex].content = quill.root.innerHTML;
      }
    }

    // Load active chapter details
    function loadActiveChapter() {
      if (chapters[activeIndex]) {
        titleInput.value = chapters[activeIndex].title;
        quill.root.innerHTML = chapters[activeIndex].content;
      }
      renderChapterList();
      countLabel.textContent = `Chapters: ${chapters.length}`;
    }

    // Render Sidebar list
    function renderChapterList() {
      listContainer.innerHTML = '';
      chapters.forEach((ch, idx) => {
        const item = document.createElement('button');
        item.type = 'button';
        item.className = `w-full text-left px-3 py-2 rounded-lg text-xs font-semibold flex items-center justify-between transition-colors truncate ${
          idx === activeIndex
            ? 'bg-brand-brown text-white shadow-sm'
            : 'bg-white dark:bg-brand-dark/20 text-gray-700 dark:text-gray-300 border border-brand-brown/5 dark:border-brand-brown/10 hover:bg-brand-pink/5'
        }`;
        item.innerHTML = `
          <span class="truncate flex items-center gap-1.5">
            <span class="opacity-60">${idx + 1}.</span>
            <span class="truncate">${ch.title}</span>
          </span>
        `;
        item.addEventListener('click', () => {
          saveActiveChapter();
          activeIndex = idx;
          loadActiveChapter();
        });
        listContainer.appendChild(item);
      });
    }

    // Add new chapter
    addBtn.addEventListener('click', () => {
      saveActiveChapter();
      chapters.push({
        title: `Chapter ${chapters.length + 1}: Title`,
        content: '<p>Compose new chapter details...</p>'
      });
      activeIndex = chapters.length - 1;
      loadActiveChapter();
    });

    // Delete current active chapter
    deleteBtn.addEventListener('click', () => {
      if (chapters.length <= 1) {
        alert('You must have at least one chapter in your novel!');
        return;
      }
      if (confirm('Are you sure you want to delete this chapter?')) {
        chapters.splice(activeIndex, 1);
        activeIndex = Math.max(0, activeIndex - 1);
        loadActiveChapter();
      }
    });

    // Initialize list
    loadActiveChapter();

    // Form Submission Handling
    const form = document.getElementById('editNovelForm');
    const saveBtn = document.getElementById('saveNovelBtn');

    if (form && saveBtn) {
      form.addEventListener('submit', (event) => {
        saveActiveChapter();

        // Compile chapters with delimiter \n\n---PAGE---\n\n
        const compiledPages = chapters.map(ch => {
          return `<h2>${ch.title}</h2>\n\n${ch.content}`;
        }).join('\n\n---PAGE---\n\n');

        document.getElementById('contentText').value = compiledPages;

        saveBtn.disabled = true;
        saveBtn.innerHTML = '<i class="animate-spin rounded-full h-4 w-4 border-2 border-white border-t-transparent mr-2"></i>Saving...';
      });
    }
  });
</script>

<%- include('partials/footer') %>
