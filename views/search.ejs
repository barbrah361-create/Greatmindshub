<%- include('partials/header') %>
<%- include('partials/navbar') %>
<%- include('partials/flash') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 flex-grow">
  <div class="rounded-3xl border border-brand-brown/10 bg-white dark:bg-[#1E150F] p-8 shadow-sm">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-xs uppercase tracking-[0.28em] text-brand-brown/70 dark:text-brand-pink/70">Discover</p>
        <h1 class="font-serif text-3xl font-bold text-gray-900 dark:text-brand-pink">Search the Readers ecosystem</h1>
        <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">Find novels, authors, poems, and curated reading paths in one place.</p>
      </div>
      <form action="/search" method="GET" class="w-full md:w-auto">
        <div class="flex gap-2">
          <input type="search" name="q" value="<%= query %>" placeholder="Search books and authors" class="w-full md:w-80 px-4 py-3 rounded-2xl border border-brand-brown/20 bg-brand-cream/40" />
          <button class="px-4 py-3 rounded-2xl bg-brand-brown text-white">Go</button>
        </div>
      </form>
    </div>
  </div>

  <% if (recommendationCards && recommendationCards.length > 0) { %>
    <div class="mt-8 rounded-3xl border border-brand-brown/10 bg-white dark:bg-[#1E150F] p-6 shadow-sm">
      <h2 class="font-serif text-xl font-bold text-gray-900 dark:text-brand-pink">Recommended for you</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        <% recommendationCards.forEach(function(card) { %>
          <div class="rounded-2xl border border-brand-brown/10 bg-brand-cream/40 p-4">
            <p class="text-sm font-semibold text-brand-brown"><%= card.title %></p>
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-300"><%= card.summary %></p>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>

  <div class="mt-8 grid gap-8 lg:grid-cols-3">
    <div class="lg:col-span-3 rounded-3xl border border-brand-brown/10 bg-white dark:bg-[#1E150F] p-6 shadow-sm">
      <h2 class="font-serif text-xl font-bold text-gray-900 dark:text-brand-pink">Results</h2>
      <% if (results.novels.length === 0 && results.authors.length === 0 && results.poems.length === 0) { %>
        <p class="mt-4 text-sm text-gray-500">No results yet. Try a broader search term or browse the library.</p>
      <% } %>
      <div class="mt-6 space-y-6">
        <% if (results.novels.length > 0) { %>
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-[0.24em] text-brand-brown/70">Novels</h3>
            <div class="mt-3 grid gap-3 md:grid-cols-2">
              <% results.novels.forEach(function(novel) { %>
                <a href="/novels/<%= novel._id %>" class="rounded-2xl border border-brand-brown/10 p-4 hover:border-brand-pink">
                  <p class="font-semibold text-gray-900 dark:text-white"><%= novel.title %></p>
                  <p class="text-sm text-gray-500"><%= novel.authorName %> • <%= novel.genre %></p>
                </a>
              <% }) %>
            </div>
          </div>
        <% } %>
        <% if (results.authors.length > 0) { %>
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-[0.24em] text-brand-brown/70">Authors</h3>
            <div class="mt-3 grid gap-3 md:grid-cols-2">
              <% results.authors.forEach(function(author) { %>
                <a href="/authors/<%= author._id %>" class="rounded-2xl border border-brand-brown/10 p-4 hover:border-brand-pink">
                  <p class="font-semibold text-gray-900 dark:text-white"><%= author.name %></p>
                  <p class="text-sm text-gray-500"><%= author.nationality %></p>
                </a>
              <% }) %>
            </div>
          </div>
        <% } %>
        <% if (results.poems.length > 0) { %>
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-[0.24em] text-brand-brown/70">Poems</h3>
            <div class="mt-3 grid gap-3 md:grid-cols-2">
              <% results.poems.forEach(function(poem) { %>
                <a href="/poems/<%= poem._id %>" class="rounded-2xl border border-brand-brown/10 p-4 hover:border-brand-pink">
                  <p class="font-semibold text-gray-900 dark:text-white"><%= poem.title %></p>
                  <p class="text-sm text-gray-500"><%= poem.authorName %></p>
                </a>
              <% }) %>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
