<%- include('partials/header') %>
<%- include('partials/navbar') %>
<%- include('partials/flash') %>

<div class="max-w-6xl mx-auto px-4 py-12">
  <div class="rounded-3xl border border-brand-brown/10 bg-white dark:bg-[#1E150F] p-8 shadow-sm">
    <h1 class="font-serif text-3xl font-bold text-gray-900 dark:text-brand-pink">Notifications</h1>
    <div class="mt-6 space-y-3">
      <% if (notifications && notifications.length > 0) { %>
        <% notifications.forEach(function(item) { %>
          <div class="rounded-2xl border border-brand-brown/10 bg-brand-cream/40 p-4">
            <p class="font-semibold text-gray-900 dark:text-white"><%= item.title || 'New activity' %></p>
            <p class="mt-1 text-sm text-gray-500"><%= item.message || 'You have a fresh update.' %></p>
          </div>
        <% }) %>
      <% } else { %>
        <p class="text-sm text-gray-500">You are all caught up. New follower updates and community announcements will appear here.</p>
      <% } %>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
