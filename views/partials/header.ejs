<!DOCTYPE html>
<html lang="en" class="<%= darkMode ? 'dark' : '' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'Readers - Africa\'s largest online reading, writing and publishing community. Discover novels, poetry, and world-class authors.' %>">
  <meta name="theme-color" content="#6F4E37">
  <link rel="canonical" href="<%= typeof canonical !== 'undefined' ? canonical : (appUrl + currentPath) %>">
  <link rel="icon" type="image/jpeg" sizes="32x32" href="/favicon.png">
  <link rel="icon" type="image/jpeg" sizes="192x192" href="/icon-192.png">
  <link rel="icon" type="image/jpeg" sizes="512x512" href="/icon-512.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.json">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Readers">
  <meta property="og:title" content="<%= typeof title !== 'undefined' ? title + ' | Readers' : 'Readers - Digital Library & Writing Community' %>">
  <meta property="og:description" content="<%= typeof description !== 'undefined' ? description : 'Africa\'s largest online reading, writing and publishing community' %>">
  <meta property="og:image" content="<%= appUrl %>/logo.jpg">
  <meta name="twitter:card" content="summary_large_image">
  <title><%= typeof title !== 'undefined' ? title + ' | Readers' : 'Readers - Digital Library & Writing Community' %></title>
  
  <!-- Typography & Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS v4 via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Tailwind Configuration -->
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              brown: '#D14D2A',
              pink: '#F7F3EE',
              cream: '#FDFCF8',
              accent: '#F9A826',
              dark: '#1E150F'
            }
          },
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            serif: ['Playfair Display', 'serif'],
            mono: ['JetBrains Mono', 'monospace']
          }
        }
      }
    }
  </script>

  <!-- Lucide Icons CDN -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <!-- Custom Dark Mode Setup (Anti-Flicker) -->
  <script>
    // Inline script to prevent theme flickering (Elegant Dark)
    const getTheme = () => {
      const stored = document.cookie.split('; ').find(row => row.startsWith('darkMode='));
      if (stored) {
        return stored.split('=')[1] === 'true' ? 'dark' : 'light';
      }
      return 'dark';
    };
    if (getTheme() === 'dark') {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  </script>

  <!-- Page Loader Animation Styling -->
  <style>
    /* Premium smooth transitions */
    * {
      transition-property: background-color, border-color, text-decoration-color, fill, stroke;
      transition-duration: 200ms;
      transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    :root {
      --brown: #D14D2A;
      --pink: #F7F3EE;
      --cream: #FDFCF8;
      --white: #FFFFFF;
      --text: #1A1A1A;
    }

    html {
      -webkit-text-size-adjust: 100%;
      scroll-behavior: smooth;
      overflow-x: hidden;
      overflow-y: auto !important;
      height: auto;
      min-height: 100%;
    }

    body {
      -webkit-tap-highlight-color: transparent;
      touch-action: pan-y;
      overflow-x: hidden;
      overflow-y: auto !important;
      min-height: 100vh;
      -webkit-overflow-scrolling: touch;
      position: relative;
    }

    img, svg, video, canvas {
      max-width: 100%;
      height: auto;
      display: block;
    }

    button, input, select, textarea {
      font: inherit;
    }

    /* =====================================================
       GLOBAL RESPONSIVE SYSTEM — phones / tablets / laptops
       ===================================================== */

    /* Prevent any element from overflowing horizontally while allowing vertical scroll */
    *, *::before, *::after { box-sizing: border-box; }
    html, body {
      max-width: 100%;
      overflow-x: hidden;
    }

    /* All images & embeds stay within their container */
    img, video, iframe, embed, object, canvas, svg {
      max-width: 100%;
      height: auto;
    }

    /* Tables scroll horizontally instead of breaking layout */
    table { display: block; overflow-x: auto; white-space: nowrap; }
    table.normal-table { display: table; white-space: normal; }

    /* Ensure no fixed-width causes overflow */
    .overflow-x-auto { -webkit-overflow-scrolling: touch; }

    /* ---- PHONE  (≤ 639px) ---- */
    @media (max-width: 639px) {
      body { font-size: 14px; }

      /* Collapse multi-col grids to single column */
      [class*="grid-cols-"]:not([class*="sm:"]):not([class*="md:"]):not([class*="lg:"]) {
        grid-template-columns: 1fr !important;
      }

      /* Typography scale-down */
      h1 { font-size: clamp(1.6rem, 7vw, 2.4rem) !important; line-height: 1.2 !important; }
      h2 { font-size: clamp(1.25rem, 5.5vw, 1.8rem) !important; }
      h3 { font-size: clamp(1rem, 4vw, 1.35rem) !important; }

      /* Section padding */
      section, .py-24 { padding-top: 3rem !important; padding-bottom: 3rem !important; }
      .py-16 { padding-top: 2.5rem !important; padding-bottom: 2.5rem !important; }
      .px-8 { padding-left: 1rem !important; padding-right: 1rem !important; }

      /* Full-width buttons on mobile */
      .btn-responsive, .mobile-full { display: block !important; width: 100% !important; }

      /* Inputs & selects full width */
      .input-responsive { width: 100% !important; }

      /* Stack flex rows vertically */
      .flex-row-mobile { flex-direction: column !important; }

      /* Modals: near-full width */
      .modal-responsive, [class*="max-w-"][class*="modal"] {
        max-width: 95vw !important;
        margin-left: 0.75rem !important;
        margin-right: 0.75rem !important;
      }

      /* Hero height: avoid content cut on small phones */
      .h-screen { min-height: 100svh; }

      /* Make hero text comfortable */
      .hero-content { padding: 0 1rem !important; }

      /* Cards: remove excess horizontal padding */
      .book-card, .glass-card { padding: 1rem !important; }

      /* Gap reduction on tiny screens */
      .gap-8 { gap: 1.25rem !important; }
      .gap-6 { gap: 1rem !important; }

      /* Prevent long words breaking layouts */
      p, span, a, li, td, th { word-break: break-word; overflow-wrap: break-word; }

      /* Touch-friendly tap targets (min 44×44px) */
      a, button, [role="button"] { min-height: 36px; }

      /* Profile / dashboard grid: always stack */
      .profile-grid, .dashboard-grid { grid-template-columns: 1fr !important; }

      /* Poem & novel cards: full width on phone */
      .poem-card, .novel-card { width: 100% !important; min-width: unset !important; }

      /* Tab pills: allow horizontal scroll */
      .tab-scroll { overflow-x: auto; flex-wrap: nowrap !important; -webkit-overflow-scrolling: touch; }

      /* Footer: single column */
      footer .grid { grid-template-columns: 1fr !important; }

      /* Hide decorative-only wide elements */
      .decorative-wide { display: none !important; }

      /* Poem filters: stack vertically */
      .poem-filters { flex-direction: column !important; align-items: stretch !important; }
    }

    /* ---- TABLET  (640px – 1023px) ---- */
    @media (min-width: 640px) and (max-width: 1023px) {
      body { font-size: 15px; }

      /* 3-col grids → 2-col on tablet */
      .lg\:grid-cols-3:not([class*="md:grid-cols"]),
      .lg\:grid-cols-4:not([class*="md:grid-cols"]) {
        grid-template-columns: repeat(2, 1fr) !important;
      }

      /* 4-col → 2-col */
      .xl\:grid-cols-4 { grid-template-columns: repeat(2, 1fr) !important; }

      /* Section padding */
      section, .py-24 { padding-top: 4rem !important; padding-bottom: 4rem !important; }

      /* Navbar: ensure no overflow */
      nav { overflow: hidden; }

      /* Cards: comfortable padding */
      .book-card, .glass-card { padding: 1.25rem !important; }

      /* Hero text */
      h1 { font-size: clamp(2rem, 5vw, 3.5rem) !important; }
    }

    /* ---- LARGE TABLET / SMALL LAPTOP (1024px – 1279px) ---- */
    @media (min-width: 1024px) and (max-width: 1279px) {
      /* Tighten navbar link padding */
      nav a { padding-left: 0.5rem !important; padding-right: 0.5rem !important; }
    }

    /* ---- SAFE SVH for all mobile browsers ---- */
    @supports (height: 100svh) {
      .h-screen { height: 100svh; }
      .min-h-screen { min-height: 100svh; }
    }

    /* Utilities */
    .mobile-safe-stack { grid-template-columns: 1fr !important; }
    .btn-responsive { display: block !important; width: 100% !important; }
    .input-responsive { width: 100% !important; }
    .modal-responsive { max-width: 95vw !important; margin: 0 0.75rem !important; }

    /* Elegant Theme Utility Classes */
    .btn-brown {
      background-color: var(--brown);
      color: var(--white);
      transition: all 0.3s ease;
    }
    .btn-brown:hover {
      background-color: #A93315;
    }
    .btn-pink {
      background-color: var(--pink);
      color: var(--brown);
      transition: all 0.3s ease;
    }
    .btn-pink:hover {
      background-color: #ffffff;
      color: var(--brown);
    }
    .book-card {
      background-color: var(--white);
      border-radius: 16px;
      box-shadow: 0 4px 20px rgba(120, 53, 15, 0.05);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      border: 1px solid rgba(120, 53, 15, 0.08);
    }
    .dark .book-card {
      background-color: #161513;
      box-shadow: 0 4px 25px rgba(0, 0, 0, 0.5);
      border: 1px solid rgba(245, 236, 227, 0.1);
    }
    .author-pill {
      background-color: rgba(245, 236, 227, 0.15);
      border: 1px solid rgba(245, 236, 227, 0.3);
      border-radius: 9999px;
      transition: all 0.3s ease;
    }
    .dark .author-pill {
      background-color: rgba(245, 236, 227, 0.05);
      border: 1px solid rgba(245, 236, 227, 0.15);
    }
    .category-badge {
      background-color: var(--white);
      border: 1px solid var(--brown);
      font-size: 10px;
      text-transform: uppercase;
      color: var(--brown);
    }
    .dark .category-badge {
      background-color: #161513;
      border: 1px solid var(--pink);
      color: var(--pink);
    }
    .hero-overlay {
      background: linear-gradient(rgba(120, 53, 15, 0.85), rgba(26, 26, 26, 0.95));
      border-radius: 24px;
    }
    
    /* Scrollbar hide helper */
    .scrollbar-hide::-webkit-scrollbar {
      display: none;
    }
    .scrollbar-hide {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
 
    .library-loader {
      position: fixed;
      inset: 0;
      background-color: #FDFCF8; /* Cream */
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 9999;
      transition: opacity 0.5s ease, visibility 0.5s ease;
    }
    .dark .library-loader {
      background-color: #0F0E0D; /* Dark charcoal */
    }
    .glass-card {
      background: rgba(253, 252, 248, 0.7);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(209, 77, 42, 0.1);
      border-radius: 16px;
    }
    .dark .glass-card {
      background: rgba(22, 21, 19, 0.7);
      border: 1px solid rgba(247, 243, 238, 0.1);
    }
    .skeleton {
      background: linear-gradient(90deg, #f7f3ee 25%, #fdfcf8 50%, #f7f3ee 75%);
      background-size: 200% 100%;
      animation: shimmer 1.5s infinite;
      border-radius: 8px;
    }
    @keyframes shimmer {
      0% { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }
    .library-loader.hidden-loader {
      opacity: 0;
      visibility: hidden;
      pointer-events: none !important;
      display: none !important;
    }
  </style>
</head>
<body class="bg-[#FDFCF8] dark:bg-[#0F0E0D] text-[#1A1A1A] dark:text-[#EAE6DF] font-sans min-h-screen flex flex-col selection:bg-brand-pink/60 selection:text-brand-dark w-full">
  
  <!-- Loading Animation -->
  <div id="app-loader" class="library-loader">
    <div class="flex flex-col items-center">
      <div class="w-16 h-16 border-4 border-brand-brown border-t-brand-pink rounded-full animate-spin"></div>
      <h2 class="text-brand-brown dark:text-brand-pink font-serif text-xl mt-6 tracking-wide animate-pulse">Opening the Library Gates...</h2>
    </div>
  </div>

  <script>
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js').catch(() => {});
    }
    
    function hideLoader() {
      const loader = document.getElementById('app-loader');
      if (loader) {
        loader.classList.add('hidden-loader');
        loader.style.pointerEvents = 'none';
        loader.style.display = 'none';
      }
    }

    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      hideLoader();
    } else {
      window.addEventListener('DOMContentLoaded', hideLoader);
      window.addEventListener('load', hideLoader);
      setTimeout(hideLoader, 500);
    }
  </script>
