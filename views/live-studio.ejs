<%- include('partials/header') %>
<%- include('partials/navbar') %>
<%- include('partials/flash') %>

<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex-grow">
  
  <!-- Header -->
  <div class="mb-8 text-center sm:text-left flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-brand-brown/10 dark:border-brand-brown/20 pb-6">
    <div>
      <a href="/live" class="text-xs font-semibold text-brand-brown dark:text-brand-pink hover:underline flex items-center gap-1 mb-2">&larr; Back to Live Stage</a>
      <h1 class="font-serif text-3xl sm:text-4xl font-bold text-gray-800 dark:text-brand-pink flex items-center gap-3">
        <i data-lucide="video" class="w-8 h-8 text-red-500"></i>
        Live TikTok Studio & Face Filter Controls
      </h1>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Preview your live camera in selfie mirror mode, test real-time beauty filters, select your poem or book, and go live.</p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    
    <!-- LEFT: Camera Preview & Filter Toolbar (Col span 6) -->
    <div class="lg:col-span-6 space-y-5">
      
      <!-- Video Container with Live Filters -->
      <div class="relative bg-black rounded-3xl overflow-hidden aspect-video shadow-2xl border-2 border-brand-brown/20 flex items-center justify-center group">
        <video id="studioWebcam" autoplay playsinline muted class="w-full h-full object-cover hidden transition-all duration-300 transform -scale-x-100"></video>
        <canvas id="studioAudioWave" class="absolute bottom-0 left-0 right-0 h-16 pointer-events-none z-10 hidden"></canvas>

        <div id="camPlaceholder" class="text-center p-8 space-y-4">
          <div class="w-20 h-20 rounded-full bg-red-500/10 text-red-500 flex items-center justify-center mx-auto animate-pulse ring-4 ring-red-500/20">
            <i data-lucide="camera" class="w-10 h-10"></i>
          </div>
          <div>
            <h3 class="font-serif text-xl font-bold text-white">Live Camera Preview</h3>
            <p class="text-xs text-gray-400 mt-1">Tap below to open your camera in TikTok selfie mirror mode.</p>
          </div>
          <button type="button" onclick="enableCamera()" class="px-6 py-3 bg-red-600 hover:bg-red-700 text-white font-bold rounded-2xl shadow-xl hover:shadow-red-500/30 transition-all text-xs inline-flex items-center gap-2">
            <i data-lucide="video" class="w-4 h-4"></i> Turn On Camera & Microphone
          </button>
        </div>

        <span class="absolute top-4 left-4 bg-red-600 text-white text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-wider shadow-md">
          STUDIO PREVIEW
        </span>

        <!-- Camera Switcher & Active Filter Badge Overlay -->
        <div class="absolute top-4 right-4 flex items-center gap-1.5 z-20">
          <button type="button" onclick="switchStudioCamera()" class="bg-black/60 backdrop-blur hover:bg-black/80 text-amber-400 text-[10px] font-bold px-2.5 py-1 rounded-full border border-white/10 uppercase tracking-wider flex items-center gap-1">
            <i data-lucide="camera" class="w-3 h-3"></i> Switch Cam
          </button>
          <span id="activeFilterLabel" class="bg-black/60 backdrop-blur text-brand-pink text-[10px] font-bold px-3 py-1 rounded-full border border-white/10 uppercase tracking-wider">
            Filter: Glam Glow
          </span>
        </div>
      </div>

      <!-- Real-Time Beauty Face Filter Toolbar -->
      <div class="bg-white dark:bg-[#1E150F] p-5 rounded-2xl border border-brand-brown/10 dark:border-brand-brown/20 shadow-sm space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 flex items-center gap-1.5">
            <i data-lucide="sparkles" class="w-4 h-4 text-amber-500"></i>
            Real-Time TikTok Beauty Filters
          </span>
          <span class="text-[10px] text-gray-400">Tap filter to test live</span>
        </div>

        <div class="grid grid-cols-3 sm:grid-cols-5 gap-2">
          <button type="button" onclick="applyFilter('glam', 'Glam Glow')" class="filter-btn py-2 px-3 rounded-xl border border-brand-brown/20 bg-brand-cream/30 text-xs font-semibold text-gray-800 dark:text-white hover:bg-brand-brown hover:text-white transition-colors active">
            🌟 Glam Glow
          </button>
          <button type="button" onclick="applyFilter('none', 'Natural')" class="filter-btn py-2 px-3 rounded-xl border border-brand-brown/20 bg-brand-cream/30 text-xs font-semibold text-gray-800 dark:text-white hover:bg-brand-brown hover:text-white transition-colors">
            ✨ Natural
          </button>
          <button type="button" onclick="applyFilter('golden', 'Golden Hour')" class="filter-btn py-2 px-3 rounded-xl border border-brand-brown/20 bg-brand-cream/30 text-xs font-semibold text-gray-800 dark:text-white hover:bg-brand-brown hover:text-white transition-colors">
            🌅 Golden
          </button>
          <button type="button" onclick="applyFilter('vibrant', 'Vibrant HD')" class="filter-btn py-2 px-3 rounded-xl border border-brand-brown/20 bg-brand-cream/30 text-xs font-semibold text-gray-800 dark:text-white hover:bg-brand-brown hover:text-white transition-colors">
            🎨 Vibrant
          </button>
          <button type="button" onclick="applyFilter('noir', 'Poetic Noir')" class="filter-btn py-2 px-3 rounded-xl border border-brand-brown/20 bg-brand-cream/30 text-xs font-semibold text-gray-800 dark:text-white hover:bg-brand-brown hover:text-white transition-colors">
            🎬 Noir B&W
          </button>
        </div>
      </div>

    </div>

    <!-- RIGHT: Live Broadcast Setup Form (Col span 6) -->
    <div class="lg:col-span-6 bg-white dark:bg-[#1E150F] p-6 sm:p-8 rounded-3xl border border-brand-brown/10 dark:border-brand-brown/20 shadow-sm">
      <form action="/live/create" method="POST" class="space-y-5">
        
        <input type="hidden" id="selectedFilterInput" name="filter" value="glam">

        <div>
          <label for="title" class="block text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-2">Broadcasting Title</label>
          <input type="text" id="title" name="title" required placeholder="e.g. Reciting My Latest Verse Live" class="block w-full px-4 py-3 border border-brand-brown/20 dark:border-brand-brown/30 rounded-xl bg-brand-cream/10 text-gray-800 dark:text-white text-sm focus:outline-none focus:border-brand-brown">
        </div>

        <div>
          <label for="type" class="block text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-2">Recitation Category</label>
          <select id="type" name="type" class="block w-full px-4 py-3 border border-brand-brown/20 dark:border-brand-brown/30 rounded-xl bg-white dark:bg-[#1E150F] text-gray-800 dark:text-white text-sm focus:outline-none focus:border-brand-brown">
            <option value="poem">Poetry Recitation</option>
            <option value="novel">Book Reading Session</option>
          </select>
        </div>

        <% if (userPoems && userPoems.length > 0) { %>
          <div>
            <label for="selectedWorkId" class="block text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-2">Select Your Published Poem to Read</label>
            <select id="selectedWorkId" name="selectedWorkId" class="block w-full px-4 py-3 border border-brand-brown/20 dark:border-brand-brown/30 rounded-xl bg-white dark:bg-[#1E150F] text-gray-800 dark:text-white text-sm focus:outline-none focus:border-brand-brown">
              <option value="">-- Custom Text or Live Freestyle --</option>
              <% userPoems.forEach(function(p) { %>
                <option value="<%= p._id %>"><%= p.title %></option>
              <% }) %>
            </select>
          </div>
        <% } %>

        <div>
          <label for="customText" class="block text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-2">Live Teleprompter / Verse Text</label>
          <textarea id="customText" name="customText" rows="4" placeholder="Paste the verse or prose text here so followers can read along live with you..." class="block w-full p-4 border border-brand-brown/20 dark:border-brand-brown/30 rounded-xl bg-brand-cream/10 text-gray-800 dark:text-white text-sm focus:outline-none focus:border-brand-brown"></textarea>
        </div>
        <!-- Notify Followers Toggle -->
        <div class="flex items-center justify-between p-4 bg-red-50 dark:bg-red-950/20 rounded-xl border border-red-200 dark:border-red-800">
          <div class="flex items-center gap-3">
            <i data-lucide="bell-ring" class="w-5 h-5 text-red-500"></i>
            <div>
              <span class="text-sm font-bold text-gray-800 dark:text-white">Notify my followers</span>
              <p class="text-[10px] text-gray-500 dark:text-gray-400">All your followers will receive a "🔴 LIVE" notification</p>
            </div>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" name="notifyFollowers" value="true" class="sr-only peer" checked>
            <div class="w-9 h-5 bg-gray-200 peer-focus:outline-none rounded-full peer dark:bg-gray-700 peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-red-600"></div>
          </label>
        </div>

        <!-- Gift Points Info -->
        <div class="p-4 bg-amber-50 dark:bg-amber-950/20 rounded-xl border border-amber-200 dark:border-amber-800 flex items-start gap-3">
          <i data-lucide="gift" class="w-5 h-5 text-amber-500 shrink-0 mt-0.5"></i>
          <div class="text-xs text-amber-700 dark:text-amber-300">
            <p class="font-bold">Earn Gift Points Live!</p>
            <p class="mt-0.5">Viewers can send you 🌹 Roses, 📚 Books, 💎 Diamonds, 👑 Crowns, ⭐ Stars, and 🌍 Universes. Points boost your viral limelight score!</p>
          </div>
        </div>

        <button type="submit" class="w-full py-4 bg-red-600 hover:bg-red-700 text-white font-bold rounded-2xl shadow-lg hover:shadow-red-500/25 text-sm transition-all flex items-center justify-center gap-2">
          <i data-lucide="video" class="w-5 h-5"></i>
          Start Live Recitation Broadcast
        </button>

      </form>
    </div>

  </div>

</div>

<style>
/* Beauty Face Filter Styles */
.filter-glam {
  filter: contrast(1.06) brightness(1.12) saturate(1.18) blur(0.2px) !important;
}
.filter-golden {
  filter: sepia(0.25) contrast(1.1) brightness(1.08) saturate(1.25) hue-rotate(-10deg) !important;
}
.filter-vibrant {
  filter: saturate(1.4) contrast(1.1) brightness(1.05) !important;
}
.filter-noir {
  filter: grayscale(1) contrast(1.25) brightness(1.05) !important;
}
</style>

<script>
let activeFilter = 'glam';
let studioCameras = [];
let studioCameraIndex = 0;
let studioStream = null;

function applyFilter(filterName, label) {
  activeFilter = filterName;
  const video = document.getElementById('studioWebcam');
  document.getElementById('selectedFilterInput').value = filterName;
  document.getElementById('activeFilterLabel').innerText = 'Filter: ' + label;

  video.className = 'w-full h-full object-cover transition-all duration-300 transform -scale-x-100';
  if (filterName !== 'none') {
    video.classList.add('filter-' + filterName);
  }
}

async function loadStudioCameras() {
  try {
    const devices = await navigator.mediaDevices.enumerateDevices();
    studioCameras = devices.filter(d => d.kind === 'videoinput');
    
    // Prefer built-in laptop camera if Iriun/virtual is default
    const builtInIndex = studioCameras.findIndex(d => 
      d.label.toLowerCase().includes('integrated') || 
      d.label.toLowerCase().includes('built-in') || 
      d.label.toLowerCase().includes('hd') ||
      d.label.toLowerCase().includes('webcam') && !d.label.toLowerCase().includes('iriun')
    );
    if (builtInIndex > 0) {
      studioCameraIndex = builtInIndex;
    }
  } catch (err) {
    console.warn('Could not enumerate studio cameras:', err);
  }
}

async function enableCamera(deviceId = null) {
  try {
    if (studioStream) {
      studioStream.getTracks().forEach(t => t.stop());
    }

    const videoConstraints = {
      width: { ideal: 1280 },
      height: { ideal: 720 }
    };

    if (deviceId) {
      videoConstraints.deviceId = { exact: deviceId };
    } else if (studioCameras.length > 0 && studioCameras[studioCameraIndex]) {
      videoConstraints.deviceId = { exact: studioCameras[studioCameraIndex].deviceId };
    } else {
      videoConstraints.facingMode = "user";
    }

    const stream = await navigator.mediaDevices.getUserMedia({
      video: videoConstraints,
      audio: true
    });

    studioStream = stream;
    const video = document.getElementById('studioWebcam');
    const placeholder = document.getElementById('camPlaceholder');
    video.srcObject = stream;
    await video.play();
    video.classList.remove('hidden');
    placeholder.classList.add('hidden');
    applyFilter(activeFilter, 'Glam Glow');

    await loadStudioCameras();
  } catch (err) {
    console.warn('Primary camera failed, falling back:', err);
    try {
      const fallbackStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: true });
      studioStream = fallbackStream;
      const video = document.getElementById('studioWebcam');
      const placeholder = document.getElementById('camPlaceholder');
      video.srcObject = fallbackStream;
      await video.play();
      video.classList.remove('hidden');
      placeholder.classList.add('hidden');
    } catch (e) {
      alert('Camera access note: Please grant camera permissions in your browser address bar.');
    }
  }
}

async function switchStudioCamera() {
  await loadStudioCameras();
  if (studioCameras.length <= 1) {
    alert('Only 1 camera detected.');
    return;
  }
  studioCameraIndex = (studioCameraIndex + 1) % studioCameras.length;
  await enableCamera(studioCameras[studioCameraIndex].deviceId);
}

window.addEventListener('DOMContentLoaded', async () => {
  await loadStudioCameras();
  enableCamera();
});
</script>

<%- include('partials/footer') %>
