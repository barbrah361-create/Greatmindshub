<%- include('partials/header') %>
<%- include('partials/navbar') %>
<%- include('partials/flash') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 flex-grow">
  <!-- Real-time toasts container -->
  <div id="realtimeToasts" class="fixed top-6 right-6 z-50 flex flex-col gap-3"></div>
  
  <!-- 1. Welcome Header Banner -->
  <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-brand-brown to-brand-dark text-white p-8 sm:p-12 shadow-md mb-12 border-2 border-brand-pink/10">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(247,214,224,0.15),transparent_50%)]"></div>
    <div class="relative z-10 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-6 text-center sm:text-left flex-col sm:flex-row">
        <img src="<%= user.avatar || '/uploads/default-avatar.png' %>" alt="<%= user.username %>" class="w-20 h-20 rounded-full object-cover border-4 border-brand-pink shadow-md">
        <div>
          <h1 class="font-serif text-3xl sm:text-4xl font-bold tracking-tight">Welcome Back, <span class="text-brand-pink"><%= user.username %></span></h1>
          <p class="text-gray-300 font-light mt-1 text-sm sm:text-base">We hope your day is filled with inspiring chapters. Let's delve back in.</p>
        </div>
      </div>
      <a href="/novels" class="px-6 py-3 bg-brand-pink hover:bg-white text-brand-dark font-bold rounded-xl shadow-md transition-all duration-200 text-sm flex items-center gap-2 flex-shrink-0">
        <i data-lucide="compass" class="w-4.5 h-4.5"></i>
        Browse Library
      </a>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    
    <!-- LEFT PANEL: Active reading history and favorites (Col span 8) -->
    <div class="lg:col-span-8 space-y-12">
      
      <!-- Section A: Continue Reading & Progress Tracker -->
      <div class="bg-white dark:bg-[#1E150F] p-6 sm:p-8 rounded-2xl border border-brand-brown/10 dark:border-brand-brown/20 shadow-sm">
        <div class="flex items-center justify-between mb-6 border-b border-brand-brown/10 dark:border-brand-brown/15 pb-4">
          <h2 class="font-serif text-2xl font-bold text-gray-800 dark:text-brand-pink flex items-center gap-2.5">
            <i data-lucide="book-open-check" class="w-6 h-6 text-brand-brown dark:text-brand-pink"></i>
            Continue Reading
          </h2>
          <a href="/history" class="text-xs font-semibold text-brand-brown dark:text-brand-pink hover:underline">View Reading History</a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-6">
          <div class="rounded-xl border border-brand-brown/10 bg-brand-cream/40 p-3">
            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-brand-brown/70">Reading streak</p>
            <p class="mt-1 text-xl font-bold text-brand-brown"><%= typeof streak !== 'undefined' ? streak : 0 %> days</p>
          </div>
          <div class="rounded-xl border border-brand-brown/10 bg-brand-cream/40 p-3">
            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-brand-brown/70">Member tier</p>
            <p class="mt-1 text-xl font-bold text-brand-brown"><%= premiumStatus %></p>
          </div>
          <div class="rounded-xl border border-brand-brown/10 bg-brand-cream/40 p-3">
            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-brand-brown/70">Profile strength</p>
            <p class="mt-1 text-xl font-bold text-brand-brown"><%= typeof profileCompletion !== 'undefined' ? profileCompletion : 0 %>%</p>
          </div>
          <div class="rounded-xl border border-brand-brown/10 bg-brand-cream/40 p-3">
            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-brand-brown/70">Achievements</p>
            <p class="mt-1 text-sm font-bold text-brand-brown"><%= achievements.join(' • ') %></p>
          </div>
        </div>

        <% if (historyItems.length > 0) { %>
          <div class="space-y-6">
            <% historyItems.slice(0, 3).forEach(function(item) { %>
              <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between p-4 rounded-xl bg-brand-cream/25 dark:bg-brand-brown/5 border border-brand-brown/5 dark:border-brand-brown/10 gap-4 hover:border-brand-pink transition-colors">
                <div class="flex items-center gap-4">
                  <img src="<%= item.novel.coverImage %>" alt="<%= item.novel.title %>" class="w-14 h-20 rounded-lg object-cover shadow-sm">
                  <div>
                    <h3 class="font-serif text-lg font-bold text-gray-800 dark:text-white leading-snug"><%= item.novel.title %></h3>
                    <p class="text-xs text-gray-400">By <%= item.novel.authorName %> &bull; Page <%= item.pageIndex + 1 %> of <%= item.novel.contentPages.length %></p>
                    
                    <!-- Progress Bar -->
                    <div class="mt-3.5 w-44 sm:w-56 bg-gray-250 dark:bg-brand-brown/20 rounded-full h-2 overflow-hidden flex">
                      <div class="bg-brand-brown dark:bg-brand-pink h-full" style="width: <%= item.progressPercent %>%"></div>
                    </div>
                  </div>
                </div>

                <div class="flex items-center gap-3 w-full sm:w-auto justify-end">
                  <span class="text-xs font-bold text-brand-brown dark:text-brand-pink"><%= item.progressPercent %>% Done</span>
                  <a href="/novels/<%= item.novelId %>/read?page=<%= item.pageIndex %>" class="px-4 py-2 bg-brand-brown hover:bg-brand-accent text-white font-semibold rounded-lg text-xs shadow-sm transition-colors flex items-center gap-1.5">
                    Resume
                    <i data-lucide="play" class="w-3.5 h-3.5 fill-white"></i>
                  </a>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="text-center py-12 text-gray-400">
            <i data-lucide="notebook-tabs" class="w-12 h-12 text-gray-300 mx-auto mb-4"></i>
            <p class="text-sm">No books opened yet. Begin reading online and your history will appear here.</p>
          </div>
        <% } %>
      </div>

      <!-- Section: Author Workspace & Submissions -->
      <div class="bg-white dark:bg-[#1E150F] p-6 sm:p-8 rounded-2xl border border-brand-brown/10 dark:border-brand-brown/20 shadow-sm">
        <div class="flex items-center justify-between mb-6 border-b border-brand-brown/10 dark:border-brand-brown/15 pb-4">
          <h2 class="font-serif text-2xl font-bold text-gray-800 dark:text-brand-pink flex items-center gap-2.5">
            <i data-lucide="feather" class="w-6 h-6 text-brand-brown dark:text-brand-pink"></i>
            Author Desk & Workspace
          </h2>
          <div class="flex items-center gap-2">
            <a href="/poems/submit" class="text-xs font-bold text-brand-brown dark:text-brand-pink hover:underline">+ New Poem</a>
            <span class="text-gray-300">|</span>
            <a href="/novels/submit" class="text-xs font-bold text-brand-brown dark:text-brand-pink hover:underline">+ New Novel</a>
          </div>
        </div>

        <!-- Author Stats Row -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-6 text-xs">
          <div class="rounded-xl border border-brand-brown/10 bg-brand-cream/20 dark:bg-white/5 p-3">
            <p class="font-semibold uppercase tracking-wider text-gray-400">Writing Streak</p>
            <p class="mt-1 text-base font-bold text-brand-brown dark:text-brand-pink">🔥 <%= authorStreak %> Days</p>
          </div>
          <div class="rounded-xl border border-brand-brown/10 bg-brand-cream/20 dark:bg-white/5 p-3">
            <p class="font-semibold uppercase tracking-wider text-gray-400">Longest Streak</p>
            <p class="mt-1 text-base font-bold text-brand-brown dark:text-brand-pink">🏆 <%= longestAuthorStreak %> Days</p>
          </div>
          <div class="rounded-xl border border-brand-brown/10 bg-brand-cream/20 dark:bg-white/5 p-3">
            <p class="font-semibold uppercase tracking-wider text-gray-400">Signature Wall</p>
            <p class="mt-1 text-xs font-bold">
              <% if (hasSignature) { %>
                <a href="/authors/signature-wall" class="text-green-600 hover:underline">✓ Signed (View Wall)</a>
              <% } else { %>
                <a href="/authors/signature-wall" class="text-brand-brown dark:text-brand-pink hover:underline">✗ Not Signed (Sign here)</a>
              <% } %>
            </p>
          </div>
        </div>

        <!-- Tabs Navigation -->
        <div class="flex gap-2 border-b border-brand-brown/10 pb-4 mb-4">
          <button type="button" onclick="switchDashboardTab('dash-poems')" id="btn-dash-poems" class="dash-tab-btn px-4 py-2 text-xs font-bold rounded-lg bg-brand-brown text-white transition-all">
            🖊 My Poems
          </button>
          <button type="button" onclick="switchDashboardTab('dash-novels')" id="btn-dash-novels" class="dash-tab-btn px-4 py-2 text-xs font-bold rounded-lg border border-brand-brown/10 text-gray-600 dark:text-gray-300 transition-all">
            📚 My Novels
          </button>
        </div>

        <!-- Poems Panel -->
        <div id="panel-dash-poems" class="dash-tab-panel space-y-4">
          <% if (typeof userPoems !== 'undefined' && userPoems.length > 0) { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <% userPoems.forEach(function(poem) { %>
                <div class="p-4 rounded-xl border border-brand-brown/5 dark:border-brand-brown/10 bg-brand-cream/10 dark:bg-brand-brown/5 flex flex-col justify-between space-y-3 relative group">
                  <div class="flex justify-between items-start">
                    <span class="text-[9px] uppercase tracking-wider font-bold px-2 py-0.5 rounded-full
                      <%= poem.approvalStatus === 'approved' ? 'bg-green-100 text-green-700 dark:bg-green-950/30 dark:text-green-400' : 'bg-yellow-100 text-yellow-700 dark:bg-yellow-950/30 dark:text-yellow-400' %>">
                      <%= poem.approvalStatus === 'approved' ? 'Live' : 'Pending Payment' %>
                    </span>
                    <span class="text-[10px] text-gray-400 font-mono"><%= new Date(poem.createdAt).toLocaleDateString() %></span>
                  </div>
                  
                  <div>
                    <h3 class="font-serif text-sm font-bold text-gray-808 dark:text-white truncate">
                      <a href="/poems/<%= poem._id %>" class="hover:text-brand-brown dark:hover:text-brand-pink transition-colors"><%= poem.title %></a>
                    </h3>
                    <p class="text-[10px] text-gray-400"><%= poem.genre || 'Poetry' %></p>
                  </div>

                  <div class="flex items-center justify-between border-t border-brand-brown/5 pt-2 mt-2">
                    <div class="flex items-center gap-1.5">
                      <a href="/poems/<%= poem._id %>/edit" class="text-[10px] text-brand-brown dark:text-brand-pink hover:underline font-semibold flex items-center gap-0.5">
                        <i data-lucide="edit" class="w-3 h-3"></i> Edit
                      </a>
                      <span class="text-gray-300 text-[10px]">|</span>
                      <form action="/poems/<%= poem._id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to permanently delete this poem?');" class="inline">
                        <button type="submit" class="text-[10px] text-red-500 hover:underline font-semibold flex items-center gap-0.5">
                          <i data-lucide="trash-2" class="w-3 h-3"></i> Delete
                        </button>
                      </form>
                    </div>
                    
                    <% if (poem.approvalStatus !== 'approved') { %>
                      <button type="button" onclick="openPaymentModal('poem', '<%= poem._id %>')" class="px-2.5 py-1 bg-yellow-600 hover:bg-yellow-700 text-white rounded text-[10px] font-bold shadow-sm transition-colors">
                        Pay & Publish
                      </button>
                    <% } else { %>
                      <span class="text-[10px] text-gray-400"><%= (poem.likes || []).length %> likes</span>
                    <% } %>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <p class="text-xs text-gray-400 italic text-center py-6">You haven't uploaded any poems yet.</p>
          <% } %>
        </div>

        <!-- Novels Panel -->
        <div id="panel-dash-novels" class="dash-tab-panel hidden space-y-4">
          <% if (typeof userNovels !== 'undefined' && userNovels.length > 0) { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <% userNovels.forEach(function(novel) { %>
                <div class="p-4 rounded-xl border border-brand-brown/5 dark:border-brand-brown/10 bg-brand-cream/10 dark:bg-brand-brown/5 flex flex-col justify-between space-y-3 relative group">
                  <div class="flex justify-between items-start">
                    <span class="text-[9px] uppercase tracking-wider font-bold px-2 py-0.5 rounded-full
                      <%= novel.approvalStatus === 'approved' ? 'bg-green-100 text-green-700 dark:bg-green-950/30 dark:text-green-400' : 'bg-yellow-100 text-yellow-700 dark:bg-yellow-950/30 dark:text-yellow-400' %>">
                      <%= novel.approvalStatus === 'approved' ? 'Published' : 'Pending Payment' %>
                    </span>
                    <span class="text-[10px] text-gray-400 font-mono"><%= new Date(novel.createdAt).toLocaleDateString() %></span>
                  </div>
                  
                  <div>
                    <h3 class="font-serif text-sm font-bold text-gray-808 dark:text-white truncate">
                      <a href="/novels/<%= novel._id %>" class="hover:text-brand-brown dark:hover:text-brand-pink transition-colors"><%= novel.title %></a>
                    </h3>
                    <p class="text-[10px] text-gray-400"><%= novel.genre %></p>
                  </div>

                  <div class="flex items-center justify-between border-t border-brand-brown/5 pt-2 mt-2">
                    <div class="flex items-center gap-1.5">
                      <a href="/novels/<%= novel._id %>/edit" class="text-[10px] text-brand-brown dark:text-brand-pink hover:underline font-semibold flex items-center gap-0.5">
                        <i data-lucide="edit" class="w-3 h-3"></i> Edit
                      </a>
                      <span class="text-gray-300 text-[10px]">|</span>
                      <form action="/novels/<%= novel._id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to permanently delete this novel?');" class="inline">
                        <button type="submit" class="text-[10px] text-red-500 hover:underline font-semibold flex items-center gap-0.5">
                          <i data-lucide="trash-2" class="w-3 h-3"></i> Delete
                        </button>
                      </form>
                    </div>
                    
                    <% if (novel.approvalStatus !== 'approved') { %>
                      <button type="button" onclick="openPaymentModal('novel', '<%= novel._id %>')" class="px-2.5 py-1 bg-yellow-600 hover:bg-yellow-700 text-white rounded text-[10px] font-bold shadow-sm transition-colors">
                        Pay & Publish
                      </button>
                    <% } else { %>
                      <span class="text-[10px] text-gray-400"><%= novel.readerCount || 0 %> readers</span>
                    <% } %>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <p class="text-xs text-gray-400 italic text-center py-6">You haven't uploaded any novels yet.</p>
          <% } %>
        </div>

      </div>

      <!-- Section B: Favorite Novels Shelf -->
      <div class="bg-white dark:bg-[#1E150F] p-6 sm:p-8 rounded-2xl border border-brand-brown/10 dark:border-brand-brown/20 shadow-sm">
        <div class="flex items-center justify-between mb-6 border-b border-brand-brown/10 dark:border-brand-brown/15 pb-4">
          <h2 class="font-serif text-2xl font-bold text-gray-800 dark:text-brand-pink flex items-center gap-2.5">
            <i data-lucide="heart" class="w-6 h-6 text-red-500 fill-red-500"></i>
            My Favorite Books
          </h2>
          <a href="/favorites" class="text-xs font-semibold text-brand-brown dark:text-brand-pink hover:underline">Manage Shelf</a>
        </div>

        <% if (favoriteNovels.length > 0) { %>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <% favoriteNovels.slice(0, 4).forEach(function(novel) { %>
              <div class="flex items-center gap-4 p-3 rounded-xl border border-brand-brown/5 dark:border-brand-brown/10 hover:shadow-md transition-all duration-200">
                <img src="<%= novel.coverImage %>" alt="<%= novel.title %>" class="w-16 h-24 rounded-lg object-cover shadow-sm">
                <div class="min-w-0 flex-grow">
                  <h3 class="font-serif text-base font-bold text-gray-800 dark:text-white truncate"><%= novel.title %></h3>
                  <p class="text-xs text-gray-400 mt-0.5">By <%= novel.authorName %></p>
                  <span class="inline-block mt-2.5 bg-brand-pink/20 text-brand-brown dark:text-brand-pink text-[10px] font-bold px-2 py-0.5 rounded-md"><%= novel.genre %></span>
                  
                  <div class="mt-3 flex items-center gap-2">
                    <a href="/novels/<%= novel._id %>" class="text-xs font-bold text-brand-brown dark:text-brand-pink hover:underline flex items-center gap-0.5">
                      Explore Details
                      <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
                    </a>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="text-center py-12 text-gray-400">
            <i data-lucide="heart-off" class="w-12 h-12 text-gray-300 mx-auto mb-4"></i>
            <p class="text-sm">Your favorite books shelf is currently empty.</p>
          </div>
        <% } %>
      </div>

    </div>

    <!-- RIGHT PANEL: Bookmarks and Recommendations (Col span 4) -->
    <div class="lg:col-span-4 space-y-12">
      
      <!-- Section C: Active Bookmarks -->
      <div class="bg-white dark:bg-[#1E150F] p-6 sm:p-8 rounded-2xl border border-brand-brown/10 dark:border-brand-brown/20 shadow-sm h-fit">
        <h2 class="font-serif text-2xl font-bold text-gray-800 dark:text-brand-pink mb-6 pb-4 border-b border-brand-brown/10 dark:border-brand-brown/15 flex items-center gap-2.5">
          <i data-lucide="bookmark" class="w-5 h-5 text-brand-brown dark:text-brand-pink fill-brand-brown dark:fill-brand-pink"></i>
          My Bookmarks
        </h2>

        <% if (bookmarkItems.length > 0) { %>
          <div class="space-y-4">
            <% bookmarkItems.forEach(function(item) { %>
              <div class="p-3.5 rounded-xl bg-brand-cream/25 dark:bg-brand-brown/5 border border-brand-brown/5 dark:border-brand-brown/10 text-xs">
                <div class="flex items-center gap-3">
                  <img src="<%= item.novel.coverImage %>" alt="" class="w-8 h-12 object-cover rounded-md flex-shrink-0">
                  <div class="min-w-0">
                    <p class="font-bold text-gray-800 dark:text-white truncate"><%= item.novel.title %></p>
                    <p class="text-gray-400 mt-0.5">Page <%= item.pageIndex + 1 %> of <%= item.novel.contentPages.length %></p>
                  </div>
                </div>
                <div class="mt-3.5 flex items-center justify-between border-t border-brand-brown/5 dark:border-brand-brown/10 pt-2.5">
                  <span class="text-gray-400 text-[10px]"><%= new Date(item.bookmarkedAt).toLocaleDateString() %></span>
                  <a href="/novels/<%= item.novelId %>/read?page=<%= item.pageIndex %>" class="text-brand-brown dark:text-brand-pink font-semibold hover:underline flex items-center gap-1">
                    Jump to Page
                    <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                  </a>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="text-center py-8 text-gray-400">
            <i data-lucide="bookmark-x" class="w-10 h-10 text-gray-300 mx-auto mb-3"></i>
            <p class="text-xs">No active bookmarks found.</p>
          </div>
        <% } %>
      </div>

      <!-- Section D: Recommended Novels -->
      <div class="bg-white dark:bg-[#1E150F] p-6 sm:p-8 rounded-2xl border border-brand-brown/10 dark:border-brand-brown/20 shadow-sm h-fit">
        <h2 class="font-serif text-2xl font-bold text-gray-800 dark:text-brand-pink mb-6 pb-4 border-b border-brand-brown/10 dark:border-brand-brown/15 flex items-center gap-2.5">
          <i data-lucide="sparkles" class="w-5 h-5 text-brand-brown dark:text-brand-pink"></i>
          AI Recommendations
        </h2>

        <% if (recommendedNovels.length > 0) { %>
          <div class="space-y-5">
            <% recommendedNovels.forEach(function(novel) { %>
              <div class="group flex gap-4">
                <img src="<%= novel.coverImage %>" alt="<%= novel.title %>" class="w-12 h-18 rounded-lg object-cover shadow-sm group-hover:scale-105 transition-transform">
                <div class="min-w-0 flex-grow">
                  <h3 class="font-serif text-sm font-bold text-gray-800 dark:text-white truncate group-hover:text-brand-brown dark:group-hover:text-brand-pink transition-colors"><%= novel.title %></h3>
                  <p class="text-[10px] text-gray-400">By <%= novel.authorName %></p>
                  <p class="text-[10px] text-gray-500 mt-1"><%= novel.summary || 'A fresh literary discovery for your next reading session.' %></p>
                  <div class="flex items-center gap-1 mt-1.5">
                    <i data-lucide="star" class="w-3.5 h-3.5 text-amber-500 fill-amber-500"></i>
                    <span class="text-[10px] font-semibold text-gray-600 dark:text-gray-300"><%= novel.rating %></span>
                  </div>
                  <a href="/novels/<%= novel._id %>" class="inline-block mt-2 text-[10px] font-bold text-brand-brown dark:text-brand-pink hover:underline">&rarr; Read Details</a>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p class="text-xs text-gray-400 text-center py-6">You have read all our available masterpieces! Check back later for fresh collections.</p>
        <% } %>
      </div>

    </div>

  </div>
</div>

<!-- M-Pesa Complete Payment Modal Dialogue -->
<div id="dashboardPaymentModal" class="hidden fixed inset-0 z-50 bg-black/60 flex items-center justify-center p-4">
  <div class="bg-white dark:bg-[#1E150F] rounded-3xl p-6 max-w-sm w-full border border-brand-brown/10 space-y-4">
    <div class="text-center">
      <i data-lucide="wallet" class="w-10 h-10 text-brand-brown dark:text-brand-pink mx-auto mb-2"></i>
      <h3 class="font-serif font-bold text-lg text-gray-800 dark:text-white" id="modalPaymentTitle">Complete Payment</h3>
      <p class="text-xs text-gray-500 mt-1">To publish, complete payment of KES 100 via M-Pesa STK push.</p>
    </div>
    
    <form id="modalPaymentForm" method="POST" class="space-y-4">
      <div>
        <label for="modalPhone" class="block text-[10px] uppercase font-bold text-gray-400 mb-1">M-Pesa Phone Number</label>
        <input type="text" id="modalPhone" name="phoneNumber" required value="<%= user.phoneNumber || '' %>" placeholder="e.g. 0712345678" class="w-full px-3.5 py-2 border border-brand-brown/20 dark:border-brand-brown/30 rounded-xl bg-brand-cream/10 dark:bg-brand-dark/20 text-xs focus:outline-none dark:text-white">
      </div>

      <div class="flex gap-2">
        <button type="submit" id="modalPaymentSubmitBtn" class="flex-grow py-2 bg-brand-brown text-white text-xs font-semibold rounded-lg shadow">Initiate Stk Push</button>
        <button type="button" onclick="closePaymentModal()" class="px-4 py-2 border border-brand-brown/15 text-gray-700 dark:text-gray-300 text-xs font-semibold rounded-lg">Cancel</button>
      </div>
    </form>
  </div>
</div>

<script>
  function switchDashboardTab(tabId) {
    document.querySelectorAll('.dash-tab-panel').forEach(p => p.classList.add('hidden'));
    document.getElementById('panel-' + tabId).classList.remove('hidden');

    document.querySelectorAll('.dash-tab-btn').forEach(btn => {
      btn.className = "dash-tab-btn px-4 py-2 text-xs font-bold rounded-lg border border-brand-brown/10 text-gray-600 dark:text-gray-300 transition-all";
    });
    const activeBtn = document.getElementById('btn-' + tabId);
    activeBtn.className = "dash-tab-btn px-4 py-2 text-xs font-bold rounded-lg bg-brand-brown text-white transition-all shadow-sm";
  }

  function openPaymentModal(type, id) {
    const modal = document.getElementById('dashboardPaymentModal');
    const form = document.getElementById('modalPaymentForm');
    const title = document.getElementById('modalPaymentTitle');

    if (type === 'poem') {
      form.action = `/poems/${id}/complete-payment`;
      title.textContent = 'Publish Your Poem';
    } else {
      form.action = `/novels/${id}/complete-payment`;
      title.textContent = 'Publish Your Novel';
    }

    modal.classList.remove('hidden');
  }

  function closePaymentModal() {
    document.getElementById('dashboardPaymentModal').classList.add('hidden');
  }
</script>

<%- include('partials/footer') %>

<script>
  (function() {
    if (typeof EventSource === 'undefined') return;
    try {
      const es = new EventSource('/api/payments/stream');
      const toasts = document.getElementById('realtimeToasts');
      es.addEventListener('payment', (evt) => {
        try {
          const payload = JSON.parse(evt.data);
          if (payload?.status === 'completed') {
            const el = document.createElement('div');
            el.className = 'px-4 py-2 rounded-lg shadow-md bg-white text-sm text-gray-800 border border-brand-brown/10';
            el.innerHTML = `<strong>Payment received</strong><div class="text-xs">${payload.amount} KES — Invoice ${payload.invoiceNumber}</div>`;
            toasts.prepend(el);
            setTimeout(() => el.remove(), 7000);
          }
        } catch (e) {}
      });
      es.onerror = () => {};
    } catch (e) {}
  })();
</script>
