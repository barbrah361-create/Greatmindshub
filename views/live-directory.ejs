<%- include('partials/header') %>
<%- include('partials/navbar') %>
<%- include('partials/flash') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 flex-grow">
  
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
    <div>
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-red-500/20 text-red-600 dark:text-red-400 uppercase tracking-widest animate-pulse">
        <span class="w-2 h-2 rounded-full bg-red-500"></span>
        Live Stage
      </span>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold mt-2 text-gray-800 dark:text-white">Poetry & Reading Live Rooms</h1>
      <p class="text-gray-500 dark:text-gray-400 max-w-xl mt-3 text-sm sm:text-base leading-relaxed">
        Watch poets recite their verses in real-time, join book reading sessions, read along live, and interact with fellow literary enthusiasts!
      </p>
    </div>

    <a href="/live/create" class="px-6 py-3.5 bg-red-600 hover:bg-red-700 text-white font-bold rounded-2xl shadow-lg hover:shadow-red-500/25 transition-all text-sm flex items-center justify-center gap-2">
      <i data-lucide="video" class="w-5 h-5"></i>
      Go Live Studio
    </a>
  </div>

  <!-- Active Streams Grid -->
  <% if (activeStreams && activeStreams.length > 0) { %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      <% activeStreams.forEach(function(stream) { %>
        <div class="group bg-white dark:bg-[#1E150F] rounded-3xl overflow-hidden shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 border border-brand-brown/10 dark:border-brand-brown/20 flex flex-col justify-between">
          <div class="relative h-60 bg-black overflow-hidden flex items-center justify-center">
            <!-- Simulated video preview -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent"></div>
            <div class="relative z-10 flex flex-col items-center text-center p-4">
              <img src="<%= stream.hostAvatar || '/uploads/default-avatar.png' %>" alt="" class="w-16 h-16 rounded-full object-cover ring-4 ring-red-500 shadow-md mb-2">
              <span class="text-xs font-bold text-white"><%= stream.hostName %></span>
              <span class="text-[10px] text-gray-300">Reciting: <%= stream.workTitle %></span>
            </div>

            <span class="absolute top-4 left-4 inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-bold bg-red-600 text-white shadow-md uppercase tracking-wider animate-pulse">
              <span class="w-1.5 h-1.5 rounded-full bg-white"></span> LIVE
            </span>

            <span class="absolute top-4 right-4 inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold bg-black/60 backdrop-blur text-white">
              <i data-lucide="users" class="w-3 h-3 text-red-400"></i>
              <%= stream.viewersCount %> watching
            </span>
          </div>

          <div class="p-6 flex flex-col flex-grow justify-between">
            <div>
              <span class="text-[10px] font-bold uppercase tracking-wider text-brand-pink bg-brand-pink/20 px-2.5 py-0.5 rounded-full"><%= stream.type %></span>
              <h2 class="font-serif text-xl font-bold text-gray-800 dark:text-white mt-2 truncate"><%= stream.title %></h2>
              <p class="text-xs text-gray-500 dark:text-gray-300 line-clamp-2 mt-1 leading-relaxed italic">
                "<%= stream.workContent %>"
              </p>
            </div>

            <div class="flex items-center justify-between border-t border-brand-brown/10 dark:border-brand-brown/15 pt-4 mt-6">
              <div class="flex items-center gap-1.5 text-xs text-red-500 font-bold">
                <i data-lucide="heart" class="w-4 h-4 fill-red-500"></i>
                <%= stream.likesCount %> hearts
              </div>
              <a href="/live/<%= stream._id %>" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white font-bold rounded-xl text-xs shadow-sm transition-colors flex items-center gap-1.5">
                Join Room &rarr;
              </a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="bg-white dark:bg-[#1E150F] p-12 rounded-3xl border border-brand-brown/10 text-center text-gray-400 max-w-2xl mx-auto space-y-4">
      <div class="w-16 h-16 rounded-full bg-red-500/10 text-red-500 flex items-center justify-center mx-auto animate-pulse">
        <i data-lucide="video" class="w-8 h-8"></i>
      </div>
      <h2 class="font-serif text-2xl font-bold text-gray-800 dark:text-white">No Live Stages Active Right Now</h2>
      <p class="text-sm text-gray-500 dark:text-gray-400">Be the pioneer! Open your live studio, recite your poem or read a book chapter live to your followers.</p>
      <a href="/live/create" class="inline-flex items-center gap-2 px-6 py-3 bg-red-600 hover:bg-red-700 text-white font-bold rounded-xl text-xs shadow-md transition-colors">
        <i data-lucide="video" class="w-4 h-4"></i> Start Reciting Live
      </a>
    </div>
  <% } %>

</div>

<%- include('partials/footer') %>
