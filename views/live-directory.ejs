<%- include('partials/header') %>
<%- include('partials/navbar') %>
<%- include('partials/flash') %>

<!-- TikTok-Style Live Directory -->
<div class="min-h-screen bg-black">

  <!-- Hero Header -->
  <div class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-red-600/20 via-black to-black"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <div class="flex items-center gap-2 mb-3">
            <span class="w-3 h-3 rounded-full bg-red-500 animate-pulse"></span>
            <span class="text-red-500 text-xs font-black uppercase tracking-widest">Live Stage</span>
          </div>
          <h1 class="font-serif text-3xl sm:text-5xl font-bold text-white leading-tight">Poetry & Reading<br><span class="text-red-500">Live Rooms</span></h1>
          <p class="text-gray-400 max-w-lg mt-3 text-sm leading-relaxed">
            Watch poets recite in real-time, send gifts, join as co-host, and interact with fellow literary enthusiasts.
          </p>
        </div>
        <a href="/live/create" class="px-8 py-4 bg-red-600 hover:bg-red-700 text-white font-bold rounded-2xl shadow-xl hover:shadow-red-500/30 transition-all text-sm flex items-center justify-center gap-2.5 shrink-0">
          <i data-lucide="video" class="w-5 h-5"></i> Go Live
        </a>
      </div>
    </div>
  </div>

  <!-- Active Streams Grid -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <% if (activeStreams && activeStreams.length > 0) { %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4" id="streamsGrid">
        <% activeStreams.forEach(function(stream) { %>
          <a id="stream-card-<%= stream._id %>" href="/live/<%= stream._id %>" class="stream-card group relative rounded-2xl overflow-hidden bg-gray-900 border border-white/5 hover:border-red-500/30 transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-red-500/10">
            <!-- Stream Preview Card -->
            <div class="relative aspect-[9/14] sm:aspect-[9/12] flex items-center justify-center bg-gradient-to-b from-gray-800 to-black">
              <!-- Host Avatar centered -->
              <div class="flex flex-col items-center text-center space-y-2">
                <div class="relative">
                  <img src="<%= stream.hostAvatar || '/uploads/default-avatar.png' %>" class="w-20 h-20 rounded-full object-cover ring-4 ring-red-500 shadow-xl group-hover:ring-red-400 transition-all" alt="">
                  <span class="absolute -bottom-1 left-1/2 -translate-x-1/2 bg-red-600 text-white text-[8px] font-black px-2 py-0.5 rounded-full uppercase tracking-wider">Live</span>
                </div>
                <span class="text-white text-sm font-bold"><%= stream.hostName %></span>
                <span class="text-gray-400 text-[10px] px-3 line-clamp-2"><%= stream.title %></span>
              </div>

              <!-- Overlays -->
              <div class="absolute top-3 left-3 flex items-center gap-1.5">
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-red-600 text-white text-[10px] font-black uppercase shadow-lg animate-pulse">
                  <span class="w-1.5 h-1.5 rounded-full bg-white"></span> LIVE
                </span>
              </div>

              <div class="absolute top-3 right-3 flex items-center gap-1 px-2 py-1 bg-black/60 backdrop-blur rounded-full">
                <i data-lucide="eye" class="w-3 h-3 text-red-400"></i>
                <span class="text-white text-[10px] font-bold"><%= stream.viewersCount %></span>
              </div>

              <!-- Bottom: Type + Gift Points -->
              <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black via-black/80 to-transparent p-4 space-y-2">
                <div class="flex items-center justify-between">
                  <span class="text-[10px] font-bold uppercase tracking-wider text-red-400 bg-red-500/10 px-2 py-0.5 rounded-full"><%= stream.type %></span>
                  <div class="flex items-center gap-2">
                    <span class="flex items-center gap-1 text-[10px] text-red-400 font-bold">
                      <i data-lucide="heart" class="w-3 h-3 fill-red-500 text-red-500"></i> <%= stream.likesCount %>
                    </span>
                    <% if (stream.totalGiftPoints) { %>
                    <span class="flex items-center gap-1 text-[10px] text-amber-400 font-bold">
                      <i data-lucide="gift" class="w-3 h-3"></i> <%= stream.totalGiftPoints %>
                    </span>
                    <% } %>
                  </div>
                </div>
                <p class="text-white text-xs font-semibold truncate"><%= stream.workTitle %></p>
              </div>
            </div>
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <!-- No Active Streams -->
      <div class="flex flex-col items-center justify-center py-24 text-center space-y-6">
        <div class="w-24 h-24 rounded-full bg-red-500/10 text-red-500 flex items-center justify-center animate-pulse">
          <i data-lucide="video" class="w-12 h-12"></i>
        </div>
        <div>
          <h2 class="font-serif text-3xl font-bold text-white mb-2">No Live Stages Active</h2>
          <p class="text-gray-500 text-sm max-w-md">Be the first to go live! Recite your poem, read a chapter, and get gifts from your audience.</p>
        </div>
        <a href="/live/create" class="px-8 py-4 bg-red-600 hover:bg-red-700 text-white font-bold rounded-2xl text-sm shadow-xl hover:shadow-red-500/30 transition-all flex items-center gap-2">
          <i data-lucide="video" class="w-5 h-5"></i> Start Reciting Live
        </a>
      </div>
    <% } %>
  </div>

</div>

<script src="/socket.io/socket.io.js"></script>
<script>
  if (typeof io !== 'undefined') {
    const socket = io();
    socket.on('global-stream-ended', (data) => {
      const card = document.getElementById('stream-card-' + data.roomId);
      if (card) {
        // Add a fade out animation before removing
        card.style.transition = 'all 0.5s ease-out';
        card.style.opacity = '0';
        card.style.transform = 'scale(0.9)';
        setTimeout(() => {
          card.remove();
          // If no more streams, reload to show empty state
          if (document.querySelectorAll('.stream-card').length === 0) {
            window.location.reload();
          }
        }, 500);
      }
    });
  }
</script>

<%- include('partials/footer') %>
